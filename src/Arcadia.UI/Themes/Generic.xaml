<ResourceDictionary xmlns:shared="clr-namespace:Arcadia.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Arcadia.UI.Controls"
                    xmlns:a="clr-namespace:Arcadia.UI.Artwork">

    <ResourceDictionary.MergedDictionaries>
        <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/Palette.xaml" />
        <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Keyboard focus: a crisp illuminated outline, never the dotted default -->
    <Style x:Key="Arcadia.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" Stroke="{StaticResource Brush.Focus}" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaIcon ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaIcon}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Icon.Metal}" />
        <Setter Property="AccentBrush" Value="{StaticResource Brush.Icon.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaIcon}">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
                            <Path Data="{TemplateBinding AccentData}" Fill="{TemplateBinding AccentBrush}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArtworkPresenter ═════════════════════════ -->
    <Style TargetType="{x:Type a:ArtworkPresenter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type a:ArtworkPresenter}">
                    <Grid>
                        <a:SceneArtwork x:Name="PART_Scene" Theme="{TemplateBinding Theme}" Seed="{TemplateBinding Seed}"
                                        Vignette="{TemplateBinding Vignette}" BottomShade="{TemplateBinding BottomShade}" />
                        <Grid x:Name="PART_Ambient" Visibility="Collapsed" ClipToBounds="True">
                            <Image x:Name="PART_Backdrop" Stretch="UniformToFill" Margin="-30" RenderOptions.BitmapScalingMode="LowQuality">
                                <Image.Effect>
                                    <BlurEffect Radius="36" KernelType="Gaussian" />
                                </Image.Effect>
                            </Image>
                            <Rectangle Fill="#8C05070B" />
                        </Grid>
                        <Image x:Name="PART_Image" Stretch="{TemplateBinding Stretch}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AmbientFill" Value="True">
                            <Setter TargetName="PART_Image" Property="Stretch" Value="Uniform" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ TransitioningContentControl ═════════════════════════ -->
    <Style TargetType="{x:Type c:TransitioningContentControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:TransitioningContentControl}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaSectionHeader ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaSectionHeader}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaSectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:ArcadiaIcon x:Name="icon" Kind="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding ActionContent}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaPanel ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaPanel}">
        <Setter Property="Padding" Value="12,6,12,10" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaPanel}">
                    <Border Background="#05070A" CornerRadius="5" Padding="1" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" CornerRadius="4">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Height="38">
                                    <Border Height="1" VerticalAlignment="Top" Margin="6,0" Background="{StaticResource Brush.Bevel.Highlight}" />
                                    <c:ArcadiaSectionHeader Margin="14,0,12,0" Title="{TemplateBinding Header}" Icon="{TemplateBinding Icon}" ActionContent="{TemplateBinding HeaderAction}" />
                                    <Border Height="1" VerticalAlignment="Bottom" Margin="12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#553F8CFF" />
                                                <GradientStop Offset="0.5" Color="#22304A" />
                                                <GradientStop Offset="1" Color="#00233044" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaStatusIndicator ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaStatusIndicator}">
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaStatusIndicator}">
                    <Border Background="{TemplateBinding PlateBrush}" BorderBrush="{TemplateBinding PlateBorder}" BorderThickness="1" CornerRadius="3" Padding="10,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Top" Background="#40FFFFFF" Margin="-6,0" />
                            <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding PlateText}" FontFamily="{StaticResource Font.Display}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaStatDisplay ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaStatDisplay}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaStatDisplay}">
                    <Border x:Name="slab" Background="{TemplateBinding SlabBrush}" BorderBrush="{TemplateBinding EdgeBrush}" BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Top" Background="#30FFFFFF" Margin="4,0" />
                            <Border x:Name="hover" Background="#10FFFFFF" Opacity="0" CornerRadius="2" />
                            <Grid Margin="12,4,14,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="46" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                    <Ellipse Fill="{TemplateBinding BadgeBrush}" Stroke="#40000000" StrokeThickness="1" />
                                    <Ellipse Margin="2" Stroke="#40FFFFFF" StrokeThickness="1" />
                                    <c:ArcadiaIcon Kind="{TemplateBinding Icon}" Width="18" Height="18" Foreground="White" AccentBrush="White" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Value}" Style="{StaticResource Text.Stat}" FontSize="21" Margin="0,-2,0,-2" />
                                    <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource Text.Meta}" Foreground="{StaticResource Brush.Text.Secondary}" />
                                </StackPanel>
                                <c:MiniBarChart Grid.Column="2" Width="62" Height="24" Values="{TemplateBinding Bars}" Tone="{TemplateBinding Tone}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{TemplateBinding PercentText}" Foreground="{TemplateBinding ToneTextBrush}" FontFamily="{StaticResource Font.Display}" FontSize="15"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ArcadiaButton ═════════════════════════ -->
    <ControlTemplate x:Key="ArcadiaButton.PlateTemplate" TargetType="{x:Type c:ArcadiaButton}">
        <Grid x:Name="root" SnapsToDevicePixels="True">
            <!-- outer glow, visible on hover -->
            <Border x:Name="glow" Margin="-1" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" Opacity="0">
                <Border.Effect>
                    <BlurEffect Radius="10" />
                </Border.Effect>
            </Border>
            <Border x:Name="plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <Grid>
                    <Border x:Name="hoverLayer" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#38FFFFFF" />
                                <GradientStop Offset="0.5" Color="#14FFFFFF" />
                                <GradientStop Offset="1" Color="#08FFFFFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="pressLayer" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#70000000" />
                                <GradientStop Offset="0.35" Color="#30000000" />
                                <GradientStop Offset="1" Color="#10000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="sheen" Height="1" VerticalAlignment="Top" Margin="3,0" Background="#50FFFFFF" />
                    <StackPanel x:Name="content" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <c:ArcadiaIcon x:Name="icon" Kind="{TemplateBinding Icon}" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                       Foreground="{TemplateBinding Foreground}" AccentBrush="{TemplateBinding Foreground}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <ContentPresenter x:Name="presenter" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <c:ArcadiaIcon x:Name="trail" Kind="{TemplateBinding TrailingIcon}" Width="12" Height="12"
                                       Foreground="{TemplateBinding Foreground}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="TrailingIcon" Value="{x:Null}">
                <Setter TargetName="trail" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="icon" Property="Margin" Value="0" />
                <Setter TargetName="presenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="pressLayer" Property="Opacity" Value="1" />
                <Setter TargetName="sheen" Property="Opacity" Value="0" />
                <Setter TargetName="content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ArcadiaButton.LinkTemplate" TargetType="{x:Type c:ArcadiaButton}">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
                <c:ArcadiaIcon x:Name="icon" Kind="{TemplateBinding Icon}" Width="11" Height="11" Foreground="{TemplateBinding Foreground}" Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="text" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                <c:ArcadiaIcon x:Name="trail" Kind="{TemplateBinding TrailingIcon}" Width="10" Height="10" Foreground="{TemplateBinding Foreground}" Margin="5,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="TrailingIcon" Value="{x:Null}">
                <Setter TargetName="trail" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="text" Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Link.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="text" Property="Opacity" Value="0.7" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ArcadiaButton.ToolTemplate" TargetType="{x:Type c:ArcadiaButton}">
        <Grid Background="Transparent">
            <Ellipse x:Name="halo" Opacity="0" Margin="-4">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#553F8CFF" />
                        <GradientStop Offset="1" Color="#003F8CFF" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <c:ArcadiaIcon x:Name="icon" Kind="{TemplateBinding Icon}" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="icon" Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="icon" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
                <Setter TargetName="icon" Property="Opacity" Value="0.8" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type c:ArcadiaButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Secondary}" />
        <Setter Property="BorderBrush" Value="#06090E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource ArcadiaButton.PlateTemplate}" />
        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary.Border}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Variant" Value="Link">
                <Setter Property="Template" Value="{StaticResource ArcadiaButton.LinkTemplate}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Link}" />
                <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="MinHeight" Value="0" />
            </Trigger>
            <Trigger Property="Variant" Value="Tool">
                <Setter Property="Template" Value="{StaticResource ArcadiaButton.ToolTemplate}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Icon.Metal}" />
                <Setter Property="IconSize" Value="20" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═════════════════════════ ArcadiaNavigationItem ═════════════════════════ -->
    <Style TargetType="{x:Type c:ArcadiaNavigationItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="ArcadiaNavigation" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ArcadiaNavigationItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- hover wash -->
                        <Border x:Name="hover" Margin="8,3" CornerRadius="3" Background="{StaticResource Brush.Nav.Hover}" Opacity="0" />

                        <!-- selected: a lit key set into the console -->
                        <Grid x:Name="selected" Margin="8,3" Opacity="0">
                            <Border CornerRadius="4" Background="#2F7BFF" Margin="0,1">
                                <Border.Effect>
                                    <BlurEffect Radius="14" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="4" Background="#03060B" Padding="1">
                                <Border CornerRadius="3" Background="{StaticResource Brush.Nav.Selected}" BorderBrush="#5C9CFF" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Border CornerRadius="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#30FFFFFF" />
                                                    <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                                    <GradientStop Offset="1" Color="#30000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                            <!-- emitter strip -->
                            <Border Width="3" HorizontalAlignment="Left" Margin="1,6" CornerRadius="1.5" Background="#9FE6FF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#45D2FF" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <Grid x:Name="body" Margin="22,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:ArcadiaIcon x:Name="icon" Kind="{TemplateBinding Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="label" Grid.Column="1" Margin="16,0,6,0" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="badge" Grid.Column="2" MinWidth="22" Height="22" CornerRadius="11" Background="{StaticResource Brush.Badge}" BorderBrush="#40000000" BorderThickness="1"
                                    VerticalAlignment="Center" Padding="5,0">
                                <TextBlock Text="{Binding Badge, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontFamily="{StaticResource Font.Display}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="0">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="body" Property="Margin" Value="0" />
                            <Setter TargetName="icon" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="icon" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="badge" Property="Grid.Column" Value="0" />
                            <Setter TargetName="badge" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="badge" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="badge" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="badge" Property="Margin" Value="0,5,10,0" />
                            <Setter TargetName="badge" Property="MinWidth" Value="16" />
                            <Setter TargetName="badge" Property="Height" Value="16" />
                            <Setter TargetName="badge" Property="Padding" Value="3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="icon" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="body" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
                            <Setter TargetName="hover" Property="Background" Value="#0A0F17" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="icon" Property="Foreground" Value="White" />
                            <Setter TargetName="icon" Property="AccentBrush" Value="#BFF0FF" />
                            <Setter TargetName="label" Property="TextBlock.FontWeight" Value="SemiBold" />
                            <Setter TargetName="icon" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#9FD8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════ ModuleTile ═════════════════════════ -->
    <Style TargetType="{x:Type c:ModuleTile}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ModuleTile}">
                    <Border Background="#05070A" CornerRadius="5" Padding="1" SnapsToDevicePixels="True">
                        <Border x:Name="frame" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <a:ModuleIllustration x:Name="art" Icon="{TemplateBinding Icon}" SecondaryIcon="{TemplateBinding SecondaryIcon}" Tone="{TemplateBinding Tone}" Seed="{TemplateBinding Seed}" />
                                <Border Height="1" VerticalAlignment="Top" Margin="6,0" Background="{StaticResource Brush.Bevel.Highlight}" />
                                <TextBlock Grid.Row="1" Margin="14,0,12,0" Text="{TemplateBinding Title}" Style="{StaticResource Text.Section}" FontSize="17" />
                                <TextBlock Grid.Row="2" Margin="14,2,12,0" Text="{TemplateBinding Description}" Style="{StaticResource Text.Body}" FontSize="12"
                                           LineHeight="16" Height="33" TextTrimming="WordEllipsis" LineStackingStrategy="BlockLineHeight" />
                                <c:ArcadiaButton Grid.Row="3" Margin="12,8,12,11" Variant="Primary" Background="{StaticResource Brush.ModuleAction}" FontSize="13" FontWeight="Normal"
                                                 Padding="10,4" MinHeight="28" Content="{TemplateBinding ActionText}" TrailingIcon="ArrowRight"
                                                 Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}"
                                                 AutomationProperties.Name="{TemplateBinding ActionText}" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="art" Storyboard.TargetProperty="Glow" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="art" Storyboard.TargetProperty="Glow" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="frame" Property="BorderBrush" Value="#3C5E92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
