<!--
    Arcadia "Midnight" palette. Every colour used by the UI is defined here so the theme can evolve
    (or gain alternatives) without touching templates.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ── Base surfaces ───────────────────────────────────────────── -->
    <Color x:Key="Color.Window">#06080C</Color>
    <Color x:Key="Color.Surface.Top">#131A25</Color>
    <Color x:Key="Color.Surface.Bottom">#0C1119</Color>
    <Color x:Key="Color.Raised.Top">#1C2533</Color>
    <Color x:Key="Color.Raised.Bottom">#121923</Color>
    <Color x:Key="Color.Sunken">#070A0F</Color>
    <Color x:Key="Color.Line">#233044</Color>
    <Color x:Key="Color.LineStrong">#34465F</Color>
    <Color x:Key="Color.LineDark">#020305</Color>

    <!-- ── Text ────────────────────────────────────────────────────── -->
    <Color x:Key="Color.Text.Primary">#EEF2F8</Color>
    <Color x:Key="Color.Text.Secondary">#B0BBCB</Color>
    <Color x:Key="Color.Text.Muted">#76839A</Color>
    <Color x:Key="Color.Text.Disabled">#4A5566</Color>

    <!-- ── Illumination ────────────────────────────────────────────── -->
    <Color x:Key="Color.Accent">#2F7BFF</Color>
    <Color x:Key="Color.Accent.Bright">#5AA2FF</Color>
    <Color x:Key="Color.Accent.Deep">#1646A6</Color>
    <Color x:Key="Color.Cyan">#45D2FF</Color>
    <Color x:Key="Color.Glow">#3F8CFF</Color>

    <!-- ── Status tones ────────────────────────────────────────────── -->
    <Color x:Key="Color.Tone.Blue">#2F7BFF</Color>
    <Color x:Key="Color.Tone.Green">#34C76A</Color>
    <Color x:Key="Color.Tone.Amber">#F2A623</Color>
    <Color x:Key="Color.Tone.Purple">#8E5BFF</Color>
    <Color x:Key="Color.Tone.Red">#EE4449</Color>
    <Color x:Key="Color.Tone.Cyan">#34C3F0</Color>
    <Color x:Key="Color.Tone.Gold">#F4C451</Color>
    <Color x:Key="Color.Tone.Steel">#6F7C90</Color>

    <!-- ── Brushes ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Sunken" Color="{StaticResource Color.Sunken}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.LineDark" Color="{StaticResource Color.LineDark}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#1A2433" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Link" Color="#5AA7FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Link.Hover" Color="#9CCBFF" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Bright" Color="{StaticResource Color.Accent.Bright}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tone.Green" Color="{StaticResource Color.Tone.Green}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tone.Amber" Color="{StaticResource Color.Tone.Amber}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tone.Red" Color="{StaticResource Color.Tone.Red}" po:Freeze="True" />

    <!-- Panel body: graphite with a slightly lighter crown -->
    <LinearGradientBrush x:Key="Brush.Surface" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Color.Surface.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Surface.Bottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Raised" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Color.Raised.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Raised.Bottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Caption" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#1A2231" />
        <GradientStop Offset="1" Color="#111722" />
    </LinearGradientBrush>

    <!-- Bevel: bright hairline on top edge, dark on the bottom -->
    <LinearGradientBrush x:Key="Brush.Bevel" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#3A4B64" />
        <GradientStop Offset="0.08" Color="#26344A" />
        <GradientStop Offset="1" Color="#141C28" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Bevel.Highlight" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.3" Color="#28FFFFFF" />
        <GradientStop Offset="0.7" Color="#28FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!-- Icon materials -->
    <LinearGradientBrush x:Key="Brush.Icon.Metal" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#F2F6FB" />
        <GradientStop Offset="1" Color="#98AAC4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Icon.Dim" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#C9D3E1" />
        <GradientStop Offset="1" Color="#74839A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Icon.Accent" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#7CE0FF" />
        <GradientStop Offset="1" Color="#2F7BFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Gold" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFE7A6" />
        <GradientStop Offset="0.55" Color="#E0A83C" />
        <GradientStop Offset="1" Color="#9C681E" />
    </LinearGradientBrush>

    <!-- Primary button plate -->
    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#4C97FF" />
        <GradientStop Offset="0.48" Color="#2A70F0" />
        <GradientStop Offset="0.52" Color="#1F62E0" />
        <GradientStop Offset="1" Color="#1A52C2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Primary.Hover" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#66A8FF" />
        <GradientStop Offset="0.48" Color="#3B80FF" />
        <GradientStop Offset="0.52" Color="#2C70F0" />
        <GradientStop Offset="1" Color="#2260D6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Primary.Pressed" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#1542A0" />
        <GradientStop Offset="1" Color="#2663D8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Primary.Border" Color="#0B2B6E" po:Freeze="True" />

    <!-- Secondary plate -->
    <LinearGradientBrush x:Key="Brush.Secondary" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#243044" />
        <GradientStop Offset="1" Color="#161E2B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Secondary.Hover" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#2E3D56" />
        <GradientStop Offset="1" Color="#1C2636" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Secondary.Pressed" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#0E141D" />
        <GradientStop Offset="1" Color="#1A2230" />
    </LinearGradientBrush>

    <!-- Module "Open" bar (blue, lower contrast than Primary) -->
    <LinearGradientBrush x:Key="Brush.ModuleAction" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#2A62C8" />
        <GradientStop Offset="0.5" Color="#1D4DA8" />
        <GradientStop Offset="1" Color="#173E8A" />
    </LinearGradientBrush>

    <!-- Navigation -->
    <LinearGradientBrush x:Key="Brush.Nav.Rail" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#0E141D" />
        <GradientStop Offset="1" Color="#080B11" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Nav.Selected" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#2B6EEA" />
        <GradientStop Offset="0.55" Color="#1B4AA6" />
        <GradientStop Offset="1" Color="#13305F" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Nav.Hover" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#1E2A3C" />
        <GradientStop Offset="1" Color="#101722" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Badge" Color="#E0343B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#7CC4FF" po:Freeze="True" />
</ResourceDictionary>
