<UserControl x:Class="Arcadia.App.Views.Oracle.OracleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Oracle"
             xmlns:ov="clr-namespace:Arcadia.App.Views.Oracle"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance ovm:OracleConsoleViewModel}" x:Name="Root">
    <UserControl.Resources>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
        <Style x:Key="RailHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.Caps}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#6FA6D6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="RailPanel" TargetType="Border">
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="#1A2A40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- a command line in the rail (click runs it) -->
        <DataTemplate x:Key="CommandLine">
            <Button Cursor="Hand" Focusable="True" Margin="0,1" AutomationProperties.Name="{Binding}"
                    Command="{Binding DataContext.Oracle.RunTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="2" Padding="6,3">
                            <TextBlock FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="#9FB6D0" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight">
                                <Run Text="›" Foreground="#45D2FF" /> <Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#14233A" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="Background" Value="#1A3050" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ masthead ═══════ -->
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Margin="0,0,6,0"><TextBlock Text="{Binding Shortcut}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,6,0"><TextBlock Text="{Binding LanguageText}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                <Border Style="{StaticResource Chip}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:ArcadiaLed Width="7" Height="7" Tone="#5FE3A1" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Loc Orc_Offline}" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Width="40" Height="40" CornerRadius="4" BorderBrush="#2A5A8C" BorderThickness="1" VerticalAlignment="Center">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#1B3A5E" />
                        <GradientStop Offset="1" Color="#0A1422" />
                    </RadialGradientBrush>
                </Border.Background>
                <ui:ArcadiaIcon Kind="Oracle" Width="22" Height="22" Foreground="#45D2FF" AccentBrush="White" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ORACLE" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                <TextBlock Text="{l:Loc Orc_Tagline}" Style="{StaticResource Text.Meta}" Margin="0,1,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ═══════ disabled notice ═══════ -->
        <Border Grid.Row="1" Style="{StaticResource RailPanel}" VerticalAlignment="Top" Visibility="{Binding IsEnabled, Converter={StaticResource HasValue}, ConverterParameter=invert}">
            <TextBlock Text="{l:Loc Orc_Disabled}" Style="{StaticResource Text.Base}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- ═══════ terminal ═══════ -->
            <Border CornerRadius="5" BorderBrush="#22385A" BorderThickness="1" Padding="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#0B1422" />
                        <GradientStop Offset="1" Color="#060A10" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="18,14,18,6" Focusable="False">
                        <StackPanel>
                            <!-- empty state -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding Transcript.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                <TextBlock Text="{l:Loc Orc_Welcome}" FontSize="15" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc Orc_WelcomeDetail}" Style="{StaticResource Text.Meta}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource CommandLine}" Focusable="False" />
                            </StackPanel>
                            <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding Transcript}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:OracleEntryViewModel}">
                                        <Border Padding="0,12,0,14" BorderBrush="#15233A" BorderThickness="0,0,0,1">
                                            <ov:OracleResultView />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- prompt -->
                    <Border Grid.Row="1" BorderBrush="#22385A" BorderThickness="0,1,0,0" Background="#070C14" Padding="16,0" CornerRadius="0,0,4,4">
                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="›" FontFamily="{StaticResource Mono}" FontSize="20" Foreground="#45D2FF" VerticalAlignment="Center" />
                            <TextBox x:Name="InputBox" Grid.Column="1" Margin="10,0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="15"
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ui:Bidi.AutoDirection="True"
                                     PreviewKeyDown="OnInputKey" AutomationProperties.Name="{l:Loc Orc_InputName}" AutomationProperties.AutomationId="OracleInput" />
                            <TextBlock Grid.Column="1" Margin="14,0" Text="{l:Loc Orc_Placeholder}" FontFamily="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=InputBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ArcadiaLed Width="7" Height="7" Tone="#45D2FF" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <Border Style="{StaticResource Chip}" Margin="0,0,4,0"><TextBlock Text="Enter" FontSize="10.5" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,4,0"><TextBlock Text="↑ ↓" FontSize="10.5" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                <Border Style="{StaticResource Chip}" Margin="0"><TextBlock Text="Tab" FontSize="10.5" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════ rail ═══════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Border Style="{StaticResource RailPanel}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Orc_Reset}" Command="{Binding ResetContextCommand}" Margin="0,-4,0,0" VerticalAlignment="Top" />
                                <TextBlock Text="{l:Loc Orc_ContextHeading}" Style="{StaticResource RailHeading}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ContextText}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="#9FB6D0" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RailPanel}" Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Orc_SuggestionsHeading}" Style="{StaticResource RailHeading}" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource CommandLine}" Focusable="False" Margin="-6,0" />
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Orc_AllCommands}" Command="{Binding RunTextCommand}" CommandParameter="help" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RailPanel}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Orc_Clear}" Command="{Binding ClearHistoryCommand}" Margin="0,-4,0,0" VerticalAlignment="Top"
                                                  Visibility="{Binding Recent.Count, Converter={StaticResource HasValue}}" />
                                <TextBlock Text="{l:Loc Orc_RecentHeading}" Style="{StaticResource RailHeading}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CommandLine}" Focusable="False" Margin="-6,0" />
                            <TextBlock Text="{l:Loc Orc_NoRecent}" Style="{StaticResource Text.Meta}" Visibility="{Binding Recent.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RailPanel}" Visibility="{Binding CollectUnknown, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Orc_Clear}" Command="{Binding ClearUnknownCommand}" Margin="0,-4,0,0" VerticalAlignment="Top" />
                                <TextBlock Text="{l:Loc Orc_UnknownHeading}" Style="{StaticResource RailHeading}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding UnknownCommands}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="#E0B060" TextTrimming="CharacterEllipsis" Margin="0,1" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:Loc Orc_PrivacyNote}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0" />
                    <ui:ArcadiaButton Variant="Link" Content="{l:Loc Orc_ClearTranscript}" Command="{Binding ClearTranscriptCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                      Visibility="{Binding Transcript.Count, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
