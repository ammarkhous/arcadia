<UserControl x:Class="Arcadia.App.Views.Organizer.CalendarTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
             xmlns:core="clr-namespace:Arcadia.Core.Organizer;assembly=Arcadia.Core"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ the day ═══════ -->
        <Border Style="{StaticResource Tr.Chart}">
            <Border Style="{StaticResource Tr.ChartInner}">
                <DockPanel>
                    <!-- date header with next-up -->
                    <Grid DockPanel.Dock="Top" Height="118">
                        <tv:TopoLines Seed="7" Spacing="15" Stroke="#1A45D2FF" />
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#E00A121C" />
                                    <GradientStop Offset="0.7" Color="#700A121C" />
                                    <GradientStop Offset="1" Color="#200A121C" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <DockPanel Margin="18,12,16,12">
                            <!-- next up -->
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="300" Padding="12,8" CornerRadius="3" BorderThickness="1" BorderBrush="#2E4462" Background="#D00A121E"
                                    Visibility="{Binding Today.Next, Converter={StaticResource Org.HasValue}}">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Today_NextUp}" Style="{StaticResource Org.Kicker}" />
                                    <TextBlock ui:Bidi.Text="{Binding Today.Next.Title}" Style="{StaticResource Text.Item}" FontSize="14" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Org.Time}" Margin="0,2,0,0"><Run Text="{Binding Today.Next.TimeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Today.NextText, Mode=OneWay}" Foreground="#9FD8FF" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Today_Kicker}" Style="{StaticResource Org.Kicker}" />
                                <TextBlock Text="{Binding Today.DateTitle}" Style="{StaticResource Org.BigDate}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Today.DateSubtitle}" Style="{StaticResource Tr.Coord}" FontSize="12" />
                                <TextBlock Text="{Binding Today.Summary}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="#1E2E44" />

                    <!-- active trip -->
                    <Border DockPanel.Dock="Top" Margin="14,10,14,0" Padding="10,7" CornerRadius="3" BorderThickness="1" BorderBrush="#2A4A3A" Background="#0E1A15"
                            Visibility="{Binding Today.ActiveTrip, Converter={StaticResource Org.HasValue}}">
                        <DockPanel>
                            <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Today_OpenTrip}" Command="{Binding OpenEntryCommand}" CommandParameter="{Binding Today.ActiveTrip}" />
                            <ui:ArcadiaIcon Kind="Suitcase" Width="16" Height="16" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}">
                                <Run Text="{Binding Today.ActiveTrip.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E6F0FA" /><Run Text="   " /><Run Text="{Binding Today.ActiveTripText, Mode=OneWay}" Foreground="#8FD8A8" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- all-day -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Today.AllDay}" Margin="14,10,14,0" Focusable="False"
                                  Visibility="{Binding Today.AllDay.Count, Converter={StaticResource Org.HasValue}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ovm:CalendarEntry}">
                                <Button Style="{StaticResource Org.EntryButton}" Margin="0,0,6,6" Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Border CornerRadius="2" Padding="8,4" BorderThickness="2,0,0,0" BorderBrush="{Binding Accent, Converter={StaticResource Org.Tone}}"
                                            Background="{Binding Accent, Converter={StaticResource Org.ToneBrush}, ConverterParameter=0.14}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Opacity" Value="0.45" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="12" Height="12" />
                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="6,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Org.Kicker}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- timeline -->
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Today.Timeline}" Margin="14,8,14,12" Focusable="False" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:CalendarEntry}">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="TodayTime" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="{Binding StartText}" Style="{StaticResource Org.Time}" FontSize="12.5" VerticalAlignment="Top" Margin="0,9,0,0" HorizontalAlignment="Right" />
                                            <!-- rail with a node -->
                                            <Border Grid.Column="1" Width="1" Background="#26384F" HorizontalAlignment="Center" />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" VerticalAlignment="Top" Margin="0,12,0,0" Fill="{Binding Accent, Converter={StaticResource Org.Tone}}" />
                                            <Button Grid.Column="2" Style="{StaticResource Org.EntryButton}" Margin="6,2,0,2"
                                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding}">
                                                <Border Padding="10,6" CornerRadius="3" BorderThickness="1" BorderBrush="#1E2E44" Background="#0C141F">
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource Org.TaskCheck}" Margin="0,0,10,0" IsChecked="{Binding IsDone, Mode=OneWay}"
                                                                  Visibility="{Binding IsTask, Converter={StaticResource Org.HasValue}}"
                                                                  Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:ArcadiaIcon Kind="Repeat" Width="12" Height="12" Margin="6,0,0,0" Opacity="0.7" Visibility="{Binding IsRecurring, Converter={StaticResource Org.HasValue}}" />
                                                            <ui:ArcadiaIcon Kind="Bell" Width="12" Height="12" Margin="6,0,0,0" Opacity="0.7" Visibility="{Binding HasReminder, Converter={StaticResource Org.HasValue}}" />
                                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Org.Kicker}" FontSize="9" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Org.Time}" FontSize="10.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock ui:Bidi.Text="{Binding Location}" Style="{StaticResource Text.Meta}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding Location, Converter={StaticResource Org.HasValue}}" Margin="0,0,10,0" />
                                                                <TextBlock ui:Bidi.Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" FontSize="11.5" Visibility="{Binding Subtitle, Converter={StaticResource Org.HasValue}}" Margin="0,0,10,0" />
                                                                <ContentControl Content="{Binding Context}" Focusable="False" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- quiet day -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding Today.Timeline.Count, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Clock" Width="30" Height="30" Opacity="0.6" />
                            <TextBlock Text="{l:Loc Today_NoTimed}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="{l:Loc Today_NoTimedBody}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <ui:ArcadiaButton HorizontalAlignment="Center" Icon="Plus" IconSize="12" Content="{l:Loc Cal_NewEvent}" Command="{Binding NewEventCommand}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══════ tasks, ahead, notes ═══════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.35*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:ArcadiaPanel Header="{l:Loc Today_Tasks}" Icon="Tasks" Padding="8,4,10,8">
                <ui:ArcadiaPanel.HeaderAction>
                    <ui:ArcadiaButton Variant="Link" Content="{l:Loc Today_AllTasks}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="tasks" />
                </ui:ArcadiaPanel.HeaderAction>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Today.TaskSummary}" Style="{StaticResource Text.Meta}" Margin="4,2,4,6" />
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Today.Tasks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:TaskListItem}">
                                        <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Padding="4,5">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Org.TaskCheck}" Margin="0,0,10,0" IsChecked="{Binding IsDone, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                          AutomationProperties.Name="{Binding Title}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DueText}" Style="{StaticResource Org.Time}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{Binding DueTone, Converter={StaticResource Org.Tone}}" />
                                                <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel>
                                                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Context.Name}" Style="{StaticResource Text.Meta}" FontSize="11" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{l:Loc Today_NoTasks}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding Today.Tasks.Count, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                    </Grid>
                </DockPanel>
            </ui:ArcadiaPanel>

            <ui:ArcadiaPanel Grid.Row="2" Header="{l:Loc Today_Ahead}" Icon="Flag" Padding="8,4,10,8">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Today.Ahead}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ovm:AheadItem}">
                                <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.OpenAheadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding}">
                                    <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Padding="4,5">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DayText}" Style="{StaticResource Org.Time}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{Binding Entry.Accent, Converter={StaticResource Org.Tone}}" Margin="0,0,9,0" />
                                            <ui:ArcadiaIcon Kind="{Binding Entry.Icon}" Width="13" Height="13" Margin="0,0,8,0" />
                                            <TextBlock ui:Bidi.Text="{Binding Entry.Title}" Style="{StaticResource Text.Body}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Loc Today_NothingAhead}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Today.Ahead.Count, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                </Grid>
            </ui:ArcadiaPanel>

            <ui:ArcadiaPanel Grid.Row="4" Header="{l:Loc Today_Notes}" Icon="Notes" Padding="8,4,10,8">
                <ui:ArcadiaPanel.HeaderAction>
                    <ui:ArcadiaButton Variant="Link" Content="{l:Loc Today_AllNotes}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="notes" />
                </ui:ArcadiaPanel.HeaderAction>
                <Grid>
                    <ItemsControl ItemsSource="{Binding Today.Notes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:NoteRow}">
                                <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Padding="4,5">
                                        <DockPanel>
                                            <ui:ArcadiaIcon DockPanel.Dock="Left" Kind="Pin" Width="12" Height="12" Margin="0,2,8,0" VerticalAlignment="Top"
                                                            Visibility="{Binding IsPinned, Converter={StaticResource Org.HasValue}}" />
                                            <StackPanel>
                                                <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock ui:Bidi.Text="{Binding Excerpt}" Style="{StaticResource Text.Meta}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Loc Today_NoNotes}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Today.Notes.Count, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                </Grid>
            </ui:ArcadiaPanel>
        </Grid>
    </Grid>
</UserControl>
