<!-- Calendar, Tasks and Notes on top of Arcadia's design system: planner cells, a restrained task check, the notebook surface. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Arcadia.App.Converters"
                    xmlns:org="clr-namespace:Arcadia.App.Views.Organizer"
                    xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
                    xmlns:ui="urn:arcadia-ui">

    <!-- merged dictionaries cannot see App-level keys: the converters used here live here too -->
    <conv:HasValueToVisibilityConverter x:Key="Org.HasValue" />
    <conv:ToneToColorConverter x:Key="Org.Tone" />
    <org:ToneBrushConverter x:Key="Org.ToneBrush" />
    <org:MinutesToPixelsConverter x:Key="Org.MinutesToMargin" />

    <!-- "PROJECT · Arcadia Development": what something is about; a click opens it -->
    <DataTemplate DataType="{x:Type ovm:ContextChip}">
        <Button Command="{Binding OpenCommand}" Cursor="Hand" ToolTip="{Binding}" AutomationProperties.Name="{Binding}" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="2" Padding="5,1,7,1" BorderThickness="1" BorderBrush="#26384F" Background="#0A121C">
                        <StackPanel Orientation="Horizontal">
                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="11" Height="11" Foreground="{Binding Accent, Converter={StaticResource Org.Tone}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding KindLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="#7F93AE" Margin="5,0,0,0" VerticalAlignment="Center" />
                            <TextBlock ui:Bidi.Text="{Binding Name}" FontSize="11" Foreground="#C8D6E8" Margin="5,0,0,0" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#45D2FF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- planner typography -->
    <Style x:Key="Org.BigDate" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="#E6F0FA" />
    </Style>
    <Style x:Key="Org.Time" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#8FB6D8" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
    <Style x:Key="Org.Kicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Caps}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#7FA9C8" />
    </Style>

    <!-- the task check: a small machined square, cyan when done -->
    <Style x:Key="Org.TaskCheck" TargetType="CheckBox">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="box" CornerRadius="3" BorderThickness="1" BorderBrush="#3A5270" Background="#0A111B">
                        <Path x:Name="mark" Data="M3.5,9 L7.2,12.6 L14.5,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Margin="0,0,0,0" Opacity="0" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#45D2FF" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                            <Setter TargetName="box" Property="Background" Value="#1F6FA8" />
                            <Setter TargetName="box" Property="BorderBrush" Value="#45D2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a month-grid day cell -->
    <Style x:Key="Org.DayCell" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cell" BorderBrush="#1A2638" BorderThickness="0,0,1,1" Background="Transparent">
                        <Grid>
                            <Border x:Name="hover" Background="#0E1826" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a calendar entry pill / row button (no chrome of its own; content draws the accent) -->
    <Style x:Key="Org.EntryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                        <Border x:Name="hover" Background="#18FFFFFF" Opacity="0" IsHitTestVisible="False" CornerRadius="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the notebook's writing surface: calmer, warmer ink, generous line height -->
    <Style x:Key="Org.WritingSurface" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Foreground" Value="#DDE6EF" />
        <Setter Property="CaretBrush" Value="#7CD4FF" />
        <Setter Property="SelectionBrush" Value="#3F8CFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,14,18,14" />
        <Setter Property="TextBlock.LineHeight" Value="23" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- inline text on the page (note title, tags): no box, a hairline appears on focus -->
    <Style x:Key="Org.InlineBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#DDE6EF" />
        <Setter Property="CaretBrush" Value="#7CD4FF" />
        <Setter Property="SelectionBrush" Value="#3F8CFF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="line" BorderThickness="0,0,0,1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="line" Property="BorderBrush" Value="#26384F" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="line" Property="BorderBrush" Value="#45D2FF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the note page itself: slightly lifted paper-like panel inside the dark console -->
    <Style x:Key="Org.Page" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#223248" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#0F1824" />
                    <GradientStop Offset="1" Color="#0B121C" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a small square formatting button in the note toolbar -->
    <Style x:Key="Org.FormatButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#9FB3CC" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#2E4462" />
                            <Setter TargetName="b" Property="Background" Value="#122033" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
