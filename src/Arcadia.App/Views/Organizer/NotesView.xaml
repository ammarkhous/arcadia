<UserControl x:Class="Arcadia.App.Views.Organizer.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
             xmlns:ov="clr-namespace:Arcadia.App.Views.Organizer"
             xmlns:core="clr-namespace:Arcadia.Core.Organizer;assembly=Arcadia.Core"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance ovm:NotesViewModel}" x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="ShelfItem" DataType="{x:Type ovm:NoteShelf}">
            <ui:ArcadiaNavigationItem Style="{StaticResource Tool.RailItem}" GroupName="NoteRail" Height="30" Margin="0,0,0,1"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"
                                      Command="{Binding DataContext.SelectShelfCommand, ElementName=Root}" CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Tr.Coord}" FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" />
                    <TextBlock ui:Bidi.Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </ui:ArcadiaNavigationItem>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ shelves ═══════ -->
        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <tv:TopoLines Seed="41" Spacing="24" Stroke="#10E0B060" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="6,8,6,10">
                            <StackPanel Orientation="Horizontal" Margin="8,2,4,4">
                                <ui:ArcadiaIcon Kind="Notes" Width="22" Height="22" />
                                <TextBlock Text="{l:Loc Nav_Notes}" Style="{StaticResource Text.Title}" FontSize="19" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{l:Loc Note_Tagline}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="8,0,4,10" TextWrapping="Wrap" />
                            <ov:RailItemsControl ItemsSource="{Binding Shelves}" ItemTemplate="{StaticResource ShelfItem}" Focusable="False" />
                            <TextBlock Text="{l:Loc Note_ByModule}" Style="{StaticResource Org.Kicker}" Margin="10,14,4,5" />
                            <ov:RailItemsControl ItemsSource="{Binding ModuleShelves}" ItemTemplate="{StaticResource ShelfItem}" Focusable="False" />
                            <TextBlock Text="{l:Loc Note_ByTag}" Style="{StaticResource Org.Kicker}" Margin="10,14,4,5" Visibility="{Binding TagShelves.Count, Converter={StaticResource Org.HasValue}}" />
                            <ov:RailItemsControl ItemsSource="{Binding TagShelves}" ItemTemplate="{StaticResource ShelfItem}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════ notes list ═══════ -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Note_New}" Command="{Binding NewNoteCommand}" Margin="8,0,0,0" ToolTip="Ctrl+N" />
                <Grid>
                    <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" MinHeight="30" Padding="26,0,6,0" VerticalContentAlignment="Center"
                             ctl:Shortcuts.IsSearchBox="True" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Note_Search}" />
                    <ui:ArcadiaIcon Kind="Search" Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="{l:Loc Note_Search}" Margin="28,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=Search, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                <ComboBox DockPanel.Dock="Right" MinWidth="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="{l:Loc Task_Sort}" />
                <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Org.Kicker}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Tr.List}" AutomationProperties.Name="{Binding ListTitle}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Tr.RowItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ovm:NoteListItem}">
                                    <Grid Margin="10,8,10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="1.5" Margin="0,2" Background="{Binding Accent, Converter={StaticResource Org.Tone}}" Opacity="0.85" />
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Org.Time}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <ui:ArcadiaIcon DockPanel.Dock="Left" Kind="Pin" Width="11" Height="11" Margin="0,0,5,0" Foreground="#45D2FF" Visibility="{Binding IsPinned, Converter={StaticResource Org.HasValue}}" />
                                                <ui:ArcadiaIcon DockPanel.Dock="Left" Kind="Star" Width="11" Height="11" Margin="0,0,5,0" Foreground="#F4C451" Visibility="{Binding IsFavorite, Converter={StaticResource Org.HasValue}}" />
                                                <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock ui:Bidi.Text="{Binding Excerpt}" Style="{StaticResource Text.Meta}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <ContentControl Content="{Binding Context}" Focusable="False" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" Visibility="{Binding IsEmpty, Converter={StaticResource Org.HasValue}}">
                            <ui:ArcadiaIcon Kind="Notes" Width="28" Height="28" Opacity="0.5" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DockPanel>

        <!-- ═══════ the notebook ═══════ -->
        <Border Grid.Column="4" Style="{StaticResource Org.Page}">
            <Grid>
                <!-- no note -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Visibility="{Binding HasNote, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}">
                    <ui:ArcadiaIcon Kind="Journal" Width="34" Height="34" Opacity="0.55" />
                    <TextBlock Text="{l:Loc Note_BookEmptyTitle}" Style="{StaticResource Text.Script}" FontSize="26" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,0" />
                    <TextBlock Text="{l:Loc Note_BookEmptyBody}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <ui:ArcadiaButton HorizontalAlignment="Center" Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Note_New}" Command="{Binding NewNoteCommand}" />
                </StackPanel>

                <DockPanel Visibility="{Binding HasNote, Converter={StaticResource Org.HasValue}}">
                    <!-- header: title, identity and actions -->
                    <StackPanel DockPanel.Dock="Top" Margin="18,12,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" Margin="0,0,4,0" ToolTip="{l:Loc Note_Pin}"
                                              AutomationProperties.Name="{l:Loc Note_Pin}"><ui:ArcadiaIcon Kind="Pin" Width="12" Height="12" /></ToggleButton>
                                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,4,0" ToolTip="{l:Loc Note_Favorite}"
                                              AutomationProperties.Name="{l:Loc Note_Favorite}"><ui:ArcadiaIcon Kind="Star" Width="12" Height="12" /></ToggleButton>
                                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding ShowHistory, Mode=OneWay}" Command="{Binding ToggleHistoryCommand}" Margin="0,0,4,0" ToolTip="{l:Loc Note_History}"
                                              AutomationProperties.Name="{l:Loc Note_History}"><ui:ArcadiaIcon Kind="Clock" Width="12" Height="12" /></ToggleButton>
                                <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="12" Width="28" Height="26" Command="{Binding DeleteCommand}" ToolTip="{l:Loc Confirm_Delete}" AutomationProperties.Name="{l:Loc Confirm_Delete}" />
                            </StackPanel>
                            <TextBox x:Name="TitleBox" Style="{StaticResource Org.InlineBox}" Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Display}" FontSize="22" Foreground="#E6F0FA"
                                     Padding="0,0,0,2" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Note_Title}" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <!-- accent swatches -->
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding AccentChoices}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="14" Height="14" Margin="3,0,0,0" Cursor="Hand" Command="{Binding DataContext.SetAccentCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="s" CornerRadius="7" Background="{Binding Converter={StaticResource Org.Tone}}" BorderBrush="#0A111B" BorderThickness="2" Opacity="0.7" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="s" Property="Opacity" Value="1" /><Setter TargetName="s" Property="BorderBrush" Value="White" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Content="{Binding Context}" Focusable="False" VerticalAlignment="Center" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                            <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="8" Width="18" Height="18" Margin="2,0,8,0" Command="{Binding ClearContextCommand}" ToolTip="{l:Loc Org_Unlink}"
                                              AutomationProperties.Name="{l:Loc Org_Unlink}" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Org_LinkTo}" Command="{Binding PickContextCommand}" VerticalAlignment="Center" />
                            <Grid Margin="12,0,0,0" MaxWidth="240" HorizontalAlignment="Left">
                                <TextBox x:Name="TagsBox" Style="{StaticResource Org.InlineBox}" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" MinHeight="22" FontSize="11.5" Padding="20,3,4,2" VerticalContentAlignment="Center" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Tags}" />
                                <ui:ArcadiaIcon Kind="Hash" Width="11" Height="11" HorizontalAlignment="Left" Margin="3,0,0,0" IsHitTestVisible="False" Opacity="0.7" />
                                <TextBlock Text="{l:Loc Proj_Tags}" Margin="21,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=TagsBox, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                    </StackPanel>

                    <!-- toolbar -->
                    <Border DockPanel.Dock="Top" Margin="12,10,12,0" Padding="4,3" CornerRadius="3" BorderThickness="1" BorderBrush="#1E2E44" Background="#0A111B">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="NoteMode" IsChecked="{Binding Mode, Converter={StaticResource Tr.Equals}, ConverterParameter=Edit, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="Edit" Content="{l:Loc Note_ModeEdit}" Margin="0,0,3,0" />
                                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="NoteMode" IsChecked="{Binding Mode, Converter={StaticResource Tr.Equals}, ConverterParameter=Split, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="Split" Content="{l:Loc Note_ModeSplit}" Margin="0,0,3,0" />
                                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="NoteMode" IsChecked="{Binding Mode, Converter={StaticResource Tr.Equals}, ConverterParameter=Preview, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="Preview" Content="{l:Loc Note_ModePreview}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding ShowEditor}">
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnHeading" ToolTip="{l:Loc Fmt_Heading}" AutomationProperties.Name="{l:Loc Fmt_Heading}"><TextBlock Text="H" FontWeight="Bold" /></Button>
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnBold" ToolTip="{l:Loc Fmt_Bold}" AutomationProperties.Name="{l:Loc Fmt_Bold}"><TextBlock Text="B" FontWeight="Bold" /></Button>
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnItalic" ToolTip="{l:Loc Fmt_Italic}" AutomationProperties.Name="{l:Loc Fmt_Italic}"><TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" /></Button>
                                <Border Width="1" Margin="5,4" Background="#1E2E44" />
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnBullet" ToolTip="{l:Loc Fmt_List}" AutomationProperties.Name="{l:Loc Fmt_List}"><ui:ArcadiaIcon Kind="ViewList" Width="13" Height="13" /></Button>
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnCheckbox" ToolTip="{l:Loc Fmt_Checkbox}" AutomationProperties.Name="{l:Loc Fmt_Checkbox}"><ui:ArcadiaIcon Kind="Check" Width="12" Height="12" /></Button>
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnCode" ToolTip="{l:Loc Fmt_Code}" AutomationProperties.Name="{l:Loc Fmt_Code}"><ui:ArcadiaIcon Kind="Terminal" Width="13" Height="13" /></Button>
                                <Border Width="1" Margin="5,4" Background="#1E2E44" />
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnWebLink" ToolTip="{l:Loc Fmt_Link}" AutomationProperties.Name="{l:Loc Fmt_Link}"><ui:ArcadiaIcon Kind="External" Width="12" Height="12" /></Button>
                                <Button Style="{StaticResource Org.FormatButton}" Click="OnArcadiaLink" ToolTip="{l:Loc Fmt_ArcadiaLink}" AutomationProperties.Name="{l:Loc Fmt_ArcadiaLink}"><ui:ArcadiaIcon Kind="Link" Width="13" Height="13" /></Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- status bar -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#1A2638" BorderThickness="0,1,0,0" Padding="14,5">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats}" Style="{StaticResource Org.Time}" FontSize="10.5" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#5FD08A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaveState}" Value="{x:Static ovm:NoteSaveState.Pending}"><Setter Property="Fill" Value="#E0B060" /></DataTrigger>
                                                <DataTrigger Binding="{Binding SaveState}" Value="{x:Static ovm:NoteSaveState.Saving}"><Setter Property="Fill" Value="#45D2FF" /></DataTrigger>
                                                <DataTrigger Binding="{Binding SaveState}" Value="{x:Static ovm:NoteSaveState.Failed}"><Setter Property="Fill" Value="#FF6A6A" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SaveText}" Style="{StaticResource Org.Kicker}" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" />
                                <ui:ArcadiaButton Variant="Link" Content="{l:Loc Note_Retry}" Command="{Binding RetrySaveCommand}" Margin="10,0,0,0"
                                                  Visibility="{Binding SaveState, Converter={StaticResource Tr.Visible}, ConverterParameter=Failed}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- the page: editor / preview / split, with the history drawer -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EditorColumn" Width="*" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Editor" Style="{StaticResource Org.WritingSurface}" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True"
                                 AutomationProperties.Name="{l:Loc Note_Text}" PreviewKeyDown="OnEditorKey" Visibility="{Binding ShowEditor, Converter={StaticResource Org.HasValue}}" />
                        <Border Grid.Column="1" BorderBrush="#1A2638" BorderThickness="1,0,0,0" Padding="18,10,12,10" Visibility="{Binding ShowPreview, Converter={StaticResource Org.HasValue}}">
                            <ctl:MarkdownView Markdown="{Binding Content}" AutomationProperties.Name="{l:Loc Note_ModePreview}" />
                        </Border>
                        <!-- history -->
                        <Border Grid.Column="2" Width="250" BorderBrush="#1A2638" BorderThickness="1,0,0,0" Background="#0A111B" Visibility="{Binding ShowHistory, Converter={StaticResource Org.HasValue}}">
                            <DockPanel Margin="10,8">
                                <TextBlock DockPanel.Dock="Top" Text="{l:Loc Note_History}" Style="{StaticResource Org.Kicker}" />
                                <TextBlock DockPanel.Dock="Top" Text="{l:Loc Note_HistoryHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Revisions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ovm:RevisionRow}">
                                                <Button Style="{StaticResource ListRowButton}" Padding="6,5" Command="{Binding DataContext.RestoreRevisionCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        ToolTip="{l:Loc Note_Restore}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource Org.Time}" FontSize="11" />
                                                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Meta}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{l:Loc Note_NoHistory}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding Revisions.Count, Converter={StaticResource Org.HasValue}, ConverterParameter=invert}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
