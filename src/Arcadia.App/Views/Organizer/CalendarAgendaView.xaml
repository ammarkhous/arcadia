<UserControl x:Class="Arcadia.App.Views.Organizer.CalendarAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
             x:Name="Root">
    <Border Style="{StaticResource Tr.Chart}">
        <Border Style="{StaticResource Tr.ChartInner}">
            <Grid>
                <ListBox x:Name="List" ItemsSource="{Binding AgendaRows}" Style="{StaticResource Tr.List}" Padding="12,6,12,12" AutomationProperties.Name="{l:Loc CalView_Agenda}"
                         KeyDown="OnKey" MouseDoubleClick="OnDoubleClick" Grid.IsSharedSizeScope="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Tr.RowItem}">
                            <Style.Triggers>
                                <!-- day headings are not stops for the keyboard -->
                                <DataTrigger Binding="{Binding IsEmpty, FallbackValue={x:Null}}" Value="True"><Setter Property="Focusable" Value="False" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsEmpty, FallbackValue={x:Null}}" Value="False"><Setter Property="Focusable" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type ovm:AgendaGroup}">
                            <DockPanel Margin="0,14,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Tr.Coord}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Display}" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C8D6E8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="#7CD4FF" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{l:Loc Cal_NothingPlanned}" Style="{StaticResource Text.Meta}" Margin="14,0,0,1" VerticalAlignment="Bottom"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource Org.HasValue}}" />
                            </DockPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type ovm:CalendarEntry}">
                            <Grid Margin="4,6,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="AgendaTime" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Org.Time}" FontSize="12" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="2" Background="{Binding Accent, Converter={StaticResource Org.Tone}}" />
                                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource Org.TaskCheck}" Margin="0,0,8,0" IsChecked="{Binding IsDone, Mode=OneWay}" Visibility="{Binding IsTask, Converter={StaticResource Org.HasValue}}"
                                                  Command="{Binding DataContext.ToggleTaskCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <ui:ArcadiaIcon Kind="Repeat" Width="11" Height="11" Margin="8,0,0,0" Opacity="0.7" Visibility="{Binding IsRecurring, Converter={StaticResource Org.HasValue}}" />
                                        <ui:ArcadiaIcon Kind="Bell" Width="11" Height="11" Margin="6,0,0,0" Opacity="0.7" Visibility="{Binding HasReminder, Converter={StaticResource Org.HasValue}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock ui:Bidi.Text="{Binding Location}" Style="{StaticResource Text.Meta}" FontSize="11.5" Margin="0,0,10,0" Visibility="{Binding Location, Converter={StaticResource Org.HasValue}}" />
                                        <TextBlock ui:Bidi.Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" FontSize="11.5" Margin="0,0,10,0" Visibility="{Binding Subtitle, Converter={StaticResource Org.HasValue}}" />
                                        <ContentControl Content="{Binding Context}" Focusable="False" Visibility="{Binding Context, Converter={StaticResource Org.HasValue}}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Style="{StaticResource Org.Kicker}" FontSize="9.5" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </Border>
    </Border>
</UserControl>
