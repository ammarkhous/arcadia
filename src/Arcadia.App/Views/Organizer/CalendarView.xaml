<UserControl x:Class="Arcadia.App.Views.Organizer.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             xmlns:ov="clr-namespace:Arcadia.App.Views.Organizer"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance ovm:CalendarViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}" />
        <KeyBinding Key="Home" Modifiers="Alt" Command="{Binding GoTodayCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ planner rail ═══════ -->
        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <tv:TopoLines Seed="17" Spacing="22" Stroke="#1045D2FF" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="6,8,6,10">
                            <StackPanel Orientation="Horizontal" Margin="8,2,4,4">
                                <ui:ArcadiaIcon Kind="Calendar" Width="22" Height="22" />
                                <TextBlock Text="{l:Loc Nav_Calendar}" Style="{StaticResource Text.Title}" FontSize="19" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{l:Loc Cal_Tagline}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="8,0,4,10" TextWrapping="Wrap" />

                            <ov:RailItemsControl ItemsSource="{Binding Views}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:CalendarViewOption}">
                                        <ui:ArcadiaNavigationItem Style="{StaticResource Tool.RailItem}" GroupName="CalRail" Height="32" Margin="0,0,0,1"
                                                                  IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"
                                                                  Command="{Binding DataContext.SetViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Style="{StaticResource Tr.Coord}" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
                                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="16" Height="16" />
                                                <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </ui:ArcadiaNavigationItem>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ov:RailItemsControl>

                            <ui:ArcadiaButton Margin="6,12,6,0" Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Cal_NewEvent}" Command="{Binding NewEventCommand}"
                                              ToolTip="{l:Loc Cal_NewEventTip}" HorizontalAlignment="Stretch" />

                            <!-- sources -->
                            <TextBlock Text="{l:Loc Cal_Sources}" Style="{StaticResource Org.Kicker}" Margin="10,18,4,6" />
                            <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:SourceToggle}">
                                        <CheckBox IsChecked="{Binding IsOn}" Margin="10,2,4,2" Cursor="Hand" AutomationProperties.Name="{Binding Label}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="3" Height="12" CornerRadius="1.5" Background="{Binding Accent, Converter={StaticResource Org.Tone}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- categories -->
                            <DockPanel Margin="10,18,4,4">
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Plus" IconSize="10" Width="22" Height="20" Command="{Binding EditCategoryCommand}"
                                                  ToolTip="{l:Loc Cat_NewTitle}" AutomationProperties.Name="{l:Loc Cat_NewTitle}" />
                                <TextBlock Text="{l:Loc Cal_Categories}" Style="{StaticResource Org.Kicker}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ovm:CategoryRow}">
                                        <Button Style="{StaticResource ListRowButton}" Padding="10,4,6,4" Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:Loc Cat_Edit}" Command="{Binding PlacementTarget.Tag.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="{l:Loc Confirm_Delete}" Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" /></Button.Tag>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="13" Height="13" Foreground="{Binding Accent, Converter={StaticResource Org.Tone}}" />
                                                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════ planner ═══════ -->
        <DockPanel Grid.Column="2">
            <!-- range header -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}" Margin="0,0,0,10">
                <Border Style="{StaticResource Tool.CommandBarInner}" Padding="10,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="…" Style="{StaticResource Text.Meta}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Org.HasValue}}" />
                            <ui:ArcadiaButton Icon="Bolt" IconSize="12" Content="{l:Loc Cmd_QuickCapture}" Height="28" Margin="0,0,2,0"
                                              Command="{Binding DataContext.OpenQuickCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Event" ToolTip="Ctrl+Shift+N" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ArcadiaButton Variant="Tool" Icon="ChevronLeft" IconSize="11" Width="30" Height="28" Command="{Binding PreviousCommand}" ToolTip="{l:Loc Cal_Previous}" AutomationProperties.Name="{l:Loc Cal_Previous}" />
                            <ui:ArcadiaButton Content="{l:Loc Cal_Today}" Height="28" Padding="14,0" Margin="4,0" Command="{Binding GoTodayCommand}" ToolTip="Alt+Home" />
                            <ui:ArcadiaButton Variant="Tool" Icon="ChevronRight" IconSize="11" Width="30" Height="28" Command="{Binding NextCommand}" ToolTip="{l:Loc Cal_Next}" AutomationProperties.Name="{l:Loc Cal_Next}" />
                            <TextBlock Text="{Binding RangeTitle}" Style="{StaticResource Text.Title}" FontSize="19" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RangeSubtitle}" Style="{StaticResource Tr.Coord}" FontSize="12" Margin="12,3,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <Grid>
                <ctl:LazySection Key="Today" Current="{Binding View}">
                    <ctl:LazySection.SectionTemplate><DataTemplate><ov:CalendarTodayView /></DataTemplate></ctl:LazySection.SectionTemplate>
                </ctl:LazySection>
                <ctl:LazySection Key="Month" Current="{Binding View}">
                    <ctl:LazySection.SectionTemplate><DataTemplate><ov:CalendarMonthView /></DataTemplate></ctl:LazySection.SectionTemplate>
                </ctl:LazySection>
                <ov:CalendarWeekView x:Name="WeekView" Visibility="{Binding View, Converter={StaticResource Tr.Visible}, ConverterParameter=Week}" />
                <ov:CalendarWeekView x:Name="DayView" Visibility="{Binding View, Converter={StaticResource Tr.Visible}, ConverterParameter=Day}" />
                <ctl:LazySection Key="Agenda" Current="{Binding View}">
                    <ctl:LazySection.SectionTemplate><DataTemplate><ov:CalendarAgendaView /></DataTemplate></ctl:LazySection.SectionTemplate>
                </ctl:LazySection>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
