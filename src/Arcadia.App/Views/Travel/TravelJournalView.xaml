<UserControl x:Class="Arcadia.App.Views.Travel.TravelJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TravelJournalViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- entries -->
        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="30">
                            <TextBox x:Name="Filter" Padding="26,0,6,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="{l:Loc Tr_SearchJournal}"
                                     ui:Bidi.AutoDirection="True" />
                            <ui:ArcadiaIcon Kind="Search" Width="13" Height="13" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                            <TextBlock Text="{l:Loc Tr_SearchJournal}" Margin="27,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=Filter, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                        <ui:ArcadiaButton Grid.Column="1" Margin="6,0,0,0" Variant="Primary" Icon="Plus" Content="{l:Loc Tr_NewEntry}" Command="{Binding NewCommand}" Height="30" Padding="10,0" />
                    </Grid>
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Tr.List}" AutomationProperties.Name="{l:Loc TrSection_Journal}">
                            <ListBox.ItemContainerStyle>
                                <!-- the title changes while typing: name the row from it, not from a cached ToString -->
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Tr.RowItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type tvm:JournalListItem}">
                                    <Grid Margin="8,8,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- a date stamp -->
                                        <Border Height="44" VerticalAlignment="Top" CornerRadius="3" BorderThickness="1" BorderBrush="#2A3E58" Background="#0E1826">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DayText}" FontFamily="{StaticResource Font.Display}" FontSize="18" Foreground="#DCE7F4" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding MonthText}" Style="{StaticResource Tr.Coord}" FontSize="9" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                <ui:ArcadiaIcon Kind="Star" Width="11" Height="11" Margin="6,0,0,0" Foreground="#FFD26A" Visibility="{Binding IsHighlight, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:ArcadiaIcon Kind="{Binding MoodIcon}" Width="11" Height="11" Margin="6,0,0,0" Visibility="{Binding HasMood, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock ui:Bidi.Text="{Binding Where}" Style="{StaticResource Text.Meta}" FontSize="11" Foreground="#7FA9C8" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Where, Converter={StaticResource HasValue}}" />
                                            <TextBlock ui:Bidi.Text="{Binding Excerpt}" Style="{StaticResource Text.Meta}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="{Binding Items.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Journal" Width="30" Height="30" />
                            <TextBlock Text="{l:Loc Tr_NoEntries}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="{l:Loc Tr_NoEntriesBody}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- editor -->
        <Border Grid.Column="2" Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <tv:TopoLines Seed="9" Spacing="26" Stroke="#0C45D2FF" />
                    <DockPanel Margin="18,14,18,12" Visibility="{Binding HasEntry, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EntryTitle, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Display}" FontSize="22" BorderThickness="0,0,0,1"
                                     Background="Transparent" Padding="0,2" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Tr_EntryTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding IsHighlight}" Margin="0,0,6,0" ToolTip="{l:Loc Tr_HighlightTip}" AutomationProperties.Name="{l:Loc Tr_Highlight}">
                                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Star" Width="12" Height="12" Foreground="#FFD26A" /><TextBlock Text="{l:Loc Tr_Highlight}" Margin="5,0,0,0" /></StackPanel>
                                </ToggleButton>
                                <ui:ArcadiaButton Variant="Tool" Icon="Trash" Width="30" Height="28" ToolTip="{l:Loc Proj_Delete}" AutomationProperties.Name="{l:Loc Proj_Delete}" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{l:Loc Tr_Date}" Style="{StaticResource Tool.InputLabel}" />
                                <TextBox Width="120" MinHeight="28" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="{l:Loc Tr_Date}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{l:Loc Tr_Trip}" Style="{StaticResource Tool.InputLabel}" />
                                <ComboBox Width="180" ItemsSource="{Binding TripOptions}" SelectedItem="{Binding Trip}" AutomationProperties.Name="{l:Loc Tr_Trip}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{l:Loc Tr_Place}" Style="{StaticResource Tool.InputLabel}" />
                                <ComboBox Width="180" ItemsSource="{Binding PlaceOptions}" SelectedItem="{Binding Place}" AutomationProperties.Name="{l:Loc Tr_Place}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{l:Loc Tr_Mood}" Style="{StaticResource Tool.InputLabel}" />
                                <ComboBox Width="140" ItemsSource="{Binding MoodOptions}" SelectedItem="{Binding Mood}" AutomationProperties.Name="{l:Loc Tr_Mood}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource Tool.InputLabel}" />
                                <TextBox Width="170" MinHeight="28" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Tags}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DateError}" Style="{StaticResource FieldError}" Visibility="{Binding DateError, Converter={StaticResource HasValue}}" />
                        <!-- photos of this entry -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <DockPanel>
                                <ui:ArcadiaButton DockPanel.Dock="Right" Style="{StaticResource Tool.Button}" Icon="Camera" Content="{l:Loc Tr_AddPhotos}" Command="{Binding Photos.AddCommand}" />
                                <TextBlock Text="{l:Loc Tr_EntryPhotos}" Style="{StaticResource Tr.Kicker}" VerticalAlignment="Center" />
                            </DockPanel>
                            <tv:PhotoGridView DataContext="{Binding Photos}" MaxHeight="150" Margin="0,6,0,0" Visibility="{Binding Count, Converter={StaticResource HasValue}}" />
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Text.Meta}" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tool.Radio}" Content="{l:Loc Note_Edit}" IsChecked="{Binding IsPreview, Converter={StaticResource InverseBool}}" Margin="0,0,12,0" />
                                <RadioButton Style="{StaticResource Tool.Radio}" Content="{l:Loc Note_Preview}" IsChecked="{Binding IsPreview}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <TextBox Style="{StaticResource TextArea}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="14" ui:Bidi.AutoDirection="True"
                                     AutomationProperties.Name="{l:Loc Tr_EntryText}" Visibility="{Binding IsPreview, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            <Border Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}" BorderThickness="1" BorderBrush="#243650" CornerRadius="3" Padding="10,6" Background="#C0070C14">
                                <ctl:MarkdownView Markdown="{Binding Text}" />
                            </Border>
                        </Grid>
                    </DockPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding HasEntry, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                        <ui:ArcadiaIcon Kind="Journal" Width="40" Height="40" />
                        <TextBlock Text="{l:Loc Tr_JournalEmptyTitle}" Style="{StaticResource Text.Script}" FontSize="30" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{l:Loc Tr_JournalEmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14" />
                        <ui:ArcadiaButton HorizontalAlignment="Center" Variant="Primary" Icon="Plus" Content="{l:Loc Tr_NewEntry}" Command="{Binding NewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
