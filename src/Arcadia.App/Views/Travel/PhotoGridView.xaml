<UserControl x:Class="Arcadia.App.Views.Travel.PhotoGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TravelPhotoGridViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" x:Name="Root">
    <UserControl.Resources>
        <ContextMenu x:Key="PhotoMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Tr_Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Image" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_Reveal}" Command="{Binding RevealCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Tr_SetTripCover}" Command="{Binding SetTripCoverCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Suitcase" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_SetPlaceCover}" Command="{Binding SetPlaceCoverCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="MapPin" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_Highlight}" Command="{Binding ToggleHighlightCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Star" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_AssociatePlace}" Command="{Binding AssociatePlaceCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="MapPin" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_AssociateTrip}" Command="{Binding AssociateTripCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Suitcase" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Doc_RemoveFromArcadia}" Command="{Binding RemoveCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel>
        <!-- GPS suggestion (local matching only) -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="3" BorderThickness="1" BorderBrush="#24506A" Background="#0C1E2A" Padding="10,6"
                Visibility="{Binding GpsSuggestion, Converter={StaticResource HasValue}}">
            <DockPanel>
                <ui:ArcadiaButton DockPanel.Dock="Right" Style="{StaticResource Tool.Button}" Icon="MapPin" Content="{l:Loc Tr_MatchGps}" Command="{Binding MatchGpsCommand}" />
                <ui:ArcadiaIcon Kind="Crosshair" Width="15" Height="15" Foreground="#45D2FF" />
                <TextBlock Text="{Binding GpsSuggestion}" Style="{StaticResource Text.Meta}" Foreground="#BFE8F7" Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ui:ArcadiaIcon Kind="Hourglass" Width="13" Height="13" />
            <TextBlock Text="{l:Loc Tr_AddingPhotos}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" />
        </StackPanel>
        <Grid>
            <ItemsControl x:Name="Grid" ItemsSource="{Binding Rows}" SizeChanged="OnSizeChanged" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Focusable="False" AutomationProperties.Name="{l:Loc Tr_Photos}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tvm:PhotoRowGroup}">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tvm:PhotoItem}">
                                    <Button Style="{StaticResource Tr.PhotoTile}" Width="168" Height="126" Margin="0,0,8,8" ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, ElementName=Root}" ContextMenu="{StaticResource PhotoMenu}" AutomationProperties.Name="{Binding Title}">
                                        <Grid ClipToBounds="True">
                                            <Border Background="#0E1826" />
                                            <ui:ArcadiaIcon Kind="Image" Width="26" Height="26" Opacity="0.25" />
                                            <tv:PhotoThumb x:Name="thumb" Path="{Binding Path}" Orientation="{Binding Orientation}" DecodeWidth="336" />
                                            <!-- missing or unreadable -->
                                            <Border Background="#E0120C0A" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <ui:ArcadiaIcon Kind="Warning" Width="18" Height="18" Foreground="#F2A623" />
                                                    <TextBlock Text="{l:Loc Doc_Missing}" Style="{StaticResource Text.Meta}" Foreground="#FFD58A" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" Height="34">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00060A10" />
                                                        <GradientStop Offset="1" Color="#D0060A10" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Tr.Coord}" FontSize="10" Foreground="#C8D6E8" VerticalAlignment="Bottom" Margin="7,0,24,5" />
                                            <ui:ArcadiaIcon Kind="Crosshair" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,6" Foreground="#45D2FF"
                                                            Visibility="{Binding HasGps, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Loc Tr_HasGps}" />
                                            <ui:ArcadiaIcon Kind="Star" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Foreground="#FFD26A"
                                                            Visibility="{Binding IsHighlight, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- empty -->
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="#243650" Padding="18" VerticalAlignment="Top"
                    Visibility="{Binding Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                <Border.Background>
                    <SolidColorBrush Color="#0A111B" />
                </Border.Background>
                <StackPanel HorizontalAlignment="Center">
                    <ui:ArcadiaIcon Kind="Camera" Width="30" Height="30" />
                    <TextBlock Text="{l:Loc Tr_NoPhotos}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{l:Loc Tr_NoPhotosHint}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,4,0,10" />
                    <ui:ArcadiaButton HorizontalAlignment="Center" Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddPhotos}" Command="{Binding AddCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
