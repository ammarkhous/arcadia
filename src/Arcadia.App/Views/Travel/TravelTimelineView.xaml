<UserControl x:Class="Arcadia.App.Views.Travel.TravelTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TravelViewModel}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,4,10">
                <StackPanel Margin="2,0,0,14">
                    <TextBlock Text="{l:Loc Tr_TimelineKicker}" Style="{StaticResource Tr.Kicker}" />
                    <TextBlock Text="{l:Loc TrSection_Timeline}" Style="{StaticResource Text.Title}" FontSize="24" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tvm:TimelineYear}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- the spine -->
                                <Border Grid.Column="0" Width="2" HorizontalAlignment="Right" Margin="0,0,21,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#3045D2FF" />
                                            <GradientStop Offset="1" Color="#1045D2FF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,10,0">
                                    <ToggleButton IsChecked="{Binding IsExpanded}" Cursor="Hand" FocusVisualStyle="{StaticResource Arcadia.FocusVisual}" AutomationProperties.Name="{Binding YearText}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <TextBlock Text="{Binding YearText}" FontFamily="{StaticResource Font.Display}" FontSize="22" Foreground="#DCE7F4" VerticalAlignment="Center" />
                                                    <Grid Width="24" Height="24" Margin="10,0,0,0">
                                                        <Ellipse Fill="#0A121E" Stroke="#45D2FF" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Fill="#45D2FF" />
                                                    </Grid>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,2,0,18">
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Tr.Coord}" Margin="0,4,0,8" />
                                    <ItemsControl ItemsSource="{Binding Trips}" Focusable="False" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type tvm:TripCard}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- branch -->
                                                    <Border Height="2" VerticalAlignment="Center" Background="#2A45D2FF" Margin="-24,0,0,0" />
                                                    <Border Grid.Column="1" Style="{StaticResource Tool.TableFrame}">
                                                        <Button Style="{StaticResource ListRowButton}" Padding="6" AutomationProperties.Name="{Binding Name}"
                                                                Command="{Binding DataContext.OpenTripCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Height="68" CornerRadius="3" ClipToBounds="True" BorderThickness="1" BorderBrush="#243650">
                                                                    <Grid>
                                                                        <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" Vignette="0.2" />
                                                                        <tv:PhotoThumb Path="{Binding CoverPath}" DecodeWidth="260" Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                                                    <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Item}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Style="{StaticResource Text.Meta}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding DatesText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <ItemsControl ItemsSource="{Binding Flags}" Margin="0,6,0,0" Focusable="False">
                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="1" BorderBrush="#30FFFFFF" Margin="0,0,5,0"><Image Source="{Binding}" Style="{StaticResource Tr.Flag}" Height="12" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <ui:ArcadiaStatusIndicator Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource Tr.Tone}}" MinWidth="0" Height="20" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding CountsText}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding Timeline.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
            <ui:ArcadiaIcon Kind="Timeline" Width="38" Height="38" />
            <TextBlock Text="{l:Loc Tr_TimelineEmptyTitle}" Style="{StaticResource Text.Script}" FontSize="30" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="{l:Loc Tr_TimelineEmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
