<UserControl x:Class="Arcadia.App.Views.Travel.TravelPlacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TravelViewModel}">
    <UserControl.Resources>
        <ContextMenu x:Key="PlaceMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Tr_Open}" Command="{Binding OpenPlaceItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="ArrowRight" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_OpenOnMap}" Command="{Binding ShowPlaceItemOnMapCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Map" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_AddToTrip}" Command="{Binding AddPlaceItemToTripCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Suitcase" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_MarkVisited}" Command="{Binding MarkPlaceItemVisitedCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Check" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_Favorite}" Command="{Binding TogglePlaceItemFavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Star" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Tr_Edit}" Command="{Binding EditPlaceItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Journal" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Proj_Delete}" Command="{Binding DeletePlaceItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Tr_PlacesKicker}" Style="{StaticResource Tr.Kicker}" />
                    <TextBlock Text="{l:Loc TrSection_Places}" Style="{StaticResource Text.Title}" FontSize="24" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="230" Height="34" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Padding="30,0,8,0" Text="{Binding PlaceSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" ctl:Shortcuts.IsSearchBox="True"
                                 AutomationProperties.Name="{l:Loc Tr_SearchSaved}" ui:Bidi.AutoDirection="True" />
                        <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                        <TextBlock Text="{l:Loc Tr_SearchSaved}" Margin="31,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </Grid>
                    <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddPlace}" Command="{Binding AddPlaceCommand}" MinHeight="36" Padding="16,6" />
                </StackPanel>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Tr.Legend}" IsChecked="{Binding PlaceFavoritesOnly}" AutomationProperties.Name="{l:Loc Tr_FavoritesOnly}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Star" Width="12" Height="12" Foreground="#FFD26A" /><TextBlock Text="{l:Loc Tr_FavoritesOnly}" Margin="6,0,0,0" /></StackPanel>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding PlaceStatusFilters}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" Height="28" Padding="12,0" GroupName="PlaceFilter" Content="{Binding Label}" Margin="0,0,6,4"
                                              Command="{Binding DataContext.SetPlaceFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <ui:ArcadiaChoice.IsChecked>
                                    <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                        <Binding Path="DataContext.PlaceStatusFilter" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding />
                                    </MultiBinding>
                                </ui:ArcadiaChoice.IsChecked>
                            </ui:ArcadiaChoice>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <ListBox ItemsSource="{Binding PlacesView}" SelectedItem="{Binding SelectedPlace}" Style="{StaticResource Tr.List}" AutomationProperties.Name="{l:Loc TrSection_Places}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type tvm:PlaceItem}">
                                    <Grid Margin="4,5" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource PlaceMenu}" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding StatusTone, Converter={StaticResource Tr.Tone}}" Background="#0E1826">
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <ui:ArcadiaIcon Kind="Star" Width="12" Height="12" Margin="7,0,0,0" Foreground="#FFD26A" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Image Source="{Binding Flag}" Style="{StaticResource Tr.Flag}" Height="10" Margin="0,0,6,0" Visibility="{Binding Flag, Converter={StaticResource HasValue}}" />
                                                <TextBlock Text="{Binding TypeAndWhere}" Style="{StaticResource Text.Meta}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:ArcadiaStatusIndicator Grid.Column="2" Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource Tr.Tone}}" HorizontalAlignment="Left" MinWidth="0" Height="20" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VisitsText}" Style="{StaticResource Text.Meta}" FontSize="11.5" />
                                            <TextBlock Text="{Binding RatingText}" Foreground="#FFD26A" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding PlacesView.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="MapPin" Width="34" Height="34" />
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Tr_NoPlacesTitle}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,4,0,12" Text="{l:Loc Tr_NoPlacesBody}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                            <ui:ArcadiaButton HorizontalAlignment="Center" Variant="Primary" Icon="MapPin" Content="{l:Loc Tr_AddFirstPlace}" Command="{Binding AddPlaceCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}" Padding="12,10,8,6">
                <Grid>
                    <tv:PlaceDetailsView DataContext="{Binding PlaceDetails}" Visibility="{Binding Place, Converter={StaticResource HasValue}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceDetails.Place, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                        <ui:ArcadiaIcon Kind="Compass" Width="34" Height="34" />
                        <TextBlock Margin="0,10,0,0" Text="{l:Loc Tr_SelectPlace}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
