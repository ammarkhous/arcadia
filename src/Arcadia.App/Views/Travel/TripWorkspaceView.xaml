<UserControl x:Class="Arcadia.App.Views.Travel.TripWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             xmlns:core="clr-namespace:Arcadia.Core.Travel;assembly=Arcadia.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TripWorkspaceViewModel}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ cover banner ═══════ -->
        <Border Height="{Binding BannerHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="4" ClipToBounds="True" BorderThickness="1" BorderBrush="#2A3E58">
            <Grid>
                <ui:ArtworkPresenter Theme="{Binding Card.Theme}" Seed="{Binding Card.Seed}" Vignette="0.3" BottomShade="0.9" />
                <tv:PhotoThumb Path="{Binding Card.CoverPath}" DecodeWidth="1600" Visibility="{Binding Card.HasCover, Converter={StaticResource BoolToVisibility}}" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#E0060A10" />
                            <GradientStop Offset="0.55" Color="#60060A10" />
                            <GradientStop Offset="1" Color="#B0060A10" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <tv:TopoLines Seed="{Binding TripId}" Spacing="20" Stroke="#1845D2FF" />
                <Border Height="3" VerticalAlignment="Top" Background="{Binding Card.Accent, Converter={StaticResource Tr.Tone}}" />
                <Grid Margin="20,12,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <ui:ArcadiaButton HorizontalAlignment="Left" Variant="Link" Icon="ChevronLeft" Content="{l:Loc TrSection_Trips}" Command="{Binding BackCommand}" Foreground="#C8D6E8" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{l:Loc Tr_DossierKicker}" Style="{StaticResource Tr.Kicker}" Foreground="#B9E6FA" />
                        <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.OnArt}" FontFamily="{StaticResource Font.Display}" FontSize="30" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox Width="150" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" AutomationProperties.Name="{l:Loc Tr_TripStatus}" />
                            <TextBlock Style="{StaticResource Text.Meta}" Foreground="#DCE7F4" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Run Text="{Binding DatesText, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding RatingText}" Foreground="#FFD26A" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Star" Content="{l:Loc Tr_Favorite}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,0" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Projects" Content="{Binding ProjectName}" Command="{Binding OpenProjectCommand}" Margin="0,0,6,0"
                                          Visibility="{Binding ProjectName, Converter={StaticResource HasValue}}" ToolTip="{l:Loc Tr_OpenProject}" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Journal" Content="{l:Loc Tr_Edit}" Command="{Binding EditCommand}" Margin="0,0,6,0" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Trash" Width="34" Command="{Binding DeleteCommand}" ToolTip="{l:Loc Proj_DeletePermanently}" AutomationProperties.Name="{l:Loc Proj_DeletePermanently}" />
                    </StackPanel>
                    <!-- the countdown / day counter -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding BigNumber}" FontFamily="{StaticResource Font.Display}" FontSize="44" Foreground="#45D2FF" HorizontalAlignment="Right">
                            <TextBlock.Effect><DropShadowEffect Color="#45D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.7" /></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource Text.Caps}" FontSize="10.5" Foreground="#C8D6E8" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Text.Meta}" Foreground="#9FB2C9" HorizontalAlignment="Right" />
                        <ui:ArcadiaProgressBar Width="180" Height="5" Margin="0,6,0,0" Value="{Binding Progress}" Tone="#45D2FF" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════ dossier ═══════ -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Overview}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Overview, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="01" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="ViewGrid" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Overview}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Itinerary}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Itinerary, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="02" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Timeline" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Itinerary}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Map}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Map, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="03" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Map" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Map}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Places}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Places, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="04" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="MapPin" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Places}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Notes}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Notes, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="05" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Journal" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Notes}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Photos}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Photos, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="06" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Camera" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Photos}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Documents}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Documents, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="07" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Documents" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Documents}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Memories}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Memories, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="08" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Image" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Memories}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tr.DossierTab}" GroupName="Dossier" AutomationProperties.Name="{l:Loc TrTab_Expenses}"
                             IsChecked="{Binding Tab, Converter={StaticResource Tr.Equals}, ConverterParameter=Expenses, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="09" Style="{StaticResource Tr.Coord}" FontSize="10.5" Width="22" /><ui:ArcadiaIcon Kind="Receipt" Width="15" Height="15" /><TextBlock Text="{l:Loc TrTab_Expenses}" Margin="9,0,0,0" /></StackPanel>
                </RadioButton>
                <!-- countries on the dossier spine -->
                <ItemsControl ItemsSource="{Binding CountryChips}" Margin="10,16,8,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border BorderThickness="1" BorderBrush="#30FFFFFF"><Image Source="{Binding Flag}" Style="{StaticResource Tr.Flag}" Height="12" Width="18" /></Border>
                                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Meta}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- the page of the dossier -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#2A3E58" CornerRadius="0,4,4,4" Padding="14,12" Margin="-1,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#0C1522" />
                        <GradientStop Offset="1" Color="#080D15" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- 01 overview -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Overview}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tr_Description}" Style="{StaticResource Tr.Kicker}" />
                                <TextBlock ui:Bidi.Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                                <ui:ArcadiaButton HorizontalAlignment="Left" Variant="Link" Content="{l:Loc Tr_AddDescription}" Command="{Binding EditCommand}" Visibility="{Binding Description, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding CitiesText}" Style="{StaticResource Tr.Coord}" Margin="0,8,0,0" Visibility="{Binding CitiesText, Converter={StaticResource HasValue}}" />

                                <DockPanel Margin="0,18,0,6">
                                    <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Tr_OpenItinerary}" />
                                    <TextBlock Text="{l:Loc TrTab_Itinerary}" Style="{StaticResource Tr.Kicker}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:TripDayViewModel}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="2" Background="{Binding Tone, Converter={StaticResource Tr.Tone}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding NumberText}" Style="{StaticResource Tr.Coord}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="#DCE7F4" /><Run Text="  " /><Run Text="{Binding DateText, Mode=OneWay}" Foreground="#7F93AE" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding DoneText}" Style="{StaticResource Tr.Coord}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Tr_NoDaysYet}" Style="{StaticResource Text.Meta}" Visibility="{Binding IsEmptyItinerary, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{l:Loc Tr_RecentNotes}" Style="{StaticResource Tr.Kicker}" Margin="0,18,0,6" />
                                <ItemsControl ItemsSource="{Binding RecentNotes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:JournalSummary}">
                                            <Button Style="{StaticResource ListRowButton}" Padding="6,5" Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" />
                                                    <TextBlock ui:Bidi.Text="{Binding Excerpt}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Tr_NoNotesYet}" Style="{StaticResource Text.Meta}" Visibility="{Binding RecentNotes.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Tr_Destinations}" Style="{StaticResource Tr.Kicker}" />
                                <ItemsControl ItemsSource="{Binding KeyPlaces}" Margin="0,4,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:PlaceItem}">
                                            <Button Style="{StaticResource ListRowButton}" Padding="6,4" Command="{Binding DataContext.OpenPlaceItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" />
                                                    <ui:ArcadiaStatusIndicator DockPanel.Dock="Right" Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource Tr.Tone}}" MinWidth="0" Height="18" Margin="6,0,0,0" />
                                                    <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Tr_NoTripPlaces}" Style="{StaticResource Text.Meta}" Visibility="{Binding KeyPlaces.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />

                                <TextBlock Text="{l:Loc Tr_SelectedPhotos}" Style="{StaticResource Tr.Kicker}" Margin="0,16,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedPhotos}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:PhotoItem}">
                                            <Button Style="{StaticResource Tr.PhotoTile}" Height="84" Margin="0,0,6,6" Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid ClipToBounds="True"><Border Background="#0E1826" /><tv:PhotoThumb Path="{Binding Path}" Orientation="{Binding Orientation}" DecodeWidth="240" /></Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Tr_NoPhotosYet}" Style="{StaticResource Text.Meta}" Visibility="{Binding SelectedPhotos.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />

                                <TextBlock Text="{l:Loc Tr_ImportantDocs}" Style="{StaticResource Tr.Kicker}" Margin="0,16,0,6" />
                                <ItemsControl ItemsSource="{Binding ImportantDocuments}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:TripDocumentRow}">
                                            <Button Style="{StaticResource ListRowButton}" Padding="6,4" Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <ctl:FileIcon Extension="{Binding Document.Extension}" IsFolder="{Binding Document.IsFolder}" />
                                                    <TextBlock Text="{Binding Document.DisplayName}" Style="{StaticResource Text.Body}" Margin="8,0,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Tr_NoImportantDocs}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Visibility="{Binding ImportantDocuments.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 02 itinerary -->
                    <DockPanel Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Itinerary}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddItem}" Command="{Binding AddItemCommand}" Margin="0,0,8,0" />
                            <ui:ArcadiaButton Icon="Calendar" Content="{l:Loc Tr_AddDay}" Command="{Binding AddDayCommand}" Margin="0,0,8,0" />
                            <ui:ArcadiaButton Icon="Timeline" Content="{l:Loc Tr_DaysFromDates}" Command="{Binding CreateDaysFromDatesCommand}" ToolTip="{l:Loc Tr_DaysFromDatesTip}" />
                            <TextBlock Text="{l:Loc Tr_DragHint}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:TripDayViewModel}">
                                            <Border Margin="0,0,0,10" CornerRadius="3" BorderThickness="1" BorderBrush="#243650" Background="#0A111B" AllowDrop="True" Drop="OnDayDrop" DragOver="OnDayDragOver" Tag="{Binding}">
                                                <DockPanel>
                                                    <!-- day heading -->
                                                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#1A283C" Padding="10,7">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DoneText}" Style="{StaticResource Tr.Coord}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <ui:ArcadiaButton Variant="Tool" Icon="Plus" IconSize="11" Width="26" Height="24" ToolTip="{l:Loc Tr_AddItem}" AutomationProperties.Name="{l:Loc Tr_AddItem}"
                                                                                  Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                <ui:ArcadiaButton Variant="Tool" Icon="Sort" IconSize="11" Width="26" Height="24" ToolTip="{l:Loc Tr_SortByTime}" AutomationProperties.Name="{l:Loc Tr_SortByTime}"
                                                                                  Command="{Binding DataContext.SortDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="11" Width="26" Height="24" ToolTip="{l:Loc Tr_DeleteDay}" AutomationProperties.Name="{l:Loc Tr_DeleteDay}"
                                                                                  Command="{Binding DataContext.DeleteDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <Border Width="4" Height="22" CornerRadius="2" Background="{Binding Tone, Converter={StaticResource Tr.Tone}}" />
                                                            <TextBlock Text="{Binding NumberText}" Style="{StaticResource Tr.Coord}" FontSize="12" Foreground="#DCE7F4" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                            <TextBlock Text=" — " Foreground="#4E6A8C" VerticalAlignment="Center" />
                                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" MaxWidth="340" FontSize="14" BorderThickness="0,0,0,1" Background="Transparent" Padding="2,0"
                                                                     VerticalAlignment="Center" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Tr_DayTitle}" LostFocus="OnDayTitleLostFocus" KeyDown="OnDayTitleKey" Tag="{Binding}" />
                                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                        </DockPanel>
                                                    </Border>
                                                    <!-- items -->
                                                    <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type tvm:ItineraryItemViewModel}">
                                                                    <Border BorderThickness="0,0,0,1" BorderBrush="#121E2E" Padding="8,6" Background="Transparent" Tag="{Binding}"
                                                                            PreviewMouseLeftButtonDown="OnItemMouseDown" MouseMove="OnItemMouseMove">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="84" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox Style="{StaticResource Tool.Check}" VerticalAlignment="Center" IsChecked="{Binding IsDone, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"
                                                                                      Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Tr.Coord}" FontSize="12" Foreground="#9FD8F0" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                            <ui:ArcadiaIcon Grid.Column="2" Kind="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" ToolTip="{Binding CategoryText}" />
                                                                            <StackPanel Grid.Column="3" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                                <TextBlock ui:Bidi.Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Item}">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                                    <Setter Property="Foreground" Value="#6F86A6" />
                                                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding PlaceName, Converter={StaticResource HasValue}}">
                                                                                    <ui:ArcadiaIcon Kind="MapPin" Width="11" Height="11" />
                                                                                    <TextBlock ui:Bidi.Text="{Binding PlaceName}" Style="{StaticResource Text.Meta}" FontSize="11.5" Margin="4,0,0,0" />
                                                                                </StackPanel>
                                                                                <TextBlock ui:Bidi.Text="{Binding Description}" Style="{StaticResource Text.Meta}" FontSize="11.5" TextWrapping="Wrap" Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                                                                                <TextBlock ui:Bidi.Text="{Binding Notes}" Style="{StaticResource Text.Meta}" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Visibility="{Binding Notes, Converter={StaticResource HasValue}}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="External" IconSize="11" Width="24" Height="22" ToolTip="{Binding Url}" AutomationProperties.Name="{l:Loc Link_Open}"
                                                                                                  Command="{Binding DataContext.OpenItemLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                                                  Visibility="{Binding Url, Converter={StaticResource HasValue}}" />
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="Map" IconSize="11" Width="24" Height="22" ToolTip="{l:Loc Tr_OpenOnMap}" AutomationProperties.Name="{l:Loc Tr_OpenOnMap}"
                                                                                                  Command="{Binding DataContext.OpenItemPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                                                  Visibility="{Binding PlaceName, Converter={StaticResource HasValue}}" />
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="22" Height="22" RenderTransformOrigin="0.5,0.5" ToolTip="{l:Loc Tr_MoveUp}" AutomationProperties.Name="{l:Loc Tr_MoveUp}"
                                                                                                  Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                                    <ui:ArcadiaButton.RenderTransform><RotateTransform Angle="180" /></ui:ArcadiaButton.RenderTransform>
                                                                                </ui:ArcadiaButton>
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="22" Height="22" ToolTip="{l:Loc Tr_MoveDown}" AutomationProperties.Name="{l:Loc Tr_MoveDown}"
                                                                                                  Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="Journal" IconSize="11" Width="24" Height="22" ToolTip="{l:Loc Tr_Edit}" AutomationProperties.Name="{l:Loc Tr_Edit}"
                                                                                                  Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                                <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="11" Width="24" Height="22" ToolTip="{l:Loc Proj_Delete}" AutomationProperties.Name="{l:Loc Proj_Delete}"
                                                                                                  Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{l:Loc Tr_EmptyDay}" Style="{StaticResource Text.Meta}" Margin="12,8" Visibility="{Binding Items.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding IsEmptyItinerary, Converter={StaticResource BoolToVisibility}}">
                                <ui:ArcadiaIcon Kind="Timeline" Width="36" Height="36" />
                                <TextBlock Text="{l:Loc Tr_ItineraryEmptyTitle}" Style="{StaticResource Text.Title}" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="{l:Loc Tr_ItineraryEmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:ArcadiaButton Variant="Primary" Icon="Timeline" Content="{l:Loc Tr_DaysFromDates}" Command="{Binding CreateDaysFromDatesCommand}" Margin="0,0,8,0" />
                                    <ui:ArcadiaButton Icon="Calendar" Content="{l:Loc Tr_AddDay}" Command="{Binding AddDayCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- 03 map -->
                    <Grid Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Map}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Tr.Chart}">
                            <Border Style="{StaticResource Tr.ChartInner}">
                                <Grid>
                                    <tv:WorldMap x:Name="TripMap" Countries="{Binding Countries}" Tiles="{Binding Tiles}" Markers="{Binding Markers}" Routes="{Binding Routes}" LanguageCode="{Binding LanguageCode}"
                                                 SelectedKey="{Binding SelectedMarker}" MarkerCommand="{Binding MarkerClickedCommand}" Zoom="2" />
                                    <Border VerticalAlignment="Bottom" Height="22" Background="#C8060A10">
                                        <DockPanel Margin="8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{l:Loc Tr_AttributionOsm}" Style="{StaticResource Tr.Coord}" FontSize="10" VerticalAlignment="Center"
                                                       Visibility="{Binding ShowsTiles, ElementName=TripMap, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding CursorText, ElementName=TripMap}" Style="{StaticResource Tr.Coord}" FontSize="10" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Button Style="{StaticResource Tr.MapButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="OnFitTrip" ToolTip="{l:Loc Tr_FitAll}" AutomationProperties.Name="{l:Loc Tr_FitAll}">
                                        <ui:ArcadiaIcon Kind="Crosshair" Width="15" Height="15" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{l:Loc Tr_MapKey}" Style="{StaticResource Tr.Kicker}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tvm:TripDayViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Width="18" Height="4" CornerRadius="2" Background="{Binding Tone, Converter={StaticResource Tr.Tone}}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Text.Meta}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding NumberText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,14,0,0" Padding="10" CornerRadius="3" BorderThickness="1" BorderBrush="#243650" Background="#0A111B" Visibility="{Binding MapInfoTitle, Converter={StaticResource HasValue}}">
                                <StackPanel>
                                    <TextBlock ui:Bidi.Text="{Binding MapInfoTitle}" Style="{StaticResource Text.Item}" TextWrapping="Wrap" />
                                    <TextBlock ui:Bidi.Text="{Binding MapInfoText}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock ui:Bidi.Text="{Binding MapInfoNotes}" Style="{StaticResource Text.Meta}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding MapInfoNotes, Converter={StaticResource HasValue}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{l:Loc Tr_TripMapHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 04 places -->
                    <DockPanel Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Places}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddSavedPlace}" Command="{Binding AddPlaceCommand}" Margin="0,0,8,0" />
                            <ui:ArcadiaButton Icon="MapPin" Content="{l:Loc Tr_NewPlaceForTrip}" Command="{Binding NewPlaceCommand}" />
                        </StackPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Places}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tvm:TripPlaceRow}">
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Separator}" Padding="6,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding OrderText}" Style="{StaticResource Tr.Coord}" FontSize="13" VerticalAlignment="Center" />
                                                    <ui:ArcadiaIcon Grid.Column="1" Kind="{Binding Place.Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock ui:Bidi.Text="{Binding Place.Name}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Text.Meta}" FontSize="11.5" TextTrimming="CharacterEllipsis"><Run Text="{Binding Place.TypeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Place.Where, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                    <ui:ArcadiaStatusIndicator Grid.Column="3" Text="{Binding Place.StatusText}" Tone="{Binding Place.StatusTone, Converter={StaticResource Tr.Tone}}" HorizontalAlignment="Left" MinWidth="0" Height="20" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Check" Content="{l:Loc Tr_MarkVisited}" Margin="0,0,6,0"
                                                                          Command="{Binding DataContext.VisitPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Map" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Tr_OpenOnMap}" AutomationProperties.Name="{l:Loc Tr_OpenOnMap}"
                                                                          Command="{Binding DataContext.OpenPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="24" Height="24" RenderTransformOrigin="0.5,0.5" ToolTip="{l:Loc Tr_MoveUp}" AutomationProperties.Name="{l:Loc Tr_MoveUp}"
                                                                          Command="{Binding DataContext.MovePlaceUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <ui:ArcadiaButton.RenderTransform><RotateTransform Angle="180" /></ui:ArcadiaButton.RenderTransform>
                                                        </ui:ArcadiaButton>
                                                        <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="24" Height="24" ToolTip="{l:Loc Tr_MoveDown}" AutomationProperties.Name="{l:Loc Tr_MoveDown}"
                                                                          Command="{Binding DataContext.MovePlaceDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="10" Width="24" Height="24" ToolTip="{l:Loc Tr_RemoveFromTrip}" AutomationProperties.Name="{l:Loc Tr_RemoveFromTrip}"
                                                                          Command="{Binding DataContext.RemovePlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{l:Loc Tr_NoTripPlacesBody}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                       Visibility="{Binding Places.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                    </DockPanel>

                    <!-- 05 notes (the trip's journal) -->
                    <tv:TravelJournalView DataContext="{Binding Journal}" Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Tr.Visible}, ConverterParameter=Notes}" />

                    <!-- 06 photos -->
                    <DockPanel Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Photos}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddPhotos}" Command="{Binding Photos.AddCommand}" />
                            <TextBlock Text="{l:Loc Tr_PhotosHint}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                        <tv:PhotoGridView DataContext="{Binding Photos}" />
                    </DockPanel>

                    <!-- 07 documents -->
                    <DockPanel Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Documents}" AllowDrop="True" Drop="OnDocumentsDrop" DragOver="OnDocumentsDragOver" Background="Transparent">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Ws_AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                            <ui:ArcadiaButton Icon="Library" Content="{l:Loc Tr_FromLibrary}" Command="{Binding AddFromLibraryCommand}" />
                            <TextBlock Text="{l:Loc Tr_DocsHint}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Documents}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:TripDocumentRow}">
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Separator}" Padding="6,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ctl:FileIcon Extension="{Binding Document.Extension}" IsFolder="{Binding Document.IsFolder}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Document.DisplayName}" Style="{StaticResource Text.Item}" FontSize="13.5" FlowDirection="LeftToRight" />
                                                            <ui:ArcadiaIcon Kind="Star" Width="12" Height="12" Margin="7,0,0,0" Foreground="#FFD26A" Visibility="{Binding IsImportant, Converter={StaticResource BoolToVisibility}}" />
                                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0,6,1" Background="#3A2A10" BorderBrush="#8A6420" Visibility="{Binding Document.IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{l:Loc Doc_Missing}" FontSize="11" Foreground="#FFC96B" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Document.Path}" Style="{StaticResource Cell.Path}" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="External" Content="{l:Loc Doc_Open}" Margin="0,0,6,0"
                                                                          Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Star" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Tr_MarkImportant}" AutomationProperties.Name="{l:Loc Tr_MarkImportant}"
                                                                          Command="{Binding DataContext.ToggleImportantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Documents" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Doc_Reveal}" AutomationProperties.Name="{l:Loc Doc_Reveal}"
                                                                          Command="{Binding DataContext.RevealDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Library" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Tr_ShowInLibrary}" AutomationProperties.Name="{l:Loc Tr_ShowInLibrary}"
                                                                          Command="{Binding DataContext.ShowInLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="10" Width="26" Height="24" ToolTip="{l:Loc Tr_RemoveFromTrip}" AutomationProperties.Name="{l:Loc Tr_RemoveFromTrip}"
                                                                          Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="{Binding Documents.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                <ui:ArcadiaIcon Kind="Documents" Width="34" Height="34" />
                                <TextBlock Text="{l:Loc Tr_NoDocsTitle}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="{l:Loc Tr_NoDocsBody}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- 08 memories -->
                    <tv:TravelMemoriesView Chapters="{Binding Memories}" OpenCommand="{Binding OpenMemoryCommand}" ShowHeader="False"
                                           Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Memories}" />

                    <!-- 09 expenses (Finance) -->
                    <ContentControl Content="{Binding Expenses}" Focusable="False" Visibility="{Binding Tab, Converter={StaticResource Tr.Visible}, ConverterParameter=Expenses}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
