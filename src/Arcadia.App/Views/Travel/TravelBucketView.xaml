<UserControl x:Class="Arcadia.App.Views.Travel.TravelBucketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tv="clr-namespace:Arcadia.App.Views.Travel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance tvm:TravelViewModel}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Loc Tr_BucketKicker}" Style="{StaticResource Tr.Kicker}" />
                <TextBlock Text="{l:Loc TrSection_Bucket}" Style="{StaticResource Text.Title}" FontSize="24" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding BucketShowDone}" Margin="0,0,10,0" AutomationProperties.Name="{l:Loc Tr_ShowDone}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Check" Width="12" Height="12" /><TextBlock Text="{l:Loc Tr_ShowDone}" Margin="6,0,0,0" /></StackPanel>
                </ToggleButton>
                <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Tr_AddBucket}" Command="{Binding AddBucketCommand}" MinHeight="36" Padding="16,6" />
            </StackPanel>
        </Grid>

        <!-- progress plate -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Tr.Chart}" Margin="0,0,0,10">
            <Grid Height="74">
                <tv:TopoLines Seed="21" Spacing="14" />
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ArcadiaIcon Kind="Flag" Width="30" Height="30" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BucketProgressText}" Style="{StaticResource Text.Item}" />
                        <ui:ArcadiaProgressBar Height="6" Margin="0,8,0,0" Value="{Binding BucketPercent}" Tone="#FFD26A" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}" Padding="6,2,6,4">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding BucketItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tvm:BucketItem}">
                                    <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Tool.Check}" VerticalAlignment="Center" IsChecked="{Binding IsCompleted, Mode=OneWay}" AutomationProperties.Name="{Binding Title}"
                                                      Command="{Binding DataContext.ToggleBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Border Grid.Column="1" Width="32" Height="32" Margin="10,0" CornerRadius="16" BorderThickness="1" BorderBrush="{Binding PriorityTone, Converter={StaticResource Tr.Tone}}" Background="#0E1826">
                                                <Grid>
                                                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" />
                                                    <Image Source="{Binding Flag}" Height="12" Stretch="Uniform" Visibility="{Binding Flag, Converter={StaticResource HasValue}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock ui:Bidi.Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Item}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="#7F93AE" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Text.Meta}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PriorityText, Mode=OneWay}" Foreground="{Binding PriorityTone, Converter={StaticResource Tr.Tone}}" /><Run Text="  " /><Run Text="{Binding LinksText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock ui:Bidi.Text="{Binding Notes}" Style="{StaticResource Text.Meta}" FontStyle="Italic" TextTrimming="CharacterEllipsis" Visibility="{Binding Notes, Converter={StaticResource HasValue}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding TargetText}" Style="{StaticResource Tr.Coord}" VerticalAlignment="Center" Margin="10,0" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="24" Height="24" RenderTransformOrigin="0.5,0.5" ToolTip="{l:Loc Tr_MoveUp}" AutomationProperties.Name="{l:Loc Tr_MoveUp}"
                                                                  Command="{Binding DataContext.MoveBucketUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <ui:ArcadiaButton.RenderTransform><RotateTransform Angle="180" /></ui:ArcadiaButton.RenderTransform>
                                                </ui:ArcadiaButton>
                                                <ui:ArcadiaButton Variant="Tool" Icon="ChevronDown" IconSize="10" Width="24" Height="24" ToolTip="{l:Loc Tr_MoveDown}" AutomationProperties.Name="{l:Loc Tr_MoveDown}"
                                                                  Command="{Binding DataContext.MoveBucketDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <ui:ArcadiaButton Variant="Tool" Icon="Journal" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Tr_Edit}" AutomationProperties.Name="{l:Loc Tr_Edit}"
                                                                  Command="{Binding DataContext.EditBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="12" Width="26" Height="24" ToolTip="{l:Loc Proj_Delete}" AutomationProperties.Name="{l:Loc Proj_Delete}"
                                                                  Command="{Binding DataContext.DeleteBucketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding BucketItems.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                        <ui:ArcadiaIcon Kind="Flag" Width="36" Height="36" />
                        <TextBlock Text="{l:Loc Tr_BucketEmptyTitle}" Style="{StaticResource Text.Script}" FontSize="30" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{l:Loc Tr_BucketEmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14" />
                        <ui:ArcadiaButton HorizontalAlignment="Center" Variant="Primary" Icon="Plus" Content="{l:Loc Tr_BuildBucket}" Command="{Binding AddBucketCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
