<UserControl x:Class="Arcadia.App.Views.MaintenancePanels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:vm="clr-namespace:Arcadia.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MaintenanceViewModel}">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Separator}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="Path" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Backup & recovery ═══════════ -->
        <ui:ArcadiaPanel Header="{l:Loc Backup_CenterTitle}" Icon="Drive" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{l:Loc Backup_CenterHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="4,4,4,6" />

                <!-- where, when, what -->
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Backup_Folder}" Style="{StaticResource Text.Item}" />
                            <TextBlock Text="{Binding BackupFolder}" Style="{StaticResource Path}" ToolTip="{Binding BackupFolder}" />
                            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Text.Meta}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ArcadiaButton Content="{l:Loc Backup_Change}" Command="{Binding ChangeFolderCommand}" MinWidth="70" Margin="0,0,6,0" />
                            <ui:ArcadiaButton Icon="Documents" Content="{l:Loc Settings_Open}" Command="{Binding OpenBackupFolderCommand}" MinWidth="70" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Backup_Automatic}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding Schedule}" MinHeight="28" AutomationProperties.Name="{l:Loc Backup_Automatic}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Loc Backup_Keep}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding KeepChoices}" SelectedItem="{Binding Keep}" MinHeight="28" AutomationProperties.Name="{l:Loc Backup_Keep}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeReferencedFiles}" AutomationProperties.Name="{l:Loc Backup_IncludeRefs}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Backup_IncludeRefs}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{l:Loc Backup_IncludeRefsHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{Binding ReferencedEstimate}" Style="{StaticResource Text.Meta}" Foreground="{StaticResource Brush.Gold}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ReferencedEstimate, Converter={StaticResource HasValue}}" />
                    </StackPanel>
                </Border>

                <!-- create / progress -->
                <Grid Margin="4,12,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:ArcadiaButton Icon="Export" Content="{l:Loc Backup_CreateNow}" Command="{Binding CreateBackupCommand}" IsDefault="False"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                        <ui:ArcadiaButton Icon="Import" Content="{l:Loc Backup_RestoreFrom}" Command="{Binding ChooseRestoreCommand}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StageText}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                            <ui:ArcadiaButton Grid.Column="1" Variant="Link" Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" />
                        </Grid>
                        <ui:ArcadiaProgressBar Height="7" Margin="0,4,0,0" Value="{Binding Progress}" AutomationProperties.Name="{l:Loc Backup_CenterTitle}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding BackupResult}" Style="{StaticResource Text.Meta}" Margin="4,8,4,0" TextWrapping="Wrap"
                           Visibility="{Binding BackupResult, Converter={StaticResource HasValue}}">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BackupFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Tone.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>

                <!-- restore: what the chosen archive contains, the warning, the two-step button -->
                <TextBlock Text="{Binding CandidateError}" Foreground="{StaticResource Brush.Tone.Red}" Style="{StaticResource Text.Meta}" Margin="4,8,4,0" TextWrapping="Wrap"
                           Visibility="{Binding CandidateError, Converter={StaticResource HasValue}}" />
                <Border Margin="0,10,0,0" Padding="12,10" Background="{StaticResource Brush.Sunken}" BorderBrush="{StaticResource Brush.LineStrong}" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding HasCandidate, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Backup_CandidateTitle}" Style="{StaticResource Text.Item}" />
                        <TextBlock Text="{Binding CandidateSummary}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding CandidateContents}" Style="{StaticResource Text.Meta}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{l:Loc Backup_RestoreWarning}" Style="{StaticResource Text.Meta}" Foreground="{StaticResource Brush.Tone.Amber}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:ArcadiaButton Icon="Import" Command="{Binding RestoreCommand}" Margin="0,0,8,0" x:Name="RestoreButton">
                                <ui:ArcadiaButton.Style>
                                    <Style TargetType="ui:ArcadiaButton" BasedOn="{StaticResource {x:Type ui:ArcadiaButton}}">
                                        <Setter Property="Content" Value="{l:Loc Backup_RestoreAndRestart}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfirmingRestore}" Value="True">
                                                <Setter Property="Content" Value="{l:Loc Backup_RestoreConfirm}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:ArcadiaButton.Style>
                            </ui:ArcadiaButton>
                            <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding DismissRestoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:ArcadiaPanel>

        <!-- ═══════════ Diagnostics & maintenance ═══════════ -->
        <ui:ArcadiaPanel Grid.Column="2" Header="{l:Loc Diag_Title}" Icon="Diagnostic" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,6,4,10">
                    <ui:ArcadiaIcon Kind="Logo" Width="34" Height="34" Foreground="{StaticResource Brush.Gold}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <ui:ArcadiaWordmark Text="ARCADIA" FontSize="19" Tracking="0.12" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Meta}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{l:Loc Diag_DataFolder}" Style="{StaticResource Text.Label}" FontSize="12.5" />
                    <TextBlock Text="{Binding DataFolderPath}" Style="{StaticResource Path}" ToolTip="{Binding DataFolderPath}" Margin="0,2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Diagnostics}" Tag="130" Focusable="False" />
                <WrapPanel Margin="0,12,0,0">
                    <ui:ArcadiaButton Icon="EventLog" Content="{l:Loc Diag_OpenLogs}" Command="{Binding OpenLogsCommand}" Margin="0,0,6,6" />
                    <ui:ArcadiaButton Icon="Documents" Content="{l:Loc Diag_OpenData}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,6" />
                    <ui:ArcadiaButton Icon="Check" Content="{l:Loc Diag_CheckDb}" Command="{Binding CheckDatabaseCommand}" Margin="0,0,6,6" />
                    <ui:ArcadiaButton Icon="Close" Content="{l:Loc Diag_ClearCache}" Command="{Binding ClearCacheCommand}" Margin="0,0,6,6" />
                    <ui:ArcadiaButton Icon="Copy" Content="{l:Loc Diag_Copy}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,6,6" />
                </WrapPanel>
                <TextBlock Text="{Binding DatabaseCheck}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="4,2,4,0"
                           Visibility="{Binding DatabaseCheck, Converter={StaticResource HasValue}}">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DatabaseCheckFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Tone.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>
                <TextBlock Text="{Binding MaintenanceStatus}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="4,2,4,0"
                           Visibility="{Binding MaintenanceStatus, Converter={StaticResource HasValue}}" />
                <Border Style="{StaticResource Row}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Diag_ResetSettings}" Style="{StaticResource Text.Item}" />
                            <TextBlock Text="{l:Loc Diag_ResetSettingsHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ArcadiaButton Grid.Column="1" VerticalAlignment="Center" Command="{Binding ResetSettingsCommand}" Margin="8,0,0,0">
                            <ui:ArcadiaButton.Style>
                                <Style TargetType="ui:ArcadiaButton" BasedOn="{StaticResource {x:Type ui:ArcadiaButton}}">
                                    <Setter Property="Content" Value="{l:Loc Diag_Reset}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmingReset}" Value="True">
                                            <Setter Property="Content" Value="{l:Loc Diag_ResetConfirm}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ArcadiaButton.Style>
                        </ui:ArcadiaButton>
                    </Grid>
                </Border>
            </StackPanel>
        </ui:ArcadiaPanel>
    </Grid>
</UserControl>
