<!-- Styles specific to Arcadia's own screens (the reusable controls live in Arcadia.UI). -->
<ResourceDictionary xmlns:shared="clr-namespace:Arcadia.UI;assembly=Arcadia.UI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:arcadia-ui">

    <ResourceDictionary.MergedDictionaries>
        <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/Palette.xaml" />
        <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/Typography.xaml" />
        <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/StandardControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- A list row that behaves like a button: hover wash, pressed dip, keyboard focus -->
    <Style x:Key="ListRowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="wash" CornerRadius="3" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#262F6BD9" />
                                    <GradientStop Offset="1" Color="#0A2F6BD9" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="edge" Width="2" HorizontalAlignment="Left" Margin="0,5" Background="{StaticResource Brush.Cyan}" Opacity="0" CornerRadius="1" />
                        <ContentPresenter x:Name="content" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="wash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumbnail selector: a framed slide that lights up when selected -->
    <Style x:Key="ThumbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="glow" Background="#2F7BFF" CornerRadius="3" Opacity="0" Margin="-1">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="frame" Background="#05070A" BorderBrush="#2A3850" BorderThickness="1" CornerRadius="3" Padding="1">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="dim" Background="#55000000" CornerRadius="2" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dim" Property="Opacity" Value="0" />
                            <Setter TargetName="frame" Property="BorderBrush" Value="#5A7FB8" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="dim" Property="Opacity" Value="0" />
                            <Setter TargetName="frame" Property="BorderBrush" Value="#7CC4FF" />
                            <Setter TargetName="glow" Property="Opacity" Value="0.7" />
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="frame" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Framed artwork well used by hero images -->
    <Style x:Key="ArtworkWell" TargetType="Border">
        <Setter Property="Background" Value="#05070A" />
        <Setter Property="BorderBrush" Value="#2A3850" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Genre chip -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#161E2B" />
        <Setter Property="BorderBrush" Value="#2E3D55" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="Margin" Value="0,0,5,4" />
    </Style>

    <!-- Etched divider: dark groove with a lit lower lip -->
    <Style x:Key="EtchedDivider" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#03050A" />
                    <GradientStop Offset="0.5" Color="#03050A" />
                    <GradientStop Offset="0.5" Color="#1E2A3C" />
                    <GradientStop Offset="1" Color="#1E2A3C" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header category links: GAMES • IT TOOLS • ... -->
    <Style x:Key="CategoryLink" TargetType="Button">
        <Setter Property="Foreground" Value="#C9D3E1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <TextBlock x:Name="text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="text" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="1" Color="#3F8CFF" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#9FB2CC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text over artwork gets a soft shadow for legibility -->
    <DropShadowEffect x:Key="TextOnArt" ShadowDepth="1" BlurRadius="4" Opacity="0.95" Color="Black" />
    <!-- ═══════════════ Games module ═══════════════ -->

    <!-- Tab key along a detail page: lit underline when selected -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="wash" Opacity="0" CornerRadius="3,3,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="#402F7BFF" />
                                    <GradientStop Offset="1" Color="#002F7BFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="bar" Height="3" VerticalAlignment="Bottom" Margin="8,0" CornerRadius="1.5" Background="#7CC4FF" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#45D2FF" BlurRadius="8" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                            <Setter TargetName="wash" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="wash" Property="Opacity" Value="1" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status filter chip with a count plate -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="plate" CornerRadius="3" Background="{StaticResource Brush.Secondary}" BorderBrush="#06090E" BorderThickness="1" Padding="12,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="count" Margin="8,0,0,0" MinWidth="22" Height="18" CornerRadius="9" Background="#0A0E14" Padding="6,0">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Font.Display}" FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource Brush.Secondary.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource Brush.Nav.Selected}" />
                            <Setter TargetName="plate" Property="BorderBrush" Value="#5C9CFF" />
                            <Setter TargetName="count" Property="Background" Value="#40000000" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon segment of a view-mode switch -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="plate" Background="{StaticResource Brush.Secondary}" BorderBrush="#06090E" BorderThickness="1">
                        <ui:ArcadiaIcon x:Name="icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="15" Height="15" Foreground="{StaticResource Brush.Icon.Dim}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource Brush.Secondary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{StaticResource Brush.Nav.Selected}" />
                            <Setter TargetName="icon" Property="Foreground" Value="White" />
                            <Setter TargetName="icon" Property="AccentBrush" Value="#BFF0FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A library card: framed art over a caption; lifts and lights on hover -->
    <Style x:Key="GameCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="glow" CornerRadius="5" Background="#2F7BFF" Opacity="0" Margin="-1">
                            <Border.Effect>
                                <BlurEffect Radius="12" />
                            </Border.Effect>
                        </Border>
                        <Border Background="#05070A" CornerRadius="5" Padding="1">
                            <Border x:Name="frame" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="frame" Property="BorderBrush" Value="#4A78B8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="frame" Property="Background" Value="{StaticResource Brush.Sunken}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form label above a field -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caps}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#8FA3BF" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- Validation message under a field -->
    <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
        <Setter Property="Foreground" Value="#FF8A8E" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Multi-line text box -->
    <Style x:Key="TextArea" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Console readout cell (facts strip) -->
    <Style x:Key="Readout" TargetType="Border">
        <Setter Property="Background" Value="#0A0E15" />
        <Setter Property="BorderBrush" Value="#1C2738" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>
