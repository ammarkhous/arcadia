<UserControl x:Class="Arcadia.App.Views.Documents.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:dvm="clr-namespace:Arcadia.App.ViewModels.Documents"
             xmlns:docs="clr-namespace:Arcadia.Core.Documents;assembly=Arcadia.Core"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             mc:Ignorable="d"
             AllowDrop="True"
             d:DataContext="{d:DesignInstance dvm:DocumentsViewModel}">
    <UserControl.Resources>
        <!-- library rail entry -->
        <DataTemplate x:Key="RailItem" DataType="{x:Type dvm:LibraryItem}">
            <ui:ArcadiaNavigationItem Style="{StaticResource Tool.RailItem}" GroupName="DocRail" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                      AutomationProperties.Name="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" />
                    <TextBlock Grid.Column="1" ui:Bidi.Text="{Binding Label}" Margin="9,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" />
                </Grid>
            </ui:ArcadiaNavigationItem>
        </DataTemplate>

        <ContextMenu x:Key="DocMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Doc_Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Enter">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="External" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_OpenWith}" Command="{Binding OpenWithCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{l:Loc Doc_FavoriteToggle}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Star" Width="14" Height="14" Foreground="{StaticResource Brush.Gold}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_CopyPath}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_Reveal}" Command="{Binding RevealCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_Associate}" Command="{Binding AssociateCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Projects" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_Locate}" Command="{Binding LocateCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Search" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Doc_RemoveFromArcadia}" Command="{Binding RemoveCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Close" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="MetaLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,10,3" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title plate -->
        <Grid Margin="4,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:ArcadiaIcon Kind="Documents" Width="30" Height="30" />
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="{l:Loc Doc_Title}" Style="{StaticResource Text.Title}" FontSize="26" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ArcadiaButton Icon="Import" Content="{l:Loc Doc_AddFolder}" Command="{Binding AddFolderCommand}" MinHeight="36" Padding="14,6" Margin="0,0,8,0" />
                <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Doc_Add}" Command="{Binding AddDocumentsCommand}" MinHeight="36" Padding="16,6" ToolTip="Ctrl+N" />
            </StackPanel>
        </Grid>

        <!-- command bar -->
        <Border Grid.Row="1" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="440" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="32">
                        <TextBox x:Name="SearchBox" Padding="30,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ctl:Shortcuts.IsSearchBox="True" ui:Bidi.AutoDirection="True"
                                 AutomationProperties.Name="{l:Loc Doc_Search}" />
                        <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                        <TextBlock Text="{l:Loc Doc_Search}" Margin="31,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <ui:ArcadiaIcon Kind="Sort" Width="16" Height="16" Margin="0,0,6,0" Foreground="{StaticResource Brush.Icon.Dim}" />
                        <ComboBox Width="150" Height="30" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" AutomationProperties.Name="{l:Loc Doc_SortBy}" />
                        <ToggleButton Style="{StaticResource Tool.Chip}" Height="30" Margin="6,0,0,0" IsChecked="{Binding Descending}" ToolTip="{l:Loc Doc_Descending}" AutomationProperties.Name="{l:Loc Doc_Descending}">
                            <ui:ArcadiaIcon Kind="ChevronDown" Width="12" Height="12" />
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" />
                    <ui:ArcadiaButton Grid.Column="3" Style="{StaticResource Tool.Button}" Icon="Refresh" Content="{l:Loc Doc_CheckFiles}" Command="{Binding CheckAvailabilityCommand}" ToolTip="{l:Loc Doc_CheckFilesTip}" />
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding RailWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="{Binding DetailsWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Grid.ColumnDefinitions>

            <!-- ═══════ rail ═══════ -->
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="6,4,6,8">
                            <TextBlock Text="{l:Loc Doc_Library}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Views}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                            <TextBlock Text="{l:Loc Doc_Types}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Kinds}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                            <TextBlock Text="{l:Loc Doc_Tags}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,12,0,4" Visibility="{Binding TagItems.Count, Converter={StaticResource HasValue}}" />
                            <ItemsControl ItemsSource="{Binding TagItems}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />
                            <TextBlock Text="{l:Loc Doc_Projects}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,12,0,4" Visibility="{Binding ProjectItems.Count, Converter={StaticResource HasValue}}" />
                            <ItemsControl ItemsSource="{Binding ProjectItems}" ItemTemplate="{StaticResource RailItem}" Focusable="False" />

                            <TextBlock Text="{l:Loc Doc_Watched}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,14,0,4" />
                            <CheckBox Style="{StaticResource Tool.Check}" Content="{l:Loc Doc_WatchEnabled}" IsChecked="{Binding WatchEnabled}" Margin="10,2,0,6" ToolTip="{l:Loc Doc_WatchEnabledTip}" />
                            <ItemsControl ItemsSource="{Binding WatchedFolders}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dvm:WatchedFolderRow}">
                                        <Grid Margin="10,3,2,3" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:ArcadiaLed Width="7" Height="7" Tone="#34C76A" IsOn="{Binding IsEnabled}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0">
                                                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{l:Loc Doc_FolderUnavailable}" FontSize="10.5" Foreground="#FFC96B" Visibility="{Binding Error, Converter={StaticResource HasValue}}" />
                                            </StackPanel>
                                            <ui:ArcadiaButton Grid.Column="2" Variant="Tool" Icon="Stop" IconSize="11" Width="22" Height="22" ToolTip="{l:Loc Doc_PauseWatch}" AutomationProperties.Name="{l:Loc Doc_PauseWatch}"
                                                              Command="{Binding DataContext.ToggleWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <ui:ArcadiaButton Grid.Column="3" Variant="Tool" Icon="Close" IconSize="11" Width="22" Height="22" ToolTip="{l:Loc Doc_Unwatch}" AutomationProperties.Name="{l:Loc Doc_Unwatch}"
                                                              Command="{Binding DataContext.RemoveWatchedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Loc Doc_NoWatched}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="10,2,6,0" TextWrapping="Wrap"
                                       Visibility="{Binding WatchedFolders.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- ═══════ list ═══════ -->
            <Border Grid.Column="2" Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <DockPanel>
                            <ui:ArcadiaButton DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,6,0,8" Icon="ChevronDown" Content="{l:Loc Doc_LoadMore}" Command="{Binding LoadMoreCommand}"
                                              Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Doc_Title}"
                                      Tag="{Binding}" ContextMenu="{StaticResource DocMenu}" MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                                    <KeyBinding Key="Return" Command="{Binding OpenCommand}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:Loc Doc_Name}" Width="3*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type dvm:DocumentRowViewModel}">
                                                <!-- docked so long names trim instead of overflowing (also in right-to-left layouts) -->
                                                <DockPanel>
                                                    <ctl:FileIcon DockPanel.Dock="Left" Extension="{Binding Extension}" IsFolder="{Binding IsFolder}" />
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0,6,1" Background="#3A2A10" BorderBrush="#8A6420" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{l:Loc Doc_Missing}" FontSize="11" Foreground="#FFC96B" />
                                                    </Border>
                                                    <ui:ArcadiaIcon DockPanel.Dock="Right" Kind="Star" Width="11" Height="11" Margin="6,0,0,0" Foreground="{StaticResource Brush.Gold}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Text}" Margin="8,0,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:Loc Doc_Type}" Binding="{Binding TypeName}" Width="1.3*" ElementStyle="{StaticResource Cell.Dim}" />
                                    <DataGridTextColumn Header="{l:Loc Doc_Size}" Binding="{Binding SizeText}" SortMemberPath="SizeSort" Width="84" ElementStyle="{StaticResource Cell.Number}" />
                                    <DataGridTextColumn Header="{l:Loc Doc_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="ModifiedSort" Width="134" ElementStyle="{StaticResource Cell.Dim}" />
                                    <DataGridTextColumn Header="{l:Loc Doc_Tags}" Binding="{Binding Tags}" Width="*" ElementStyle="{StaticResource Cell.Dim}" />
                                    <DataGridTextColumn Header="{l:Loc Doc_Projects}" Binding="{Binding Projects}" Width="*" ElementStyle="{StaticResource Cell.Dim}" />
                                    <DataGridTextColumn Header="{l:Loc Doc_Location}" Binding="{Binding Folder}" Width="2*" ElementStyle="{StaticResource Cell.Path}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- empty library: an archive waiting to be filled -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="400" Height="180" Style="{StaticResource ArtworkWell}">
                                <ui:ModuleIllustration Icon="Documents" SecondaryIcon="Library" Tone="#F2A623" Seed="33" Glow="0.6" />
                            </Border>
                            <TextBlock Margin="0,18,0,0" Text="{l:Loc Doc_EmptyTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" Text="{l:Loc Doc_EmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:ArcadiaButton Icon="Import" Content="{l:Loc Doc_AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                                <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Doc_Add}" Command="{Binding AddDocumentsCommand}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Doc_EmptyHint}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}">
                            <ui:ArcadiaIcon Kind="Search" Width="32" Height="32" />
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Doc_NoMatches}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══════ details ═══════ -->
            <Border Grid.Column="4" Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="{Binding Details, Converter={StaticResource HasValue}}">
                            <StackPanel Margin="14,12,14,14" DataContext="{Binding Details}">
                                <!-- preview / big icon -->
                                <Border Style="{StaticResource ArtworkWell}" Height="170" Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVisibility}}">
                                    <ui:ArtworkPresenter ImagePath="{Binding ImagePreviewPath}" ShowScene="False" Stretch="Uniform" Vignette="0" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasImagePreview, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                    <Border Width="64" Height="64" CornerRadius="6" BorderBrush="#2A3A52" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#1C2940" />
                                                <GradientStop Offset="1" Color="#0B111B" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ctl:FileIcon Extension="{Binding Extension}" IsFolder="{Binding IsFolder}" Large="True" Width="36" Height="36" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeName}" Style="{StaticResource Text.Item}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Meta}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{l:Loc Doc_DisplayName}" Style="{StaticResource Tool.InputLabel}" Margin="0,12,0,3" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontSize="13.5" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Doc_DisplayName}"
                                         LostFocus="OnDetailsLostFocus" />
                                <TextBox Style="{StaticResource Tool.SelectableText}" Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}"
                                         Margin="0,6,0,0" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Doc_Location}" />

                                <!-- missing -->
                                <Border Margin="0,10,0,0" CornerRadius="4" BorderBrush="#8A6420" BorderThickness="1" Background="#2A1E0C" Padding="10,8" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaIcon Kind="Warning" Width="16" Height="16" Foreground="#F2A623" />
                                            <TextBlock Text="{l:Loc Doc_MissingTitle}" Style="{StaticResource Text.Item}" Foreground="#FFD58A" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Loc Doc_MissingBody}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <ui:ArcadiaButton HorizontalAlignment="Left" Variant="Primary" Icon="Search" Content="{l:Loc Doc_Locate}"
                                                          Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </Border>

                                <!-- actions -->
                                <WrapPanel Margin="0,10,0,0">
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Variant="Primary" Icon="External" Content="{l:Loc Doc_Open}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Library" Content="{l:Loc Doc_OpenWith}" Command="{Binding DataContext.OpenWithCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Documents" Content="{l:Loc Doc_Reveal}" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Copy" Content="{l:Loc Doc_CopyPath}" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Star" Content="{Binding IsFavorite, Converter={StaticResource Doc.FavLabel}}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Projects" Content="{l:Loc Doc_Associate}" Command="{Binding DataContext.AssociateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Margin="0,0,6,6" Icon="Close" Content="{l:Loc Doc_RemoveFromArcadia}" Foreground="#FFB0B3" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      ToolTip="{l:Loc Doc_RemoveTip}" />
                                </WrapPanel>
                                <!-- text / markdown preview (kept near the top so it is visible without scrolling) -->
                                <StackPanel Visibility="{Binding TextPreview, Converter={StaticResource HasValue}}" Margin="0,4,0,6">
                                    <TextBlock Text="{l:Loc Doc_Preview}" Style="{StaticResource Tool.InputLabel}" Margin="0,0,0,4" />
                                    <Border Style="{StaticResource Tool.Console}" MaxHeight="260">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding PreviewKind, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Text}">
                                                <TextBox Style="{StaticResource Tool.SelectableText}" Text="{Binding TextPreview, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="#B9D4F0" ui:Bidi.AutoDirection="True" />
                                            </ScrollViewer>
                                            <ctl:MarkdownView Markdown="{Binding TextPreview}" MaxHeight="240" Visibility="{Binding PreviewKind, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Markdown}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{l:Loc Doc_PreviewTruncated}" Style="{StaticResource Text.Meta}" Margin="0,4,0,0" Visibility="{Binding PreviewTruncated, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- projects -->
                                <TextBlock Text="{l:Loc Doc_Projects}" Style="{StaticResource Tool.InputLabel}" Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding Projects}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type docs:ProjectRef}">
                                            <Border Style="{StaticResource Chip}" Padding="4,1,2,2" BorderBrush="{Binding Accent, Converter={StaticResource It.Tone}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource ListRowButton}" Padding="4,0" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            ToolTip="{l:Loc Doc_OpenProject}">
                                                        <TextBlock ui:Bidi.Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                                    </Button>
                                                    <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="9" Width="18" Height="18" ToolTip="{l:Loc Proj_RemoveFromProject}" AutomationProperties.Name="{l:Loc Proj_RemoveFromProject}"
                                                                      Command="{Binding DataContext.DissociateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Doc_NoProject}" Style="{StaticResource Text.Meta}" Visibility="{Binding Projects.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />

                                <!-- tags -->
                                <TextBlock Text="{l:Loc Doc_Tags}" Style="{StaticResource Tool.InputLabel}" Margin="0,10,0,4" />
                                <ItemsControl ItemsSource="{Binding TagNames}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Padding="7,1,2,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock ui:Bidi.Text="{Binding}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                                    <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="9" Width="18" Height="18" Margin="3,0,0,0" ToolTip="{l:Loc Doc_RemoveTag}" AutomationProperties.Name="{l:Loc Doc_RemoveTag}"
                                                                      Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Doc_AddTag}">
                                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" /></TextBox.InputBindings>
                                    </TextBox>
                                    <ui:ArcadiaButton Grid.Column="1" Style="{StaticResource Tool.Button}" Icon="Plus" Content="{l:Loc Doc_AddTag}" Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>

                                <!-- description -->
                                <TextBlock Text="{l:Loc Doc_Description}" Style="{StaticResource Tool.InputLabel}" Margin="0,10,0,4" />
                                <TextBox Style="{StaticResource TextArea}" MinHeight="60" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True"
                                         AutomationProperties.Name="{l:Loc Doc_Description}" LostFocus="OnDetailsLostFocus" />

                                <!-- metadata -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="{l:Loc Doc_Type}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Style="{StaticResource MetaValue}" />
                                    <TextBlock Grid.Row="1" Text="{l:Loc Doc_Size}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource MetaValue}" />
                                    <TextBlock Grid.Row="2" Text="{l:Loc Doc_Created}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource MetaValue}" />
                                    <TextBlock Grid.Row="3" Text="{l:Loc Doc_Modified}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModifiedText}" Style="{StaticResource MetaValue}" />
                                    <TextBlock Grid.Row="4" Text="{l:Loc Doc_AddedToArcadia}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AddedText}" Style="{StaticResource MetaValue}" />
                                    <TextBlock Grid.Row="5" Text="{l:Loc Doc_LastOpened}" Style="{StaticResource MetaLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OpenedText}" Style="{StaticResource MetaValue}" />
                                </Grid>

                                <TextBlock Text="{l:Loc Doc_NoPreview}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding PreviewKind, Converter={StaticResource Ws.TabVisible}, ConverterParameter=None}" />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="{Binding Details, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Documents" Width="34" Height="34" />
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Doc_SelectHint}" Style="{StaticResource Text.Meta}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- drag & drop overlay -->
        <Border Grid.RowSpan="3" CornerRadius="6" BorderThickness="2" BorderBrush="#F2A623" Background="#C0060A10" IsHitTestVisible="False"
                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ArcadiaIcon Kind="Import" Width="44" Height="44" />
                <TextBlock Margin="0,12,0,0" Text="{l:Loc Doc_DropNow}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,6,0,0" Text="{l:Loc Ws_DropNowHint}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
