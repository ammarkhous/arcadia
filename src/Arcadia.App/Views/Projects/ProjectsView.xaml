<UserControl x:Class="Arcadia.App.Views.Projects.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:pvm="clr-namespace:Arcadia.App.ViewModels.Projects"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pvm:ProjectsViewModel}">

    <UserControl.Resources>
        <!-- Right-click menu for a project (card or row). DataContext = the page view model via Tag. -->
        <ContextMenu x:Key="ProjectMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Proj_Open}" Command="{Binding OpenCardCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="ArrowRight" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Proj_PinToggle}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Pin" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Proj_Edit}" Command="{Binding EditCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Journal" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Proj_ArchiveToggle}" Command="{Binding ArchiveCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Library" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Proj_DeletePermanently}" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Pinned project: a small "world" with its own scene and accent -->
        <DataTemplate x:Key="WorldCard" DataType="{x:Type pvm:ProjectCardViewModel}">
            <Button Style="{StaticResource GameCardButton}" Width="286" Margin="0,0,10,10"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource ProjectMenu}"
                    AutomationProperties.Name="{Binding Name}">
                <Grid Height="156" Margin="6">
                    <Border Style="{StaticResource ArtworkWell}">
                        <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" Vignette="0.35" BottomShade="0.9" />
                    </Border>
                    <Border Height="3" VerticalAlignment="Top" Margin="1,1,1,0" CornerRadius="2,2,0,0" Background="{Binding Accent, Converter={StaticResource It.Tone}}">
                        <Border.Effect><DropShadowEffect Color="{Binding Accent, Converter={StaticResource It.Tone}}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" /></Border.Effect>
                    </Border>
                    <ui:ArcadiaStatusIndicator Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource It.Tone}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" MinWidth="0" Height="20" />
                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="4" Background="#A0060A10" BorderBrush="{Binding Accent, Converter={StaticResource It.Tone}}" BorderThickness="1">
                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" />
                            </Border>
                            <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.OnArt}" FontFamily="{StaticResource Font.Display}" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="210" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:ArcadiaProgressBar Height="6" Value="{Binding Progress}" Tone="{Binding Accent, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Text.Numeric}" FontSize="12" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Meta}" Foreground="#C8D4E4">
                            <Run Text="{Binding TasksText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DueText, Mode=OneWay}" Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Dense project row -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type pvm:ProjectCardViewModel}">
            <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1">
                <Button Style="{StaticResource ListRowButton}" Padding="0,6,8,6"
                        Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource ProjectMenu}"
                        AutomationProperties.Name="{Binding Name}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="2" Background="{Binding Accent, Converter={StaticResource It.Tone}}" Margin="0,2" />
                        <Border Grid.Column="1" Width="32" Height="32" Margin="10,0,10,0" CornerRadius="4" BorderThickness="1" BorderBrush="#2A3A52">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#1C2940" />
                                    <GradientStop Offset="1" Color="#0B111B" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Item}" TextTrimming="CharacterEllipsis" />
                                <ui:ArcadiaIcon Kind="Pin" Width="12" Height="12" Margin="7,0,0,0" Foreground="{StaticResource Brush.Gold}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock ui:Bidi.Text="{Binding Description}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                        </StackPanel>
                        <ui:ArcadiaStatusIndicator Grid.Column="3" Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource It.Tone}}" HorizontalAlignment="Left" MinWidth="0" Height="20" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ArcadiaLed Width="7" Height="7" Tone="{Binding PriorityTone, Converter={StaticResource It.Tone}}" />
                            <TextBlock Text="{Binding PriorityText}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="5" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <ui:ArcadiaProgressBar Height="6" Value="{Binding Progress}" Tone="{Binding Accent, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Text.Numeric}" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Grid.Column="6" Text="{Binding TasksText}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="7" Text="{Binding DueText}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" />
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>

        <!-- Small project link rows for the side panels -->
        <DataTemplate x:Key="MiniProject" DataType="{x:Type pvm:ProjectCardViewModel}">
            <Button Style="{StaticResource ListRowButton}" Padding="6,5"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource ProjectMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="22" CornerRadius="1.5" Background="{Binding Accent, Converter={StaticResource It.Tone}}" />
                    <ui:ArcadiaIcon Grid.Column="1" Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Margin="9,0,0,0" />
                    <TextBlock Grid.Column="1" ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="33,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource Text.Numeric}" FontSize="11.5" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════ HOME ═══════════════ -->
        <Grid x:Name="Home">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="4,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:ArcadiaIcon Kind="Projects" Width="30" Height="30" />
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{l:Loc Proj_Title}" Style="{StaticResource Text.Title}" FontSize="26" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="280" Height="34" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox" Padding="30,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}" ctl:Shortcuts.IsSearchBox="True"
                                 AutomationProperties.Name="{l:Loc Proj_Search}" ui:Bidi.AutoDirection="True" />
                        <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                        <TextBlock Text="{l:Loc Proj_Search}" Margin="31,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </Grid>
                    <ui:ArcadiaButton Variant="Primary" Icon="Plus" Content="{l:Loc Proj_New}" Command="{Binding NewProjectCommand}" MinHeight="36" Padding="16,6" ToolTip="{l:Loc Proj_NewTip}" />
                </StackPanel>
            </Grid>

            <!-- stats strip -->
            <Border Grid.Row="1" Style="{StaticResource Tool.CommandBar}" Visibility="{Binding IsEmpty, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                <Border Style="{StaticResource Tool.CommandBarInner}" Padding="0,7">
                    <ItemsControl ItemsSource="{Binding Stats}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pvm:StatTile}">
                                <Grid AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Value}">
                                    <Border Width="1" HorizontalAlignment="Left" Margin="0,2" Background="#1E2A3C" />
                                    <StackPanel Margin="14,0,8,0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Display}" FontSize="24" Foreground="{Binding Tone, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="13" Height="13" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Icon.Dim}" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#7F93AE" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Border>

            <!-- empty environment -->
            <Grid Grid.Row="2" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <Border Width="440" Height="200" Style="{StaticResource ArtworkWell}">
                        <ui:ModuleIllustration Icon="Projects" SecondaryIcon="Tasks" Tone="#45D2FF" Seed="21" Glow="0.7" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" Text="{l:Loc Proj_EmptyTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,8,0,0" Text="{l:Loc Proj_EmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                    <ui:ArcadiaButton Margin="0,16,0,0" HorizontalAlignment="Center" Variant="Primary" Icon="Plus" Content="{l:Loc Proj_New}" Command="{Binding NewProjectCommand}" MinHeight="36" Padding="18,6" />
                    <TextBlock Margin="0,10,0,0" Text="{l:Loc Proj_EmptyHint}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding IsEmpty, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="{Binding SideWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <!-- pinned worlds -->
                        <StackPanel Visibility="{Binding Pinned.Count, Converter={StaticResource HasValue}}">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <ui:ArcadiaIcon Kind="Pin" Width="14" Height="14" Foreground="{StaticResource Brush.Gold}" />
                                <TextBlock Text="{l:Loc Proj_Pinned}" Style="{StaticResource Text.Caps}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Pinned}" ItemTemplate="{StaticResource WorldCard}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- filters -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="2,0,14,0" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Filters}" Focusable="False" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pvm:ProjectFilter}">
                                        <ui:ArcadiaChoice Style="{StaticResource FilterChip}" GroupName="ProjectFilter" Content="{Binding Label}" Tag="{Binding Count}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- the list -->
                        <Border Style="{StaticResource Tool.TableFrame}">
                            <Border Style="{StaticResource Tool.TableInner}" Padding="6,2,6,4">
                                <Grid>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
                                        <ui:ArcadiaButton HorizontalAlignment="Center" Margin="0,8,0,4" Icon="ChevronDown" Content="{Binding MoreProjectsText}" Command="{Binding ShowAllProjectsCommand}"
                                                          Visibility="{Binding MoreProjectsText, Converter={StaticResource HasValue}}" />
                                    </StackPanel>
                                    <TextBlock Text="{l:Loc Proj_NoMatches}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,24"
                                               Visibility="{Binding Projects.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- content matches while searching -->
                        <ui:ArcadiaPanel Header="{l:Loc Proj_ContentMatches}" Icon="Search" Margin="0,10,0,0" Visibility="{Binding ContentHits.Count, Converter={StaticResource HasValue}}">
                            <ItemsControl ItemsSource="{Binding ContentHits}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type pvm:ProjectSearchHit}">
                                        <Button Style="{StaticResource ListRowButton}" Padding="6,5" Command="{Binding DataContext.OpenHitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                    <TextBlock ui:Bidi.Text="{Binding Result.Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock ui:Bidi.Text="{Binding Result.Snippet}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Visibility="{Binding Result.Snippet, Converter={StaticResource HasValue}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock ui:Bidi.Text="{Binding ProjectName}" Style="{StaticResource Text.Meta}" Margin="0,0,10,0" />
                                                    <Border Style="{StaticResource Chip}" Margin="0"><TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:ArcadiaPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- side column -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <ui:ArcadiaPanel Header="{l:Loc Proj_Deadlines}" Icon="Calendar" Margin="0,0,0,10">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Deadlines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pvm:DeadlineRow}">
                                            <Button Style="{StaticResource ListRowButton}" Padding="6,5" Command="{Binding DataContext.OpenDeadlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3" CornerRadius="1.5" Background="{Binding Accent, Converter={StaticResource It.Tone}}" />
                                                    <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{StaticResource Brush.Icon.Dim}" />
                                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Body}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock ui:Bidi.Text="{Binding ProjectName}" Style="{StaticResource Text.Meta}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DueText}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right" Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" />
                                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Meta}" FontSize="11" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Proj_NoDeadlines}" Style="{StaticResource Text.Meta}" Margin="6,4" Visibility="{Binding Deadlines.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </Grid>
                        </ui:ArcadiaPanel>
                        <ui:ArcadiaPanel Header="{l:Loc Proj_RecentlyOpened}" Icon="Clock" Margin="0,0,0,10" Visibility="{Binding RecentlyOpened.Count, Converter={StaticResource HasValue}}">
                            <ItemsControl ItemsSource="{Binding RecentlyOpened}" ItemTemplate="{StaticResource MiniProject}" Focusable="False" />
                        </ui:ArcadiaPanel>
                        <ui:ArcadiaPanel Header="{l:Loc Proj_RecentlyUpdated}" Icon="Refresh">
                            <ItemsControl ItemsSource="{Binding RecentlyUpdated}" ItemTemplate="{StaticResource MiniProject}" Focusable="False" />
                        </ui:ArcadiaPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══════════════ WORKSPACE ═══════════════ -->
        <Border Background="{StaticResource Brush.Window}" Visibility="{Binding Workspace, Converter={StaticResource HasValue}}">
            <ui:TransitioningContentControl Content="{Binding Workspace}" />
        </Border>
    </Grid>
</UserControl>
