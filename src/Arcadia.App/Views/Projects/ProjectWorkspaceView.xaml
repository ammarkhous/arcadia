<UserControl x:Class="Arcadia.App.Views.Projects.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:pvm="clr-namespace:Arcadia.App.ViewModels.Projects"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             mc:Ignorable="d"
             AllowDrop="True"
             d:DataContext="{d:DesignInstance pvm:ProjectWorkspaceViewModel}">
    <UserControl.Resources>
        <!-- workspace tab: TabButton look, runs ShowTab also when selected by keyboard/UI Automation -->
        <Style x:Key="WsTab" TargetType="ui:ArcadiaChoice" BasedOn="{StaticResource TabButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Arcadia.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="sel" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#553F8CFF" />
                                            <GradientStop Offset="1" Color="#103F8CFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="hover" Opacity="0" Background="#0F2F6BD9" />
                                <Border x:Name="edge" Width="2" HorizontalAlignment="Left" Background="{StaticResource Brush.Cyan}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="Opacity" Value="1" />
                                <Setter TargetName="edge" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        </Style>

        <!-- task menu (row = DataContext of the placement target) -->
        <ContextMenu x:Key="TaskMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Task_Edit}" Command="{Binding EditTaskCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Enter">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Journal" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Task_ToggleDone}" Command="{Binding ToggleTaskCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Check" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Task_AddSubtask}" Command="{Binding NewTaskCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Plus" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Task_SetStatus}">
                <MenuItem Header="{l:Loc TaskStatus_ToDo}" Command="{Binding SetTaskStatusCommand}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Ws.Pair}"><Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" /><Binding Source="ToDo" /></MultiBinding></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:Loc TaskStatus_InProgress}" Command="{Binding SetTaskStatusCommand}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Ws.Pair}"><Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" /><Binding Source="InProgress" /></MultiBinding></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:Loc TaskStatus_Blocked}" Command="{Binding SetTaskStatusCommand}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Ws.Pair}"><Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" /><Binding Source="Blocked" /></MultiBinding></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:Loc TaskStatus_Completed}" Command="{Binding SetTaskStatusCommand}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Ws.Pair}"><Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" /><Binding Source="Completed" /></MultiBinding></MenuItem.CommandParameter>
                </MenuItem>
                <MenuItem Header="{l:Loc TaskStatus_Cancelled}" Command="{Binding SetTaskStatusCommand}">
                    <MenuItem.CommandParameter><MultiBinding Converter="{StaticResource Ws.Pair}"><Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" /><Binding Source="Cancelled" /></MultiBinding></MenuItem.CommandParameter>
                </MenuItem>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Proj_Delete}" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="FileMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Doc_Open}" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Enter">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="External" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_OpenWith}" Command="{Binding OpenFileWithCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{l:Loc Doc_Reveal}" Command="{Binding RevealFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_CopyPath}" Command="{Binding CopyFilePathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Doc_Locate}" Command="{Binding LocateFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Search" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Proj_PinToggle}" Command="{Binding ToggleFilePinCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Pin" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Proj_RemoveFromProject}" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Close" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="LinkMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{l:Loc Link_Open}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="External" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Link_Copy}" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Link_Edit}" Command="{Binding EditLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Journal" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Proj_PinToggle}" Command="{Binding ToggleLinkPinCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Pin" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Proj_Delete}" Command="{Binding DeleteLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- rows reused by the overview -->
        <DataTemplate x:Key="TaskRowTemplate" DataType="{x:Type pvm:TaskRowViewModel}">
            <Grid Margin="0,4" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource TaskMenu}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- subtask indent with a connector -->
                <Border Width="26" Visibility="{Binding IsSubtask, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="1" Margin="10,-6,0,10" HorizontalAlignment="Left" Background="#2A3A52" />
                </Border>
                <CheckBox Grid.Column="1" Style="{StaticResource Tool.Check}" Margin="8,0,10,0" IsChecked="{Binding IsDone, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title}" ToolTip="{l:Loc Task_ToggleDone}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="title" ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0,6,1" Visibility="{Binding SubtaskText, Converter={StaticResource HasValue}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:ArcadiaIcon Kind="Tasks" Width="10" Height="10" Foreground="{StaticResource Brush.Icon.Dim}" />
                                <TextBlock Text="{Binding SubtaskText}" FontSize="11" Margin="4,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="6,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><Border Style="{StaticResource Chip}" Margin="0,0,4,0" Padding="6,0,6,1"><TextBlock ui:Bidi.Text="{Binding}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" /></Border></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock ui:Bidi.Text="{Binding Detail}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Visibility="{Binding Detail, Converter={StaticResource HasValue}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding ShowPriority, Converter={StaticResource BoolToVisibility}}">
                        <ui:ArcadiaLed Width="7" Height="7" Tone="{Binding PriorityTone, Converter={StaticResource It.Tone}}" />
                        <TextBlock Text="{Binding PriorityText}" Style="{StaticResource Text.Meta}" Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding DueText}" Style="{StaticResource Text.Meta}" Margin="0,0,12,0" Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" Visibility="{Binding DueText, Converter={StaticResource HasValue}}" />
                    <ui:ArcadiaStatusIndicator Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource It.Tone}}" MinWidth="0" Height="19" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LinkRowTemplate" DataType="{x:Type pvm:LinkRowViewModel}">
            <Grid Margin="4,6" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ContextMenu="{StaticResource LinkMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ArcadiaIcon Kind="External" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                        <ui:ArcadiaIcon Kind="Pin" Width="12" Height="12" Margin="7,0,0,0" Foreground="{StaticResource Brush.Gold}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Url}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="#7CC4FF" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock ui:Bidi.Text="{Binding Description}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:ArcadiaButton Variant="Tool" Icon="External" Width="28" Height="28" ToolTip="{l:Loc Link_Open}" AutomationProperties.Name="{l:Loc Link_Open}"
                                      Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <ui:ArcadiaButton Variant="Tool" Icon="Copy" Width="28" Height="28" ToolTip="{l:Loc Link_Copy}" AutomationProperties.Name="{l:Loc Link_Copy}"
                                      Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActivityRowTemplate" DataType="{x:Type pvm:ActivityRowViewModel}">
            <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="26">
                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" HorizontalAlignment="Left" />
                    <ui:ArcadiaLed Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Tone="{Binding Tone, Converter={StaticResource It.Tone}}" />
                </Grid>
                <TextBlock Grid.Column="1" ui:Bidi.Text="{Binding Text}" Style="{StaticResource Text.Body}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileMiniTemplate" DataType="{x:Type pvm:FileRowViewModel}">
            <Button Style="{StaticResource ListRowButton}" Padding="6,4" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:FileIcon Extension="{Binding Extension}" IsFolder="{Binding IsFolder}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="8,0" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Text.Meta}" Visibility="{Binding IsMissing, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    <TextBlock Grid.Column="2" Text="{l:Loc Doc_Missing}" Style="{StaticResource Text.Meta}" Foreground="#FFC96B" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="NoteMiniTemplate" DataType="{x:Type pvm:NoteItemViewModel}">
            <Button Style="{StaticResource ListRowButton}" Padding="6,4" Command="{Binding DataContext.OpenPinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ArcadiaIcon Kind="Notes" Width="15" Height="15" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock ui:Bidi.Text="{Binding Preview}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Style="{StaticResource Text.Meta}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- pinned strip: notes, files and links look distinct -->
        <DataTemplate DataType="{x:Type pvm:NoteItemViewModel}" x:Key="PinnedNote"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoteMiniTemplate}" Focusable="False" /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ header banner: the project's world ═══════════ -->
        <Border CornerRadius="5" Padding="1" Background="#05070A" Margin="0,0,0,8">
            <Grid Height="{Binding BannerHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True">
                <Border CornerRadius="4" ClipToBounds="True">
                    <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" Vignette="0.45" BottomShade="0.95" CornerRadius="4" />
                </Border>
                <Border CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#E6060A10" />
                            <GradientStop Offset="0.55" Color="#80060A10" />
                            <GradientStop Offset="1" Color="#10060A10" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Height="2" VerticalAlignment="Bottom" Background="{Binding Accent, Converter={StaticResource It.Tone}}">
                    <Border.Effect><DropShadowEffect Color="{Binding Accent, Converter={StaticResource It.Tone}}" BlurRadius="14" ShadowDepth="0" Opacity="1" /></Border.Effect>
                </Border>

                <Grid Margin="16,12,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ArcadiaButton Variant="Link" Icon="ChevronLeft" Content="{l:Loc Proj_Back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Foreground="#C8D4E4" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Pin" Content="{Binding IsPinned, Converter={StaticResource Ws.PinLabel}}" Command="{Binding TogglePinCommand}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Documents" Content="{l:Loc Proj_OpenFolder}" Command="{Binding OpenFolderCommand}"
                                              Visibility="{Binding FolderPath, Converter={StaticResource HasValue}}" ToolTip="{Binding FolderPath}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Journal" Content="{l:Loc Proj_Edit}" Command="{Binding EditCommand}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Library" Content="{Binding IsArchived, Converter={StaticResource Ws.ArchiveLabel}}" Command="{Binding ArchiveCommand}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Tool" Icon="Trash" Width="30" Height="30" Command="{Binding DeleteProjectCommand}"
                                              ToolTip="{l:Loc Proj_DeletePermanently}" AutomationProperties.Name="{l:Loc Proj_DeletePermanently}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Border Width="58" Height="58" CornerRadius="6" Background="#B0060A10" BorderBrush="{Binding Accent, Converter={StaticResource It.Tone}}" BorderThickness="1.5">
                            <Border.Effect><DropShadowEffect Color="{Binding Accent, Converter={StaticResource It.Tone}}" BlurRadius="16" ShadowDepth="0" Opacity="0.55" /></Border.Effect>
                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="34" Height="34" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.OnArt}" FontFamily="{StaticResource Font.Display}" FontSize="28" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox Width="140" Height="26" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" AutomationProperties.Name="{l:Loc Proj_Status}" ToolTip="{l:Loc Proj_Status}" />
                                <ComboBox Width="150" Height="26" Margin="6,0,0,0" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}" AutomationProperties.Name="{l:Loc Proj_Priority}" ToolTip="{l:Loc Proj_Priority}" />
                                <ui:ArcadiaIcon Kind="Calendar" Width="14" Height="14" Margin="14,0,6,0" Foreground="#C8D4E4" />
                                <TextBlock Text="{Binding DatesText}" Style="{StaticResource Text.OnArt}" FontSize="12.5" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="#C0060A10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DueText}" FontSize="12" Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" MaxWidth="560" HorizontalAlignment="Left" Margin="74,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ArcadiaProgressBar Width="440" Height="8" Value="{Binding Progress}" Tone="{Binding Accent, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Text.OnArt}" FontFamily="{StaticResource Font.Display}" FontSize="14" Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ tabs ═══════════ -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Overview}" AutomationProperties.Name="{l:Loc Ws_Overview}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Overview, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="ViewGrid" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Overview}" Margin="8,0,0,0" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Tasks}" AutomationProperties.Name="{l:Loc Ws_Tasks}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Tasks, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Tasks" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Tasks}" Margin="8,0,0,0" /><TextBlock Text="{Binding OpenTasks}" Margin="6,0,0,0" Foreground="{StaticResource Brush.Text.Muted}" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Notes}" AutomationProperties.Name="{l:Loc Ws_Notes}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Notes, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Notes" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Notes}" Margin="8,0,0,0" /><TextBlock Text="{Binding Notes.Items.Count}" Margin="6,0,0,0" Foreground="{StaticResource Brush.Text.Muted}" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Files}" AutomationProperties.Name="{l:Loc Ws_Files}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Files, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Documents" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Files}" Margin="8,0,0,0" /><TextBlock Text="{Binding Files.Count}" Margin="6,0,0,0" Foreground="{StaticResource Brush.Text.Muted}" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Links}" AutomationProperties.Name="{l:Loc Ws_Links}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Links, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="External" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Links}" Margin="8,0,0,0" /><TextBlock Text="{Binding Links.Count}" Margin="6,0,0,0" Foreground="{StaticResource Brush.Text.Muted}" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Activity}" AutomationProperties.Name="{l:Loc Ws_Activity}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Activity, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Clock" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Activity}" Margin="8,0,0,0" /></StackPanel>
                </ui:ArcadiaChoice>
                <ui:ArcadiaChoice Style="{StaticResource WsTab}" GroupName="WsTabs" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Expenses}" AutomationProperties.Name="{l:Loc Ws_Expenses}"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Ws.Equals}, ConverterParameter=Expenses, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Receipt" Width="15" Height="15" /><TextBlock Text="{l:Loc Ws_Expenses}" Margin="8,0,0,0" /></StackPanel>
                </ui:ArcadiaChoice>
            </StackPanel>
        </Border>

        <!-- ═══════════ OVERVIEW ═══════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Overview}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:ArcadiaPanel Header="{l:Loc Ws_Description}" Icon="Journal" Margin="0,0,0,10">
                        <ui:ArcadiaPanel.HeaderAction>
                            <TextBlock Text="{Binding DescriptionState}" Style="{StaticResource Text.Meta}" />
                        </ui:ArcadiaPanel.HeaderAction>
                        <TextBox Style="{StaticResource TextArea}" MinHeight="84" MaxHeight="220" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True"
                                 AutomationProperties.Name="{l:Loc Ws_Description}" />
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_TaskSummary}" Icon="Tasks" Margin="0,0,0,10">
                        <ui:ArcadiaPanel.HeaderAction>
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Ws_AllTasks}" Command="{Binding ShowTabCommand}" CommandParameter="{x:Static pvm:WorkspaceTab.Tasks}" />
                        </ui:ArcadiaPanel.HeaderAction>
                        <StackPanel>
                            <UniformGrid Rows="1" Margin="0,0,0,8">
                                <StackPanel><TextBlock Text="{Binding OpenTasks}" Style="{StaticResource Tool.ReadoutValue}" Foreground="#9FE6FF" /><TextBlock Text="{l:Loc Ws_Open}" Style="{StaticResource Tool.InputLabel}" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding DoneTasks}" Style="{StaticResource Tool.ReadoutValue}" Foreground="#9FF0B8" /><TextBlock Text="{l:Loc Ws_Done}" Style="{StaticResource Tool.InputLabel}" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding BlockedTasks}" Style="{StaticResource Tool.ReadoutValue}" Foreground="#FF9A9E" /><TextBlock Text="{l:Loc Ws_Blocked}" Style="{StaticResource Tool.InputLabel}" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding OverdueTasks}" Style="{StaticResource Tool.ReadoutValue}" Foreground="#FFC96B" /><TextBlock Text="{l:Loc Ws_Overdue}" Style="{StaticResource Tool.InputLabel}" /></StackPanel>
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding NextTasks}" ItemTemplate="{StaticResource TaskRowTemplate}" Focusable="False" />
                            <TextBlock Text="{l:Loc Ws_NoOpenTasks}" Style="{StaticResource Text.Meta}" Visibility="{Binding NextTasks.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_RecentNotes}" Icon="Notes" Margin="0,0,0,10">
                        <ui:ArcadiaPanel.HeaderAction>
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Ws_NewNote}" Command="{Binding Notes.NewCommand}" />
                        </ui:ArcadiaPanel.HeaderAction>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding RecentNotes}" ItemTemplate="{StaticResource NoteMiniTemplate}" Focusable="False" />
                            <TextBlock Text="{l:Loc Ws_NoNotes}" Style="{StaticResource Text.Meta}" Visibility="{Binding RecentNotes.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_RecentActivity}" Icon="Clock">
                        <ItemsControl ItemsSource="{Binding RecentActivity}" ItemTemplate="{StaticResource ActivityRowTemplate}" Focusable="False" />
                    </ui:ArcadiaPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:ArcadiaPanel Header="{l:Loc Ws_Progress}" Icon="Trophy" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource Font.Display}" FontSize="34" Foreground="{Binding Accent, Converter={StaticResource It.Tone}}" />
                                <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="200" />
                            </StackPanel>
                            <ui:ArcadiaProgressBar Height="8" Margin="0,6,0,10" Value="{Binding Progress}" Tone="{Binding Accent, Converter={StaticResource It.Tone}}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="ProgressMode" Content="{l:Loc Ws_ProgressManual}" IsChecked="{Binding TaskBased, Converter={StaticResource InverseBool}}" />
                                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="ProgressMode" Content="{l:Loc Ws_ProgressTasks}" IsChecked="{Binding TaskBased}" />
                            </StackPanel>
                            <Slider Margin="0,10,0,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding ManualProgress}"
                                    Visibility="{Binding TaskBased, Converter={StaticResource HasValue}, ConverterParameter=invert}" AutomationProperties.Name="{l:Loc Ws_ProgressManual}" />
                        </StackPanel>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_Details}" Icon="Info" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Proj_Dates}" Style="{StaticResource Text.Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding DatesText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Primary}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Proj_Remaining}" Style="{StaticResource Text.Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding DueText}" Style="{StaticResource Text.Body}" Foreground="{Binding DueTone, Converter={StaticResource It.Tone}}" />
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource Text.Label}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><Border Style="{StaticResource Chip}"><TextBlock ui:Bidi.Text="{Binding}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" /></Border></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid Margin="0,4" Visibility="{Binding FolderPath, Converter={StaticResource HasValue}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Proj_Folder}" Style="{StaticResource Text.Label}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FolderPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding FolderAvailable, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                        <ui:ArcadiaIcon Kind="Warning" Width="12" Height="12" Foreground="#F2A623" />
                                        <TextBlock Text="{l:Loc Proj_FolderMissing}" Style="{StaticResource Text.Meta}" Foreground="#FFC96B" Margin="5,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_Pinned}" Icon="Pin" Margin="0,0,0,10" Visibility="{Binding PinnedItems.Count, Converter={StaticResource HasValue}}">
                        <ItemsControl ItemsSource="{Binding PinnedItems}" Focusable="False">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type pvm:NoteItemViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource NoteMiniTemplate}" Focusable="False" /></DataTemplate>
                                <DataTemplate DataType="{x:Type pvm:FileRowViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FileMiniTemplate}" Focusable="False" /></DataTemplate>
                                <DataTemplate DataType="{x:Type pvm:LinkRowViewModel}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource LinkRowTemplate}" Focusable="False" /></DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_ImportantLinks}" Icon="External" Margin="0,0,0,10">
                        <ui:ArcadiaPanel.HeaderAction>
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Link_AddShort}" Command="{Binding AddLinkCommand}" />
                        </ui:ArcadiaPanel.HeaderAction>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding ImportantLinks}" ItemTemplate="{StaticResource LinkRowTemplate}" Focusable="False" />
                            <TextBlock Text="{l:Loc Ws_NoLinks}" Style="{StaticResource Text.Meta}" Visibility="{Binding ImportantLinks.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                    </ui:ArcadiaPanel>

                    <ui:ArcadiaPanel Header="{l:Loc Ws_RecentFiles}" Icon="Documents">
                        <ui:ArcadiaPanel.HeaderAction>
                            <ui:ArcadiaButton Variant="Link" Content="{l:Loc Ws_AddFiles}" Command="{Binding AddFilesCommand}" />
                        </ui:ArcadiaPanel.HeaderAction>
                        <Grid>
                            <ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource FileMiniTemplate}" Focusable="False" />
                            <TextBlock Text="{l:Loc Ws_NoFiles}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Visibility="{Binding RecentFiles.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                    </ui:ArcadiaPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════ TASKS ═══════════ -->
        <DockPanel Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Tasks}">
            <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
                <Border Style="{StaticResource Tool.CommandBarInner}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="32" Margin="0,0,12,0">
                            <TextBox x:Name="QuickAdd" Padding="30,0,8,0" Text="{Binding QuickTask, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Task_QuickAdd}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding QuickAddCommand}" /></TextBox.InputBindings>
                            </TextBox>
                            <ui:ArcadiaIcon Kind="Plus" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Accent}" />
                            <TextBlock Text="{l:Loc Task_QuickAdd}" Margin="31,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=QuickAdd, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="TaskFilter" Height="30" Content="{l:Loc Task_FilterOpen}" Command="{Binding SetTaskFilterCommand}" CommandParameter="open"
                                              IsChecked="{Binding TaskFilter, Converter={StaticResource Ws.Equals}, ConverterParameter=open, Mode=OneWay}" />
                            <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="TaskFilter" Height="30" Content="{l:Loc Task_FilterAll}" Command="{Binding SetTaskFilterCommand}" CommandParameter="all"
                                              IsChecked="{Binding TaskFilter, Converter={StaticResource Ws.Equals}, ConverterParameter=all, Mode=OneWay}" />
                            <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="TaskFilter" Height="30" Content="{l:Loc Task_FilterDone}" Command="{Binding SetTaskFilterCommand}" CommandParameter="done"
                                              IsChecked="{Binding TaskFilter, Converter={StaticResource Ws.Equals}, ConverterParameter=done, Mode=OneWay}" />
                            <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="TaskFilter" Height="30" Content="{l:Loc Task_FilterBlocked}" Command="{Binding SetTaskFilterCommand}" CommandParameter="blocked"
                                              IsChecked="{Binding TaskFilter, Converter={StaticResource Ws.Equals}, ConverterParameter=blocked, Mode=OneWay}" />
                            <Grid Width="170" Height="30" Margin="8,0,0,0">
                                <TextBox x:Name="TaskSearch" Padding="28,0,8,0" Text="{Binding TaskSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" ctl:Shortcuts.IsSearchBox="True" AutomationProperties.Name="{l:Loc Task_Search}" />
                                <ui:ArcadiaIcon Kind="Search" Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                                <TextBlock Text="{l:Loc Task_Search}" Margin="29,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=TaskSearch, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </Grid>
                            <ComboBox Width="130" Height="30" Margin="8,0,0,0" ItemsSource="{Binding TaskSorts}" SelectedItem="{Binding TaskSort}" AutomationProperties.Name="{l:Loc Task_Sort}" ToolTip="{l:Loc Task_Sort}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Primary" Icon="Plus" Content="{l:Loc Task_New}" Command="{Binding NewTaskCommand}" ToolTip="Ctrl+N" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}" Padding="4,2">
                    <Grid>
                        <ListBox x:Name="TaskList" Style="{StaticResource PlainList}" ItemsSource="{Binding TaskRows}" SelectedItem="{Binding SelectedTask}" ItemTemplate="{StaticResource TaskRowTemplate}"
                                 AutomationProperties.Name="{l:Loc Ws_Tasks}">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteTaskCommand}" />
                                <KeyBinding Key="Return" Command="{Binding EditTaskCommand}" />
                                <KeyBinding Key="Space" Command="{Binding ToggleTaskCommand}" CommandParameter="{Binding SelectedTask}" />
                            </ListBox.InputBindings>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TaskRows.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Tasks" Width="34" Height="34" />
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Ws_NoTasksHere}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,4,0,0" Text="{l:Loc Ws_TasksHint}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DockPanel>

        <!-- ═══════════ NOTES ═══════════ -->
        <Grid Grid.Row="2" Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Notes}" DataContext="{Binding Notes}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="30">
                                <TextBox x:Name="NoteFilter" Padding="28,0,8,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" ctl:Shortcuts.IsSearchBox="True" AutomationProperties.Name="{l:Loc Note_Search}" />
                                <ui:ArcadiaIcon Kind="Search" Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                                <TextBlock Text="{l:Loc Note_Search}" Margin="29,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=NoteFilter, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </Grid>
                            <ui:ArcadiaButton Grid.Column="1" Style="{StaticResource Tool.Button}" Variant="Primary" Icon="Plus" Content="{l:Loc Note_New}" Command="{Binding NewCommand}" ToolTip="Ctrl+N" />
                        </Grid>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Ws_Notes}">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type pvm:NoteItemViewModel}">
                                    <Grid Margin="8,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock ui:Bidi.Text="{Binding Preview}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Meta}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                        <ui:ArcadiaIcon Grid.Column="1" Kind="Pin" Width="12" Height="12" VerticalAlignment="Top" Foreground="{StaticResource Brush.Gold}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <DockPanel Margin="14,10,14,12" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Display}" FontSize="19" MinHeight="36" ui:Bidi.AutoDirection="True"
                                         AutomationProperties.Name="{l:Loc Note_Title}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="NoteMode" Height="30" Content="{l:Loc Note_Edit}" Command="{Binding TogglePreviewCommand}"
                                                      IsChecked="{Binding IsPreview, Converter={StaticResource InverseBool}, Mode=OneWay}" />
                                    <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="NoteMode" Height="30" Content="{l:Loc Note_Preview}" Command="{Binding TogglePreviewCommand}"
                                                      IsChecked="{Binding IsPreview, Mode=OneWay}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Tool" Icon="Pin" Width="30" Height="30" Command="{Binding TogglePinCommand}" ToolTip="{l:Loc Proj_PinToggle}" AutomationProperties.Name="{l:Loc Proj_PinToggle}" />
                                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Tool" Icon="Trash" Width="30" Height="30" Command="{Binding DeleteCommand}" ToolTip="{l:Loc Proj_Delete}" AutomationProperties.Name="{l:Loc Note_Delete}" />
                                </StackPanel>
                            </Grid>
                            <Grid DockPanel.Dock="Top" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource Tool.InputLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" AutomationProperties.Name="{l:Loc Proj_Tags}" ui:Bidi.AutoDirection="True" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ui:ArcadiaLed x:Name="SaveLed" Width="8" Height="8" Tone="#34C76A" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" MinWidth="90" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Note_MarkdownHint}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" FontSize="11" />
                            <Grid>
                                <TextBox x:Name="NoteText" Style="{StaticResource TextArea}" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsTab="True"
                                         Padding="12,10" FontSize="14" ui:Bidi.AutoDirection="True" SpellCheck.IsEnabled="False"
                                         Visibility="{Binding IsPreview, Converter={StaticResource HasValue}, ConverterParameter=invert}" AutomationProperties.Name="{l:Loc Note_Content}" />
                                <Border Style="{StaticResource Tool.Console}" Background="#0A0F17" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                                    <ctl:MarkdownView Markdown="{Binding Content}" />
                                </Border>
                            </Grid>
                        </DockPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding HasNote, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Notes" Width="36" Height="36" />
                            <TextBlock Margin="0,12,0,0" Text="{l:Loc Note_EmptyTitle}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" Text="{l:Loc Note_EmptyBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                            <ui:ArcadiaButton Margin="0,14,0,0" HorizontalAlignment="Center" Variant="Primary" Icon="Plus" Content="{l:Loc Note_New}" Command="{Binding NewCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ═══════════ FILES ═══════════ -->
        <DockPanel Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Files}">
            <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
                <Border Style="{StaticResource Tool.CommandBarInner}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ArcadiaIcon Kind="Shield" Width="13" Height="13" Foreground="{StaticResource Brush.Icon.Dim}" />
                            <TextBlock Text="{l:Loc Ws_FilesHint}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Documents" Content="{l:Loc Proj_OpenFolder}" Command="{Binding OpenFolderCommand}" Visibility="{Binding FolderPath, Converter={StaticResource HasValue}}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Import" Content="{l:Loc Doc_AddFolder}" Command="{Binding AddFolderCommand}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Primary" Icon="Plus" Content="{l:Loc Ws_AddFiles}" Command="{Binding AddFilesCommand}" ToolTip="Ctrl+N" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <DataGrid x:Name="FileGrid" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Single" AutomationProperties.Name="{l:Loc Ws_Files}"
                                  Tag="{Binding}" ContextMenu="{StaticResource FileMenu}" MouseDoubleClick="OnFileDoubleClick">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding RemoveFileCommand}" />
                                <KeyBinding Key="Return" Command="{Binding OpenFileCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Loc Doc_Name}" Width="3*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type pvm:FileRowViewModel}">
                                            <!-- docked so long names trim instead of overflowing (also in right-to-left layouts) -->
                                                <DockPanel>
                                                    <ctl:FileIcon DockPanel.Dock="Left" Extension="{Binding Extension}" IsFolder="{Binding IsFolder}" />
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0,6,1" Background="#3A2A10" BorderBrush="#8A6420" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:Loc Doc_Missing}" FontSize="11" Foreground="#FFC96B" />
                                                </Border>
                                                    <ui:ArcadiaIcon DockPanel.Dock="Right" Kind="Pin" Width="11" Height="11" Margin="6,0,0,0" Foreground="{StaticResource Brush.Gold}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Text}" Margin="8,0,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                                </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Loc Doc_Type}" Binding="{Binding TypeName}" Width="1.3*" ElementStyle="{StaticResource Cell.Dim}" />
                                <DataGridTextColumn Header="{l:Loc Doc_Size}" Binding="{Binding SizeText}" SortMemberPath="Row.SizeBytes" Width="90" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{l:Loc Doc_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Row.FileModifiedUtc" Width="140" ElementStyle="{StaticResource Cell.Dim}" />
                                <DataGridTextColumn Header="{l:Loc Doc_Location}" Binding="{Binding Path}" Width="3*" ElementStyle="{StaticResource Cell.Path}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="{Binding Files.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="Import" Width="36" Height="36" />
                            <TextBlock Margin="0,12,0,0" Text="{l:Loc Ws_DropTitle}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" Text="{l:Loc Ws_DropBody}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DockPanel>

        <!-- ═══════════ LINKS ═══════════ -->
        <DockPanel Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Links}">
            <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
                <Border Style="{StaticResource Tool.CommandBarInner}">
                    <DockPanel>
                        <ui:ArcadiaButton DockPanel.Dock="Right" Style="{StaticResource Tool.Button}" Variant="Primary" Icon="Plus" Content="{l:Loc Link_Add}" Command="{Binding AddLinkCommand}" ToolTip="Ctrl+N" />
                        <TextBlock Text="{l:Loc Ws_LinksHint}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </Border>
            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}" Padding="4,2">
                    <Grid>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkRowTemplate}" AutomationProperties.Name="{l:Loc Ws_Links}" MouseDoubleClick="OnLinkDoubleClick" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Links.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                            <ui:ArcadiaIcon Kind="External" Width="34" Height="34" />
                            <TextBlock Margin="0,10,0,0" Text="{l:Loc Ws_NoLinks}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DockPanel>

        <!-- ═══════════ ACTIVITY ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource Tool.TableFrame}" Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Activity}">
            <Border Style="{StaticResource Tool.TableInner}" Padding="10,6">
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource ActivityRowTemplate}" AutomationProperties.Name="{l:Loc Ws_Activity}" />
            </Border>
        </Border>

        <!-- ═══════════ EXPENSES (Finance) ═══════════ -->
        <ContentControl Grid.Row="2" Content="{Binding Expenses}" Focusable="False" Visibility="{Binding SelectedTab, Converter={StaticResource Ws.TabVisible}, ConverterParameter=Expenses}" />

        <!-- drag & drop overlay -->
        <Border Grid.RowSpan="3" CornerRadius="6" BorderThickness="2" BorderBrush="#45D2FF" Background="#C0060A10" IsHitTestVisible="False"
                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ArcadiaIcon Kind="Import" Width="44" Height="44" />
                <TextBlock Margin="0,12,0,0" Text="{l:Loc Ws_DropNow}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
                <TextBlock Margin="0,6,0,0" Text="{l:Loc Ws_DropNowHint}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
