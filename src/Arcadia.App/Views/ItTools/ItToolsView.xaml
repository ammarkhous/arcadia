<UserControl x:Class="Arcadia.App.Views.ItTools.ItToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:tools="clr-namespace:Arcadia.App.Views.ItTools.Tools"
             xmlns:diag="clr-namespace:Arcadia.Core.ItTools.Diagnostics;assembly=Arcadia.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:ItToolsViewModel}">

    <UserControl.Resources>
        <!-- Each tool view model finds its view here -->
        <DataTemplate DataType="{x:Type it:SystemInfoToolViewModel}"><tools:SystemInfoView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:PerformanceToolViewModel}"><tools:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:NetworkAdaptersToolViewModel}"><tools:NetworkAdaptersView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:PingToolViewModel}"><tools:PingView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:TracerouteToolViewModel}"><tools:TracerouteView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:DnsToolViewModel}"><tools:DnsView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:PortTestToolViewModel}"><tools:PortTestView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:LocalDevicesToolViewModel}"><tools:LocalDevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:StorageToolViewModel}"><tools:StorageView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:LargeFilesToolViewModel}"><tools:LargeFilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:ProcessesToolViewModel}"><tools:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:ServicesToolViewModel}"><tools:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:EventLogToolViewModel}"><tools:EventLogView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:QuickCommandsToolViewModel}"><tools:QuickCommandsView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:DiagnosticSessionToolViewModel}"><tools:DiagnosticSessionView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:HashToolViewModel}"><tools:HashView /></DataTemplate>
        <DataTemplate DataType="{x:Type it:SubnetToolViewModel}"><tools:SubnetView /></DataTemplate>

        <!-- Overview: one "control panel" block per category -->
        <DataTemplate x:Key="CategoryBlock" DataType="{x:Type it:ToolCategoryGroup}">
            <ui:ArcadiaPanel Header="{Binding Title}" Icon="{Binding Icon}" Margin="0,0,0,10" Padding="6,4,6,6">
                <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type it:ToolEntry}">
                            <Button Style="{StaticResource ListRowButton}" Padding="8,6"
                                    Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Margin="11,0,6,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ui:ArcadiaIcon Grid.Column="2" Kind="ChevronRight" Width="12" Height="12" Foreground="{StaticResource Brush.Icon.Dim}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:ArcadiaPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ title plate + diagnostic session state ═══════════ -->
        <Grid Margin="4,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:ArcadiaIcon Kind="ITTools" Width="30" Height="30" />
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="{l:Loc It_Title}" Style="{StaticResource Text.Title}" FontSize="26" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" />
                </StackPanel>
            </StackPanel>

            <!-- recording plate -->
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" BorderThickness="1" BorderBrush="#5A2A30" Padding="10,5"
                    Visibility="{Binding Sessions.IsActive, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#2A151A" />
                        <GradientStop Offset="1" Color="#140C0F" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <ui:ArcadiaLed Tone="#EE4449" Width="10" Height="10" VerticalAlignment="Center" />
                    <StackPanel Margin="9,0,12,0" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{l:Loc It_SessionRecording}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#FF9A9E" />
                        <TextBlock ui:Bidi.Text="{Binding Sessions.ActiveTitle}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Diagnostic" Content="{l:Loc It_OpenSession}" Command="{Binding OpenSessionsCommand}" />
                </StackPanel>
            </Border>
            <ui:ArcadiaButton Grid.Column="1" Variant="Primary" Icon="Diagnostic" Content="{l:Loc It_StartSession}" Command="{Binding StartSessionCommand}"
                              VerticalAlignment="Center" MinHeight="36" Padding="16,6" ToolTip="{l:Loc It_StartSessionTip}"
                              Visibility="{Binding Sessions.IsActive, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
        </Grid>

        <!-- ═══════════ status strip: equipment-panel readouts ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}" Padding="0,7">
                <ItemsControl ItemsSource="{Binding Status}" Focusable="False" x:Name="StatusStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding StatusRows, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type it:StatusCell}">
                            <Grid Margin="0,1" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Value}">
                                <Border Width="1" HorizontalAlignment="Left" Margin="0,2" Background="#1E2A3C" />
                                <StackPanel Margin="12,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{StaticResource Brush.Icon.Dim}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#7F93AE" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <ui:ArcadiaLed Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center" Tone="{Binding Tone, Converter={StaticResource It.Tone}}"
                                                       Visibility="{Binding Tone, Converter={StaticResource HasValue}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Display}" FontSize="13.5" Foreground="{StaticResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    <ui:ArcadiaProgressBar Height="3" Margin="0,4,0,0" Value="{Binding Meter, Converter={StaticResource It.Percent}}" Tone="{Binding Tone, Converter={StaticResource It.Tone}}"
                                                           Visibility="{Binding Meter, Converter={StaticResource HasValue}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Border>

        <!-- ═══════════ body: tool rail + current tool ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding RailWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="6,6,6,8">
                            <ui:ArcadiaNavigationItem Style="{StaticResource Tool.RailItem}" GroupName="ItRail" IsChecked="{Binding IsOverview, Mode=OneWay}" Command="{Binding ShowOverviewCommand}"
                                         AutomationProperties.Name="{l:Loc It_Overview}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ArcadiaIcon Kind="ViewGrid" Width="16" Height="16" />
                                    <TextBlock Text="{l:Loc It_Overview}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:ArcadiaNavigationItem>
                            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type it:ToolCategoryGroup}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#62758F" Margin="10,12,0,4" />
                                            <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type it:ToolEntry}">
                                                        <ui:ArcadiaNavigationItem Style="{StaticResource Tool.RailItem}" GroupName="ItRail" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                     Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                                                     ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Title}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="16" Height="16" />
                                                                <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </ui:ArcadiaNavigationItem>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <!-- overview -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding OverviewColumns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding OverviewColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CategoryBlock}" Margin="0,0,10,0" Focusable="False" VerticalAlignment="Top" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:ArcadiaPanel Header="{l:Loc It_RecentSessions}" Icon="Diagnostic">
                            <ui:ArcadiaPanel.HeaderAction>
                                <ui:ArcadiaButton Variant="Link" Content="{l:Loc Home_ViewAll}" Command="{Binding OpenSessionsCommand}" />
                            </ui:ArcadiaPanel.HeaderAction>
                            <Grid>
                                <ItemsControl ItemsSource="{Binding RecentSessions}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type diag:DiagnosticSessionSummary}">
                                            <Button Style="{StaticResource ListRowButton}" Padding="8,5"
                                                    Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:ArcadiaLed Width="8" Height="8" VerticalAlignment="Center" IsOn="{Binding ClosedAtUtc, Converter={StaticResource It.IsNull}}" Tone="#34C76A" />
                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                        <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Text.Meta}" Text="{Binding Converter={StaticResource It.SessionMeta}}" />
                                                    </StackPanel>
                                                    <ui:ArcadiaIcon Grid.Column="2" Kind="ChevronRight" Width="12" Height="12" Foreground="{StaticResource Brush.Icon.Dim}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding RecentSessions.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" Margin="8,6,8,8">
                                    <TextBlock Text="{l:Loc It_NoSessions}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    <ui:ArcadiaButton Margin="0,10,0,0" HorizontalAlignment="Left" Icon="Diagnostic" Content="{l:Loc It_StartSession}" Command="{Binding StartSessionCommand}" />
                                </StackPanel>
                            </Grid>
                        </ui:ArcadiaPanel>
                        <ui:ArcadiaPanel Grid.Column="2" Header="{l:Loc It_PrivacyTitle}" Icon="Shield">
                            <StackPanel Margin="4,2,4,4">
                                <TextBlock Text="{l:Loc It_PrivacyBody}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc It_AdminBody}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </ui:ArcadiaPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- current tool -->
            <ui:TransitioningContentControl Grid.Column="2" Content="{Binding CurrentTool}" Focusable="False"
                                            Visibility="{Binding IsOverview, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
        </Grid>
    </Grid>
</UserControl>
