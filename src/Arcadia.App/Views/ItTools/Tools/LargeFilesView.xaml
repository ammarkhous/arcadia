<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:LargeFilesToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Large_Folder}" Style="{StaticResource Tool.InputLabel}" />
                            <Border Background="#0A0E15" BorderBrush="#26344A" BorderThickness="1" CornerRadius="3" MinHeight="30" Padding="8,0">
                                <TextBlock Text="{Binding FolderDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" ToolTip="{Binding Folder}" />
                            </Border>
                        </StackPanel>
                        <ui:ArcadiaButton Grid.Column="1" Style="{StaticResource Tool.Button}" Icon="Documents" Content="{l:Loc Large_Choose}" Command="{Binding ChooseFolderCommand}"
                                          VerticalAlignment="Bottom" IsEnabled="{Binding IsIdle}" Margin="8,0,0,0" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{l:Loc Large_MinSize}" Style="{StaticResource Tool.InputLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="LargeMin" Content="{Binding Converter={StaticResource It.MbLabel}}"
                                                 Command="{Binding DataContext.SetPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ui:ArcadiaChoice.IsChecked>
                                            <MultiBinding Converter="{StaticResource It.PresetChecked}" Mode="OneWay">
                                                <Binding />
                                                <Binding Path="DataContext.MinimumMb" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="DataContext.UseCustom" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </ui:ArcadiaChoice.IsChecked>
                                    </ui:ArcadiaChoice>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="LargeMin" Content="{l:Loc Large_Custom}" IsChecked="{Binding UseCustom}" />
                        <TextBox Width="70" MinHeight="26" Text="{Binding CustomMb, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustom}" AutomationProperties.Name="{l:Loc Large_Custom}" />
                        <TextBlock Text="MB" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Margin="6,0,16,0" />
                        <ui:ArcadiaButton Variant="Primary" Icon="FileSearch" IconSize="14" Content="{l:Loc Large_Scan}" Command="{Binding ScanCommand}" MinHeight="30" Padding="16,4"
                                          Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ArcadiaButton Icon="Stop" IconSize="12" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}" MinHeight="30" Padding="16,4"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding InputError}" Style="{StaticResource FieldError}" Visibility="{Binding InputError, Converter={StaticResource HasValue}}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ProgressText, Converter={StaticResource HasValue}}" />
                    <TextBlock Text="{l:Loc Large_Hint}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <DataGrid x:Name="Grid" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Tool_largefiles}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Large_Reveal}" Command="{Binding RevealCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{l:Loc Large_CopyPath}" Command="{Binding CopyPathCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{l:Loc It_CopyAll}" Command="{Binding CopyAllCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc Large_Size}" Binding="{Binding Size}" SortMemberPath="SizeBytes" SortDirection="Descending" Width="100" ElementStyle="{StaticResource Cell.Number}" />
                        <DataGridTextColumn Header="{l:Loc Large_Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell.Text}" />
                        <DataGridTextColumn Header="{l:Loc Large_Location}" Binding="{Binding Folder}" Width="2*" ElementStyle="{StaticResource Cell.Dim}" />
                        <DataGridTextColumn Header="{l:Loc Large_Modified}" Binding="{Binding Modified}" SortMemberPath="ModifiedLocal" Width="140" ElementStyle="{StaticResource Cell.Dim}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
