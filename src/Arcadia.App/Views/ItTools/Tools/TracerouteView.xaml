<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.TracerouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:TracerouteToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_Host}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="280" MinHeight="30" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Net_Host}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding StartCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Trace_MaxHops}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="64" MinHeight="30" Text="{Binding MaxHops, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Trace_MaxHops}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_TimeoutMs}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="80" MinHeight="30" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Net_TimeoutMs}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource Tool.Check}" Content="{l:Loc Trace_ResolveNames}" IsChecked="{Binding ResolveNames}" VerticalAlignment="Bottom" Margin="0,0,14,7" />
                        <ui:ArcadiaButton Variant="Primary" Icon="Play" IconSize="13" Content="{l:Loc Trace_Start}" Command="{Binding StartCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ArcadiaButton Icon="Stop" IconSize="12" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HostError}" Style="{StaticResource FieldError}" Visibility="{Binding HostError, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Hops}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Tool_trace}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Loc It_CopySelected}" Command="{Binding CopySelectedCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="{l:Loc It_CopyAll}" Command="{Binding CopyAllCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="64" SortMemberPath="Hop">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type it:HopRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaLed Width="8" Height="8" Tone="{Binding Tone, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Hop}" Style="{StaticResource Cell.Mono}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Trace_Address}" Binding="{Binding Address}" Width="150" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Trace_Host}" Binding="{Binding HostName}" Width="2*" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="1" Binding="{Binding Probe1}" Width="72" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="2" Binding="{Binding Probe2}" Width="72" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="3" Binding="{Binding Probe3}" Width="72" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Trace_Status}" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource Cell.Dim}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{l:Loc Trace_Idle}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Hops.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
