<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:PerformanceToolViewModel}">
    <UserControl.Resources>
        <!-- A graph panel: big reading on the left, 60-second trace on the right -->
        <Style x:Key="Reading" TargetType="TextBlock" BasedOn="{StaticResource Tool.ReadoutValue}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="{l:Loc Sys_Uptime}" Style="{StaticResource Tool.InputLabel}" />
                        <TextBlock Text="{Binding UptimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="15" Foreground="{StaticResource Brush.Text.Primary}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:Loc Perf_Processes}" Style="{StaticResource Tool.InputLabel}" />
                        <TextBlock Text="{Binding ProcessesText}" FontFamily="{StaticResource Font.Mono}" FontSize="15" Foreground="{StaticResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <ui:ArcadiaLed Width="9" Height="9" Tone="#34C76A" IsOn="{Binding IsPaused, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{l:Loc Perf_LiveHint}" Style="{StaticResource Text.Meta}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ToggleButton Grid.Column="3" Style="{StaticResource Tool.Chip}" Height="30" IsChecked="{Binding IsPaused, Mode=OneWay}" Command="{Binding TogglePauseCommand}"
                                  AutomationProperties.Name="{l:Loc Perf_Pause}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ArcadiaIcon Kind="Stop" Width="12" Height="12" />
                            <TextBlock Text="{l:Loc Perf_Pause}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Border>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:ArcadiaPanel Header="{l:Loc Perf_Cpu}" Icon="Cpu">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Reading}" Foreground="#9FE6FF" />
                        <TextBlock Text="{l:Loc Perf_CpuHint}" Style="{StaticResource Text.Meta}" />
                    </StackPanel>
                    <ui:ArcadiaLineGraph Values="{Binding CpuSeries}" Maximum="100" Tone="#45D2FF" MinHeight="70" AutomationProperties.Name="{l:Loc Perf_Cpu}" />
                </DockPanel>
            </ui:ArcadiaPanel>

            <ui:ArcadiaPanel Grid.Column="2" Header="{l:Loc Perf_Memory}" Icon="Memory">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Reading}" Foreground="#C8B3FF" />
                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Text.Meta}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ui:ArcadiaLineGraph Values="{Binding MemorySeries}" Maximum="100" Tone="#8E5BFF" MinHeight="70" AutomationProperties.Name="{l:Loc Perf_Memory}" />
                </DockPanel>
            </ui:ArcadiaPanel>

            <ui:ArcadiaPanel Grid.Row="2" Header="{l:Loc Perf_Disk}" Icon="Drive">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource Reading}" Foreground="#9FF0B8" />
                        <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource Text.Meta}" />
                    </StackPanel>
                    <ui:ArcadiaLineGraph Values="{Binding DiskSeries}" Maximum="100" Tone="#34C76A" MinHeight="70" AutomationProperties.Name="{l:Loc Perf_Disk}" />
                </DockPanel>
            </ui:ArcadiaPanel>

            <ui:ArcadiaPanel Grid.Row="2" Grid.Column="2" Header="{l:Loc Perf_Network}" Icon="Network">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ReceiveText}" Style="{StaticResource Reading}" FontSize="22" Foreground="#9FE6FF" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="3" Background="#45D2FF" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Loc Perf_Download}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SendText}" Style="{StaticResource Reading}" FontSize="22" Foreground="#FFD58A" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="3" Background="#F2A623" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Loc Perf_Upload}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ui:ArcadiaLineGraph Values="{Binding ReceiveSeries}" SecondaryValues="{Binding SendSeries}" Maximum="0" Tone="#45D2FF" SecondaryTone="#F2A623"
                                         MinHeight="70" AutomationProperties.Name="{l:Loc Perf_Network}" />
                </DockPanel>
            </ui:ArcadiaPanel>
        </Grid>
    </DockPanel>
</UserControl>
