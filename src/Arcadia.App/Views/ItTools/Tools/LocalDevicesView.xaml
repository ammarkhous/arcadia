<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.LocalDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:LocalDevicesToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Dev_Subnet}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBlock Text="{Binding SubnetText}" FontFamily="{StaticResource Font.Mono}" FontSize="14" Foreground="{StaticResource Brush.Text.Primary}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Refresh" Content="{l:Loc Dev_ShowKnown}" Command="{Binding LoadKnownCommand}" IsEnabled="{Binding IsIdle}" ToolTip="{l:Loc Dev_ShowKnownTip}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Variant="Primary" Icon="Devices" Content="{l:Loc Dev_Scan}" Command="{Binding ScanCommand}" ToolTip="{l:Loc Dev_ScanTip}"
                                              Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                            <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Stop" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}"
                                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0" Visibility="{Binding ProgressText, Converter={StaticResource HasValue}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ArcadiaProgressBar Height="6" Value="{Binding Progress, Converter={StaticResource It.Percent}}" Tone="#45D2FF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Text.Meta}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{l:Loc Dev_Hint}" Style="{StaticResource Text.Meta}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Tool_devices}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Loc It_CopySelected}" Command="{Binding CopySelectedCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="{l:Loc It_CopyAll}" Command="{Binding CopyAllCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Loc Dev_State}" Width="120" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type it:DeviceRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaLed Width="8" Height="8" Tone="{Binding Tone, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Cell.Text}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Dev_Ip}" Binding="{Binding Address}" Width="130" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Dev_Name}" Binding="{Binding HostName}" Width="2*" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="{l:Loc Dev_Mac}" Binding="{Binding Mac}" Width="150" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Dev_Latency}" Binding="{Binding Latency}" Width="80" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Dev_Role}" Binding="{Binding Role}" Width="*" ElementStyle="{StaticResource Cell.Dim}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
