<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.PingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:PingToolViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="ConsoleLineTemplate" DataType="{x:Type it:ConsoleLine}">
            <TextBlock x:Name="line" Text="{Binding Text}" Style="{StaticResource Tool.Mono}" FlowDirection="LeftToRight" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter TargetName="line" Property="Foreground" Value="#8FE3B0" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="line" Property="Foreground" Value="#FFC96B" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error"><Setter TargetName="line" Property="Foreground" Value="#FF8A8E" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Dim"><Setter TargetName="line" Property="Foreground" Value="#6F86A6" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Accent"><Setter TargetName="line" Property="Foreground" Value="#9FE6FF" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Stat" TargetType="TextBlock" BasedOn="{StaticResource Tool.ReadoutValue}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_Host}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="280" MinHeight="30" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Net_Host}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding StartCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Ping_Count}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="64" MinHeight="30" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Ping_Count}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_TimeoutMs}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="80" MinHeight="30" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Net_TimeoutMs}" />
                        </StackPanel>
                        <ui:ArcadiaButton Variant="Primary" Icon="Play" IconSize="13" Content="{l:Loc Ping_Start}" Command="{Binding StartCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ArcadiaButton Icon="Stop" IconSize="12" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HostError}" Style="{StaticResource FieldError}" Visibility="{Binding HostError, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tool.Console}">
                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Output}" ItemTemplate="{StaticResource ConsoleLineTemplate}" Focusable="False" />
                        <TextBlock Text="{l:Loc Ping_Idle}" Style="{StaticResource Tool.Mono}" Foreground="#4E6480"
                                   Visibility="{Binding Output.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ui:ArcadiaPanel Grid.Column="2" Header="{l:Loc Ping_Statistics}" Icon="Ping">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Ping_Sent}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBlock Text="{Binding Sent}" Style="{StaticResource Stat}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Ping_Received}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBlock Text="{Binding Received}" Style="{StaticResource Stat}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Ping_Loss}" Style="{StaticResource Tool.InputLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:ArcadiaLed Width="11" Height="11" VerticalAlignment="Center" Tone="{Binding LossTone, Converter={StaticResource It.Tone}}" />
                                <TextBlock Text="{Binding Loss}" Style="{StaticResource Stat}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Ping_Min}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBlock Text="{Binding Minimum}" Style="{StaticResource Stat}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Ping_Max}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBlock Text="{Binding Maximum}" Style="{StaticResource Stat}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:Loc Ping_Avg}" Style="{StaticResource Tool.InputLabel}" />
                    <TextBlock Text="{Binding Average}" Style="{StaticResource Stat}" FontSize="26" Foreground="#9FE6FF" />
                    <TextBlock Text="{l:Loc Ping_Latency}" Style="{StaticResource Tool.InputLabel}" Margin="0,12,0,4" />
                    <ui:ArcadiaLineGraph Height="70" Values="{Binding Latencies}" Maximum="0" Capacity="20" Tone="#45D2FF" />
                </StackPanel>
            </ui:ArcadiaPanel>
        </Grid>
    </DockPanel>
</UserControl>
