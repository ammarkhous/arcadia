<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:DnsToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Dns_Query}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="280" MinHeight="30" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Dns_Query}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding LookupCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Dns_RecordType}" Style="{StaticResource Tool.InputLabel}" />
                            <ItemsControl ItemsSource="{Binding RecordTypes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="DnsType" Height="30" Content="{Binding Converter={StaticResource It.DnsLabel}}"
                                                     Command="{Binding DataContext.SetTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:ArcadiaChoice.IsChecked>
                                                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.RecordType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </ui:ArcadiaChoice.IsChecked>
                                        </ui:ArcadiaChoice>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ui:ArcadiaButton Variant="Primary" Icon="Search" IconSize="13" Content="{l:Loc Dns_Lookup}" Command="{Binding LookupCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ArcadiaButton Icon="Stop" IconSize="12" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HostError}" Style="{StaticResource FieldError}" Visibility="{Binding HostError, Converter={StaticResource HasValue}}" />
                    <TextBlock Text="{l:Loc Dns_Hint}" Style="{StaticResource Text.Meta}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:Loc Tool_dns}">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyValueCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Loc Dns_CopyValue}" Command="{Binding CopyValueCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="{l:Loc It_CopyAll}" Command="{Binding CopyAllCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Loc Dns_Type}" Width="80" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type it:DnsRow}">
                                        <Border Style="{StaticResource Chip}" Margin="0" HorizontalAlignment="Left" Padding="6,0,6,1">
                                            <TextBlock Text="{Binding Type}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Foreground="#9FE6FF" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Dns_Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Dns_Value}" Binding="{Binding Value}" Width="2*" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="70" ElementStyle="{StaticResource Cell.Mono}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Notice, Converter={StaticResource HasValue}}" />
                </Grid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
