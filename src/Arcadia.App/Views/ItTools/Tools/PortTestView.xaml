<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.PortTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:PortTestToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_Host}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="260" MinHeight="30" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Net_Host}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TestCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Port_Port}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="72" MinHeight="30" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Port_Port}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding TestCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Net_TimeoutMs}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="80" MinHeight="30" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Net_TimeoutMs}" />
                        </StackPanel>
                        <ui:ArcadiaButton Variant="Primary" Icon="Port" IconSize="14" Content="{l:Loc Port_Test}" Command="{Binding TestCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ArcadiaButton Icon="Stop" IconSize="12" Content="{l:Loc It_Cancel}" Command="{Binding CancelCommand}" MinHeight="30" Padding="16,4" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding HostError}" Style="{StaticResource FieldError}" Visibility="{Binding HostError, Converter={StaticResource HasValue}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{l:Loc Port_Common}" Style="{StaticResource Tool.InputLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ItemsControl ItemsSource="{Binding CommonPorts}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type it:CommonPort}">
                                    <Button Style="{StaticResource Tool.ChipButton}" Command="{Binding DataContext.UsePortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Port}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Name}" Margin="5,0,0,0" Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- result plate -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="5" Padding="1" Background="#05070A" Visibility="{Binding Last, Converter={StaticResource HasValue}}">
            <Border CornerRadius="4" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" Padding="16,12" Background="{Binding ResultTone, Converter={StaticResource It.Slab}}">
                <StackPanel Orientation="Horizontal">
                    <ui:ArcadiaLed Width="20" Height="20" Tone="{Binding ResultTone, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{Binding ResultTitle}" FontFamily="{StaticResource Font.Display}" FontSize="22" Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Port_Disclaimer}" Style="{StaticResource Text.Meta}" Margin="2,8,0,0" TextWrapping="Wrap" />

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <Grid>
                    <DataGrid ItemsSource="{Binding History}" AutomationProperties.Name="{l:Loc Port_History}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Loc It_Result}" Width="170" SortMemberPath="Outcome">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type it:PortAttempt}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaLed Width="8" Height="8" Tone="{Binding Tone, Converter={StaticResource It.Tone}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource Cell.Text}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:Loc Port_Time}" Binding="{Binding Time}" Width="90" ElementStyle="{StaticResource Cell.Dim}" />
                            <DataGridTextColumn Header="{l:Loc Port_Host}" Binding="{Binding Host}" Width="*" ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="{l:Loc Port_Address}" Binding="{Binding Address}" Width="*" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Port_Port}" Binding="{Binding Port}" Width="70" ElementStyle="{StaticResource Cell.Mono}" />
                            <DataGridTextColumn Header="{l:Loc Port_Latency}" Binding="{Binding Latency}" Width="90" ElementStyle="{StaticResource Cell.Mono}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{l:Loc Port_Idle}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding History.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
