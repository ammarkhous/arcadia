<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.QuickCommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:QuickCommandsToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,10">
            <ui:ArcadiaIcon Kind="Shield" Width="13" Height="13" Foreground="{StaticResource Brush.Icon.Dim}" />
            <TextBlock Text="{l:Loc QuickCmd_Hint}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border Style="{StaticResource Tool.TableFrame}" VerticalAlignment="Top">
                <Border Style="{StaticResource Tool.TableInner}" Padding="6">
                    <ItemsControl ItemsSource="{Binding Commands}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type it:QuickCommandItem}">
                                <Button Style="{StaticResource ListRowButton}" Padding="10,8" Margin="2"
                                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Command.FileName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="4" BorderBrush="#2A3A52" BorderThickness="1" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#1C2940" />
                                                    <GradientStop Offset="1" Color="#0B111B" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="22" Height="22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ui:ArcadiaIcon Grid.Column="2" Kind="Shield" Width="15" Height="15" VerticalAlignment="Top" Foreground="#F2A623" ToolTip="{l:Loc QuickCmd_AdminTip}"
                                                        Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
