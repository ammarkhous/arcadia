<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:ProcessesToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="240" Height="30">
                        <TextBox x:Name="SearchBox" Padding="28,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{l:Loc Proc_Search}" />
                        <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                        <TextBlock Text="{l:Loc Proc_Search}" Margin="29,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Tool.Check}" Content="{l:Loc Proc_Live}" IsChecked="{Binding IsLive}" ToolTip="{l:Loc Proc_LiveTip}" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Refresh" Content="{l:Loc It_Refresh}" Command="{Binding RefreshCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Documents" Content="{l:Loc Proc_OpenLocation}" Command="{Binding RevealCommand}" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Copy" Content="{l:Loc It_Copy}" Command="{Binding CopySelectedCommand}" />
                        <ui:ArcadiaButton Style="{StaticResource Tool.Button}" Icon="Close" Content="{l:Loc Proc_End}" Command="{Binding EndProcessCommand}" Foreground="#FFB0B3" ToolTip="{l:Loc Proc_EndTip}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Style="{StaticResource Tool.TableFrame}">
            <Border Style="{StaticResource Tool.TableInner}">
                <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Single" AutomationProperties.Name="{l:Loc Tool_processes}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Proc_OpenLocation}" Command="{Binding RevealCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{l:Loc It_CopySelected}" Command="{Binding CopySelectedCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{l:Loc It_CopyAll}" Command="{Binding CopyAllCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon></MenuItem>
                            <Separator Background="#26344A" Margin="4" />
                            <MenuItem Header="{l:Loc Proc_End}" Command="{Binding EndProcessCommand}"><MenuItem.Icon><ui:ArcadiaIcon Kind="Close" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Loc Proc_Name}" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type it:ProcessRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ArcadiaIcon Kind="Shield" Width="12" Height="12" Margin="0,0,6,0" Foreground="#F2A623" ToolTip="{l:Loc Proc_CriticalTip}"
                                                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell.Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource Cell.Mono}" />
                        <DataGridTextColumn Header="{l:Loc Proc_CpuPct}" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="70" ElementStyle="{StaticResource Cell.Number}" />
                        <DataGridTextColumn Header="{l:Loc Proc_Memory}" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="96" ElementStyle="{StaticResource Cell.Number}" />
                        <DataGridTextColumn Header="{l:Loc Proc_Started}" Binding="{Binding Started}" SortMemberPath="StartedUtc" Width="130" ElementStyle="{StaticResource Cell.Dim}" />
                        <DataGridTextColumn Header="{l:Loc Proc_Path}" Binding="{Binding Path}" Width="3*" ElementStyle="{StaticResource Cell.Dim}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
