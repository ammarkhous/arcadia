<UserControl x:Class="Arcadia.App.Views.ItTools.Tools.SubnetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:it="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itv="clr-namespace:Arcadia.App.Views.ItTools"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance it:SubnetToolViewModel}">
    <DockPanel>
        <itv:ToolHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.CommandBar}">
            <Border Style="{StaticResource Tool.CommandBarInner}">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Subnet_Address}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="200" MinHeight="30" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight"
                                     AutomationProperties.Name="{l:Loc Subnet_Address}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{l:Loc Subnet_Prefix}" Style="{StaticResource Tool.InputLabel}" />
                            <TextBox Width="140" MinHeight="30" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight"
                                     AutomationProperties.Name="{l:Loc Subnet_Prefix}" ToolTip="{l:Loc Subnet_PrefixTip}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Subnet_Common}" Style="{StaticResource Tool.InputLabel}" />
                            <ItemsControl ItemsSource="{Binding CommonPrefixes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="SubnetPrefix" Height="30" Padding="7,0" Content="{Binding}" ContentStringFormat="/{0}"
                                                     Command="{Binding DataContext.UsePrefixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:ArcadiaChoice.IsChecked>
                                                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.Prefix" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </ui:ArcadiaChoice.IsChecked>
                                        </ui:ArcadiaChoice>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding InputError}" Style="{StaticResource FieldError}" Visibility="{Binding InputError, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>
        </Border>

        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ui:ArcadiaPanel Header="{l:Loc Subnet_Result}" Icon="Subnet">
                <ItemsControl ItemsSource="{Binding Rows}" Tag="170" Focusable="False" />
            </ui:ArcadiaPanel>
            <ui:ArcadiaPanel Grid.Column="2" Header="{l:Loc Subnet_Notation}" Icon="Network" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="CIDR" Style="{StaticResource Tool.InputLabel}" />
                    <TextBlock Text="{Binding Cidr}" FontFamily="{StaticResource Font.Mono}" FontSize="22" Foreground="#9FE6FF" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock Text="{l:Loc Subnet_Binary}" Style="{StaticResource Tool.InputLabel}" Margin="0,14,0,3" />
                    <Border Style="{StaticResource Tool.Console}" Padding="10,8">
                        <TextBox Style="{StaticResource Tool.SelectableText}" Text="{Binding MaskBinary, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="#B9D4F0" FlowDirection="LeftToRight" />
                    </Border>
                    <TextBlock Text="{l:Loc Subnet_Local}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ui:ArcadiaPanel>
        </Grid>
    </DockPanel>
</UserControl>
