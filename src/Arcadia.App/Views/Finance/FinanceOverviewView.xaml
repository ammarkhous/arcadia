<UserControl x:Class="Arcadia.App.Views.Finance.FinanceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:fvm="clr-namespace:Arcadia.App.ViewModels.Finance"
             xmlns:fin="clr-namespace:Arcadia.App.Views.Finance"
             xmlns:svc="clr-namespace:Arcadia.App.Services"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance fvm:FinanceOverviewViewModel}" x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ this month, in one strip ═══════ -->
        <Border Style="{StaticResource Fin.Panel}">
            <Border Style="{StaticResource Tool.TableInner}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="10,8,12,8" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource Fin.Kicker}" HorizontalAlignment="Right" />
                        <ItemsControl ItemsSource="{Binding Currencies}" Margin="0,6,0,0" Focusable="False" HorizontalAlignment="Right" Visibility="{Binding HasSeveralCurrencies, Converter={StaticResource Fin.HasValue}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="OverviewCurrency" Content="{Binding}" Margin="3,0,0,3" Padding="7,0" Height="24"
                                                 Command="{Binding DataContext.SetCurrencyCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                                <Binding />
                                                <Binding Path="DataContext.Currency" ElementName="Root" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Metrics}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- accounts + bills -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Fin_Balances}" Style="{StaticResource Fin.Kicker}" />
                            <ItemsControl ItemsSource="{Binding Balances}" Margin="0,6,0,6" Focusable="False" />
                            <Border Height="1" Background="#1A2638" Margin="0,2,0,6" />
                            <ItemsControl ItemsSource="{Binding AccountRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type fvm:AccountItem}">
                                        <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.ShowAccountCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="{l:Loc Fin_ShowTransactions}">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{Binding Accent, Converter={StaticResource Fin.Tone}}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="2,0,8,0">
                                                    <TextBlock ui:Bidi.Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TypeText}" FontSize="10.5" Foreground="#7F93AE" />
                                                </StackPanel>
                                                <fin:MoneyText Grid.Column="2" Money="{Binding BalanceText}" Style="{StaticResource Fin.Money}" VerticalAlignment="Center" Foreground="{Binding BalanceTone, Converter={StaticResource Fin.Ink}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Loc Fin_UpcomingBills}" Style="{StaticResource Fin.Kicker}" Margin="0,0,0,4" />
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Bills}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type fvm:BillItem}">
                                            <DockPanel>
                                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Check" IconSize="11" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                  Command="{Binding DataContext.MarkPaidCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                  ToolTip="{l:Loc Rec_MarkPaid}" AutomationProperties.Name="{l:Loc Rec_MarkPaid}" />
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Fin.BillRowTemplate}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Fin_NoBills}" Style="{StaticResource Fin.Meta}" TextWrapping="Wrap" Visibility="{Binding HasBills, Converter={StaticResource Fin.HasValue}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- trend + recent -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <ItemsControl DockPanel.Dock="Right" Focusable="False" ItemsSource="{Binding TrendSeries}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type fin:ChartSeries}">
                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                                <Border Width="10" Height="3" CornerRadius="1.5" Background="{Binding Tone, Converter={StaticResource Fin.Ink}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#9FB3CC" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Loc Fin_MonthlyTrend}" Style="{StaticResource Fin.Kicker}" VerticalAlignment="Center" />
                            </DockPanel>
                            <fin:FinanceChart Series="{Binding TrendSeries}" Labels="{Binding TrendLabels}" Formatter="{Binding ChartFormatter}" AxisFormatter="{Binding AxisFormatter}"
                                              HideValues="{Binding IsHidden, Source={x:Static svc:FinancePrivacy.Instance}}" AutomationProperties.Name="{l:Loc Fin_MonthlyTrend}" />
                        </DockPanel>
                    </Border>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Loc Fin_RecentTransactions}" Style="{StaticResource Fin.Kicker}" Margin="0,0,0,4" />
                            <Grid>
                                <ListBox x:Name="RecentList" ItemsSource="{Binding Recent}" Style="{StaticResource Tr.List}" ItemTemplate="{StaticResource Fin.TxnLineTemplate}" AutomationProperties.Name="{l:Loc Fin_RecentTransactions}">
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditTransactionCommand}" CommandParameter="{Binding SelectedItem, ElementName=RecentList}" />
                                        <KeyBinding Key="Return" Command="{Binding EditTransactionCommand}" CommandParameter="{Binding SelectedItem, ElementName=RecentList}" />
                                    </ListBox.InputBindings>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRecent, Converter={StaticResource Fin.HasValue}, ConverterParameter=invert}">
                                    <TextBlock Text="{l:Loc Fin_NoTransactions}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                                    <ui:ArcadiaButton Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Fin_NewTransaction}" Command="{Binding NewTransactionCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- spending + budgets -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <StackPanel>
                            <DockPanel>
                                <fin:MoneyText DockPanel.Dock="Right" Money="{Binding SpendingTotal}" Style="{StaticResource Fin.Money}" FontSize="12" Foreground="#AFC2D8" />
                                <TextBlock Text="{l:Loc Fin_SpendingByCategory}" Style="{StaticResource Fin.Kicker}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CategoryBars}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type fvm:CategoryBar}">
                                        <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.ShowCategoryCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Fin.CategoryBarTemplate}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Loc Fin_NoSpending}" Style="{StaticResource Fin.Meta}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasSpending, Converter={StaticResource Fin.HasValue}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Fin.Panel}">
                    <Border Style="{StaticResource Fin.PanelInner}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:Loc Fin_BudgetStatus}" Style="{StaticResource Fin.Kicker}" Margin="0,0,0,2" />
                            <Grid>
                                <ItemsControl ItemsSource="{Binding BudgetRows}" ItemTemplate="{StaticResource Fin.BudgetRowTemplate}" Focusable="False" />
                                <TextBlock Text="{l:Loc Fin_NoBudgets}" Style="{StaticResource Fin.Meta}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasBudgets, Converter={StaticResource Fin.HasValue}, ConverterParameter=invert}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
