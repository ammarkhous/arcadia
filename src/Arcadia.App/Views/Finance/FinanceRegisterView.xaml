<UserControl x:Class="Arcadia.App.Views.Finance.FinanceRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:ctl="clr-namespace:Arcadia.App.Views.Controls"
             xmlns:fvm="clr-namespace:Arcadia.App.ViewModels.Finance"
             xmlns:fin="clr-namespace:Arcadia.App.Views.Finance"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance fvm:FinanceRegisterViewModel}" x:Name="Root">
    <UserControl.Resources>
        <!-- one set of column widths for the header and every row -->
        <GridLength x:Key="ColDate">96</GridLength>
        <GridLength x:Key="ColCategory">170</GridLength>
        <GridLength x:Key="ColAccount">160</GridLength>
        <GridLength x:Key="ColTags">110</GridLength>
        <GridLength x:Key="ColAmount">136</GridLength>
    </UserControl.Resources>
    <DockPanel>
        <!-- filters -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Search" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" MinHeight="28" Padding="26,0,6,0" VerticalContentAlignment="Center"
                         ctl:Shortcuts.IsSearchBox="True" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Reg_Search}" />
                <ui:ArcadiaIcon Kind="Search" Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="{l:Loc Reg_Search}" Margin="28,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Text, ElementName=Search, Converter={StaticResource Fin.HasValue}, ConverterParameter=invert}" />
            </Grid>
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="130" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding Period}" AutomationProperties.Name="{l:Loc Reg_Period}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding IsCustomPeriod, Converter={StaticResource Fin.HasValue}}">
                <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged, Delay=600}" Width="96" MinHeight="28" FlowDirection="LeftToRight" VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc Reg_From}" />
                <TextBlock Text="–" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" />
                <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged, Delay=600}" Width="96" MinHeight="28" FlowDirection="LeftToRight" VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc Reg_To}" />
            </StackPanel>
            <ComboBox Grid.Column="3" Margin="8,0,0,0" MinWidth="130" MaxWidth="190" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding Account}" AutomationProperties.Name="{l:Loc Reg_Account}" />
            <ComboBox Grid.Column="4" Margin="8,0,0,0" MinWidth="140" MaxWidth="200" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" AutomationProperties.Name="{l:Loc Reg_Category}" />
            <ComboBox Grid.Column="5" Margin="8,0,0,0" MinWidth="110" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" AutomationProperties.Name="{l:Loc Reg_Type}" />
            <ToggleButton Grid.Column="6" Style="{StaticResource Tr.Legend}" IsChecked="{Binding ReviewOnly}" Margin="8,0,0,0" Height="28" AutomationProperties.Name="{l:Loc Reg_NeedsReview}" ToolTip="{l:Loc Reg_NeedsReviewTip}">
                <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Warning" Width="12" Height="12" /><TextBlock Text="{l:Loc Reg_NeedsReview}" Margin="6,0,0,0" /></StackPanel>
            </ToggleButton>
        </Grid>

        <!-- totals -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Fin.Panel}" Margin="0,8,0,0">
            <Border Style="{StaticResource Tool.TableInner}" Padding="12,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ArcadiaButton Variant="Link" Content="{l:Loc Reg_ClearFilters}" Command="{Binding ClearFiltersCommand}" Margin="0,0,12,0" Visibility="{Binding HasFilters, Converter={StaticResource Fin.HasValue}}" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Fin.Meta}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Scope}" Focusable="False" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="{Binding Scope, Converter={StaticResource Fin.HasValue}}" />
                        <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="9" Width="20" Height="20" Margin="0,0,12,0" Command="{Binding ClearScopeCommand}" AutomationProperties.Name="{l:Loc Task_ClearScope}"
                                          Visibility="{Binding Scope, Converter={StaticResource Fin.HasValue}}" />
                        <ItemsControl ItemsSource="{Binding Totals}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type fvm:CurrencyTotal}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <Border CornerRadius="2" Padding="5,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#2A3E58" Background="#0C1622" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Currency}" FontFamily="{StaticResource Fin.Figures}" FontSize="10.5" Foreground="#9FC4E6" />
                                        </Border>
                                        <fin:MoneyText Money="{Binding TotalText}" Style="{StaticResource Fin.Money}" TextAlignment="Left" FontSize="12" Foreground="#AFC2D8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!-- the register -->
        <Border Style="{StaticResource Fin.Panel}">
            <Border Style="{StaticResource Tool.TableInner}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#1E2E44" BorderThickness="0,0,0,1" Padding="12,0" Background="#0A111B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ColDate}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource ColCategory}" />
                                <ColumnDefinition Width="{StaticResource ColAccount}" />
                                <ColumnDefinition Width="{StaticResource ColTags}" />
                                <ColumnDefinition Width="{StaticResource ColAmount}" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Fin.Header}" Content="{l:Loc Reg_ColDate}" Command="{Binding SortByCommand}" CommandParameter="date" />
                            <Button Grid.Column="1" Style="{StaticResource Fin.Header}" Content="{l:Loc Reg_ColDescription}" Command="{Binding SortByCommand}" CommandParameter="description" />
                            <Button Grid.Column="2" Style="{StaticResource Fin.Header}" Content="{l:Loc Reg_ColCategory}" Command="{Binding SortByCommand}" CommandParameter="category" />
                            <Button Grid.Column="3" Style="{StaticResource Fin.Header}" Content="{l:Loc Reg_ColAccount}" Command="{Binding SortByCommand}" CommandParameter="account" />
                            <TextBlock Grid.Column="4" Text="{l:Loc Reg_ColTags}" FontSize="10.5" FontWeight="SemiBold" Foreground="#7F93AE" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Style="{StaticResource Fin.Header}" HorizontalContentAlignment="Right" Content="{l:Loc Reg_ColAmount}" Command="{Binding SortByCommand}" CommandParameter="amount" />
                        </Grid>
                    </Border>
                    <Grid>
                        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Tr.List}" AutomationProperties.Name="{l:Loc FinSec_Transactions}"
                                 KeyDown="OnListKey" MouseDoubleClick="OnListDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Tr.RowItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type fvm:TransactionItem}">
                                    <Grid MinHeight="36" Margin="12,0">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:Loc Reg_Edit}" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Icon><ui:ArcadiaIcon Kind="Journal" Width="14" Height="14" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Loc Reg_Duplicate}" Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Icon><ui:ArcadiaIcon Kind="Copy" Width="14" Height="14" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Loc Reg_AttachReceipt}" Command="{Binding PlacementTarget.Tag.AttachReceiptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Icon><ui:ArcadiaIcon Kind="Receipt" Width="14" Height="14" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Loc Reg_ToggleReview}" Command="{Binding PlacementTarget.Tag.ToggleReviewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Icon><ui:ArcadiaIcon Kind="Warning" Width="14" Height="14" /></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{l:Loc Confirm_Delete}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.Tag><Binding Path="DataContext" ElementName="Root" /></Grid.Tag>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource ColDate}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{StaticResource ColCategory}" />
                                            <ColumnDefinition Width="{StaticResource ColAccount}" />
                                            <ColumnDefinition Width="{StaticResource ColTags}" />
                                            <ColumnDefinition Width="{StaticResource ColAmount}" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Org.Time}" FontSize="11" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Org.Time}" FontSize="10" Foreground="#5F7690" Visibility="{Binding TimeText, Converter={StaticResource Fin.HasValue}}" />
                                        </StackPanel>
                                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,10,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ContentControl Content="{Binding Project}" Focusable="False" Margin="6,0,0,0" Visibility="{Binding Project, Converter={StaticResource Fin.HasValue}}" />
                                                <ContentControl Content="{Binding Trip}" Focusable="False" Margin="6,0,0,0" Visibility="{Binding Trip, Converter={StaticResource Fin.HasValue}}" />
                                                <ui:ArcadiaIcon Kind="Receipt" Width="11" Height="11" Margin="8,0,0,0" Opacity="0.75" Visibility="{Binding HasDocuments, Converter={StaticResource Fin.HasValue}}" ToolTip="{l:Loc Reg_HasReceipt}" />
                                                <ui:ArcadiaIcon Kind="Notes" Width="11" Height="11" Margin="8,0,0,0" Opacity="0.6" Visibility="{Binding HasNotes, Converter={StaticResource Fin.HasValue}}" ToolTip="{l:Loc Task_HasNotes}" />
                                                <ui:ArcadiaIcon Kind="Repeat" Width="11" Height="11" Margin="8,0,0,0" Opacity="0.6" Visibility="{Binding IsRecurring, Converter={StaticResource Fin.HasValue}}" ToolTip="{l:Loc Reg_FromBill}" />
                                                <ui:ArcadiaIcon Kind="Warning" Width="11" Height="11" Margin="8,0,0,0" Foreground="#E0B060" Visibility="{Binding NeedsReview, Converter={StaticResource Fin.HasValue}}" ToolTip="{l:Loc Reg_NeedsReviewTip}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock ui:Bidi.Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock ui:Bidi.Text="{Binding Payee}" FontSize="10.5" Foreground="#7F93AE" TextTrimming="CharacterEllipsis" Visibility="{Binding Payee, Converter={StaticResource Fin.HasValue}}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <ui:ArcadiaIcon Kind="{Binding CategoryIcon}" Width="12" Height="12" Foreground="{Binding CategoryAccent, Converter={StaticResource Fin.Tone}}" />
                                            <TextBlock ui:Bidi.Text="{Binding CategoryText}" FontSize="12" Foreground="#AFC2D8" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" ui:Bidi.Text="{Binding AccountText}" FontSize="12" Foreground="#AFC2D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding Tags}" FontSize="11" Foreground="#6F86A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <fin:MoneyText Money="{Binding AmountText}" Style="{StaticResource Fin.Money}" FontSize="13.5" Foreground="{Binding AmountTone, Converter={StaticResource Fin.Ink}}" />
                                            <fin:MoneyText Money="{Binding ToAmountText}" Style="{StaticResource Fin.Money}" FontSize="10.5" Foreground="#6F86A6" Visibility="{Binding ToAmountText, Converter={StaticResource Fin.HasValue}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="{Binding IsEmpty, Converter={StaticResource Fin.HasValue}}">
                            <ui:ArcadiaIcon Kind="Receipt" Width="30" Height="30" Opacity="0.55" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <ui:ArcadiaButton Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Fin_NewTransaction}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                                <ui:ArcadiaButton Icon="Import" IconSize="13" Content="{l:Loc Fin_ImportCsv}" Command="{Binding ImportCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
