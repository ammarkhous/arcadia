<UserControl x:Class="Arcadia.App.Views.Finance.FinanceGoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:fvm="clr-namespace:Arcadia.App.ViewModels.Finance"
             xmlns:fin="clr-namespace:Arcadia.App.Views.Finance"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance fvm:FinanceGoalsViewModel}" x:Name="Root">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="{l:Loc Goal_ShowArchived}" IsChecked="{Binding ShowArchived}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,12,0" />
                <ui:ArcadiaButton Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Goal_New}" Command="{Binding NewCommand}" />
            </StackPanel>
            <TextBlock Text="{l:Loc Goal_Intro}" Style="{StaticResource Fin.Meta}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type fvm:GoalItem}">
                            <Border Style="{StaticResource Fin.Panel}" Margin="0,0,10,10">
                                <Border Style="{StaticResource Fin.PanelInner}" Padding="14,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:ArcadiaButton Variant="Tool" Icon="Plus" IconSize="11" Width="26" Height="24" Command="{Binding DataContext.AddMoneyCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                  ToolTip="{l:Loc Goal_AddTitle}" AutomationProperties.Name="{l:Loc Goal_AddTitle}" Margin="0,0,3,0" Visibility="{Binding IsManual, Converter={StaticResource Fin.HasValue}}" />
                                                <ui:ArcadiaButton Variant="Tool" Icon="Settings" IconSize="11" Width="26" Height="24" Command="{Binding DataContext.EditCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                  ToolTip="{l:Loc Goal_EditTitle}" AutomationProperties.Name="{l:Loc Goal_EditTitle}" Margin="0,0,3,0" />
                                                <ui:ArcadiaButton Variant="Tool" Icon="Layers" IconSize="11" Width="26" Height="24" Command="{Binding DataContext.ToggleArchiveCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                  ToolTip="{l:Loc Goal_ToggleArchive}" AutomationProperties.Name="{l:Loc Goal_ToggleArchive}" />
                                            </StackPanel>
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{Binding Accent, Converter={StaticResource Fin.Tone}}" VerticalAlignment="Center" />
                                            <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,12,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontFamily="{StaticResource Fin.Figures}" FontSize="20" FontWeight="Light" Foreground="{Binding Accent, Converter={StaticResource Fin.Tone}}" VerticalAlignment="Bottom" />
                                            <fin:MoneyText Money="{Binding SavedText}" Style="{StaticResource Fin.MoneyLarge}" FontSize="20" />
                                        </DockPanel>
                                        <fin:MeterBar Value="{Binding Meter}" Tone="{Binding Accent}" Margin="0,8,0,0" />
                                        <fin:MoneyText Money="{Binding OfText}" FontSize="11.5" Foreground="#8FA3BD" TextAlignment="Left" Margin="0,6,0,0" />
                                        <fin:MoneyText Money="{Binding RemainingText}" FontSize="11.5" Foreground="#AFC2D8" TextAlignment="Left" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding DateText, Converter={StaticResource Fin.HasValue}}">
                                            <ui:ArcadiaIcon Kind="Flag" Width="11" Height="11" Opacity="0.8" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Org.Time}" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <fin:MoneyText Money="{Binding PaceText}" FontSize="11" Foreground="#7F93AE" TextAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding PaceText, Converter={StaticResource Fin.HasValue}}" />
                                        <TextBlock Text="{Binding AccountText}" Style="{StaticResource Fin.Meta}" Margin="0,4,0,0" Visibility="{Binding AccountText, Converter={StaticResource Fin.HasValue}}" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding IsEmpty, Converter={StaticResource Fin.HasValue}}">
                <ui:ArcadiaIcon Kind="Target" Width="30" Height="30" Opacity="0.55" />
                <TextBlock Text="{l:Loc Goal_Empty}" Style="{StaticResource Text.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                <ui:ArcadiaButton Variant="Primary" Icon="Plus" IconSize="12" Content="{l:Loc Goal_New}" Command="{Binding NewCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
