<UserControl x:Class="Arcadia.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:vm="clr-namespace:Arcadia.App.ViewModels"
             xmlns:local="clr-namespace:Arcadia.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Separator}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="1100" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title plate -->
            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="6,4,0,14">
                <ui:ArcadiaIcon Kind="Settings" Width="30" Height="30" />
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="{l:Loc Settings_Title}" Style="{StaticResource Text.Title}" FontSize="26" />
                    <TextBlock Text="{l:Loc Settings_Subtitle}" Style="{StaticResource Text.Meta}" />
                </StackPanel>
            </StackPanel>

            <!-- Appearance -->
            <ui:ArcadiaPanel Grid.Row="1" Header="{l:Loc Settings_Appearance}" Icon="Travel" ui:Reveal.Delay="0" VerticalAlignment="Top" Margin="0,0,0,10">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{l:Loc Settings_LanguageHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="DisplayName" AutomationProperties.Name="{l:Loc Settings_Language}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnimationsEnabled}" AutomationProperties.Name="{l:Loc Settings_Animations}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_Animations}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{l:Loc Settings_AnimationsHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ui:ArcadiaPanel>

            <!-- Startup + About -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <ui:ArcadiaPanel Header="{l:Loc Settings_Startup}" Icon="Play" ui:Reveal.Delay="60" Margin="0,0,0,10">
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMaximized}" AutomationProperties.Name="{l:Loc Settings_StartMaximized}">
                            <TextBlock Text="{l:Loc Settings_StartMaximized}" Style="{StaticResource Text.Item}" />
                        </CheckBox>
                    </Border>
                </ui:ArcadiaPanel>
            </StackPanel>

            <!-- Backup & recovery, diagnostics -->
            <local:MaintenancePanels Grid.Row="2" Grid.ColumnSpan="3" DataContext="{Binding Maintenance}" Margin="0,0,0,10" />

            <!-- Data & privacy -->
            <ui:ArcadiaPanel Grid.Row="3" Header="{l:Loc Settings_Data}" Icon="Documents" ui:Reveal.Delay="140" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_DataFolder}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource PathText}" />
                            </StackPanel>
                            <ui:ArcadiaButton Grid.Column="1" Content="{l:Loc Settings_Open}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding DataFolder}" MinWidth="70" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_SettingsFolder}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{Binding SettingsFolder}" Style="{StaticResource PathText}" />
                            </StackPanel>
                            <ui:ArcadiaButton Grid.Column="1" Content="{l:Loc Settings_Open}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SettingsFolder}" MinWidth="70" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_LogsFolder}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{Binding LogsFolder}" Style="{StaticResource PathText}" />
                            </StackPanel>
                            <ui:ArcadiaButton Grid.Column="1" Content="{l:Loc Settings_Open}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LogsFolder}" MinWidth="70" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowOnlineMetadata}" AutomationProperties.Name="{l:Loc Settings_OnlineMetadata}">
                            <TextBlock Text="{l:Loc Settings_OnlineMetadata}" Style="{StaticResource Text.Item}" />
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ui:ArcadiaPanel>

            <!-- Sample library -->
            <ui:ArcadiaPanel Grid.Row="3" Grid.Column="2" Header="{l:Loc Settings_SampleData}" Icon="Library" ui:Reveal.Delay="180" VerticalAlignment="Top">
                <StackPanel Margin="4,8">
                    <TextBlock Text="{l:Loc Settings_SampleDataHint}" Style="{StaticResource Text.Body}" />
                    <ui:ArcadiaButton x:Name="RemoveSampleButton" Margin="0,12,0,0" HorizontalAlignment="Left" Icon="Close" IconSize="12"
                                      Command="{Binding RemoveSampleDataCommand}" IsEnabled="{Binding SampleRemoved, Converter={StaticResource InverseBool}}">
                        <ui:ArcadiaButton.Style>
                            <Style TargetType="ui:ArcadiaButton" BasedOn="{StaticResource {x:Type ui:ArcadiaButton}}">
                                <Setter Property="Content" Value="{l:Loc Settings_RemoveSample}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirmingRemoval}" Value="True">
                                        <Setter Property="Content" Value="{l:Loc Settings_RemoveSampleConfirm}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#E0484E" />
                                                    <GradientStop Offset="1" Color="#9E2228" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ArcadiaButton.Style>
                    </ui:ArcadiaButton>
                </StackPanel>
            </ui:ArcadiaPanel>
            <!-- Play tracking -->
            <ui:ArcadiaPanel Grid.Row="4" Header="{l:Loc Settings_Tracking}" Icon="Clock" ui:Reveal.Delay="220" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TrackingEnabled}" AutomationProperties.Name="{l:Loc Settings_TrackingEnabled}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_TrackingEnabled}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{l:Loc Settings_TrackingHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" IsEnabled="{Binding TrackingEnabled}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DetectExternal}" AutomationProperties.Name="{l:Loc Settings_DetectExternal}">
                            <TextBlock Text="{l:Loc Settings_DetectExternal}" Style="{StaticResource Text.Item}" />
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" IsEnabled="{Binding TrackingEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc Settings_MinSession}" Style="{StaticResource Text.Item}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MinimumSessionOptions}" SelectedItem="{Binding MinimumSession}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="{l:Loc Settings_MinSession}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:ArcadiaPanel>

            <!-- Capture folders -->
            <ui:ArcadiaPanel Grid.Row="4" Grid.Column="2" Header="{l:Loc Settings_Captures}" Icon="Camera" ui:Reveal.Delay="260" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CapturesEnabled}" AutomationProperties.Name="{l:Loc Settings_CapturesEnabled}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_CapturesEnabled}" Style="{StaticResource Text.Item}" />
                                <TextBlock Text="{l:Loc Settings_CapturesHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <TextBlock Margin="4,10" Text="{l:Loc Settings_NoFolders}" Style="{StaticResource Text.Meta}"
                               Visibility="{Binding CaptureFolders.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding CaptureFolders}" Focusable="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingRow}" Padding="4,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource PathText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        <ui:ArcadiaButton Grid.Column="2" Variant="Tool" Icon="Trash" IconSize="13" Width="26" Height="26"
                                                          Command="{Binding DataContext.RemoveCaptureFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                          ToolTip="{l:Loc Settings_RemoveFolder}" AutomationProperties.Name="{l:Loc Settings_RemoveFolder}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="4,12,4,6">
                        <ui:ArcadiaButton Icon="Plus" IconSize="13" Content="{l:Loc Settings_AddFolder}" Command="{Binding AddCaptureFolderCommand}" />
                        <ui:ArcadiaButton Margin="8,0,0,0" Icon="Search" IconSize="13" Content="{l:Loc Settings_AddDetected}" Command="{Binding AddDetectedFoldersCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:ArcadiaPanel>
            <!-- Online services -->
            <ui:ArcadiaPanel Grid.Row="5" Grid.ColumnSpan="3" Header="{l:Loc Settings_Online}" Icon="Travel" ui:Reveal.Delay="300" Margin="0,10,0,0">
                <StackPanel Margin="4,6">
                    <TextBlock Text="{l:Loc Settings_OnlineHint}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_IgdbId}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IgdbClientId, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Settings_IgdbId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Loc Settings_IgdbSecret}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="IgdbSecretBox" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Settings_IgdbSecret}" />
                            <TextBlock Margin="0,3,0,0" Text="{l:Loc Settings_KeyStored}" Style="{StaticResource Text.Meta}" Foreground="#8FE3B0"
                                       Visibility="{Binding IgdbSecretSaved, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{l:Loc Settings_SgdbKey}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="SgdbKeyBox" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Settings_SgdbKey}" />
                            <TextBlock Margin="0,3,0,0" Text="{l:Loc Settings_KeyStored}" Style="{StaticResource Text.Meta}" Foreground="#8FE3B0"
                                       Visibility="{Binding SgdbKeySaved, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Settings_SaveKeys}" Click="OnSaveOnlineServices" />
                            <ui:ArcadiaButton Margin="8,0,0,0" Icon="Trash" IconSize="13" Content="{l:Loc Settings_ClearKeys}" Command="{Binding ClearOnlineKeysCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Meta_Loading}" Style="{StaticResource Text.Meta}" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding IgdbStatus}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SgdbStatus}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:ArcadiaPanel>
            <!-- Travel maps & place search -->
            <ui:ArcadiaPanel Grid.Row="6" Grid.ColumnSpan="3" Header="{l:Loc Settings_Travel}" Icon="Map" ui:Reveal.Delay="340" Margin="0,10,0,0">
                <StackPanel Margin="4,6">
                    <TextBlock Text="{l:Loc Settings_TravelHint}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_TravelTiles}" Style="{StaticResource Text.Item}" />
                            <TextBlock Text="{l:Loc Settings_TravelTilesHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" IsChecked="{Binding TravelOnlineTiles}" VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Settings_TravelTiles}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_TravelSearch}" Style="{StaticResource Text.Item}" />
                            <TextBlock Text="{l:Loc Settings_TravelSearchHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" IsChecked="{Binding TravelOnlineSearch}" VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Settings_TravelSearch}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_TileStyle}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TileStyles}" SelectedItem="{Binding TileStyle}" MinHeight="30" MinWidth="320" AutomationProperties.Name="{l:Loc Settings_TileStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding MapTilesStatus}" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="0,0,0,6" TextWrapping="Wrap" />
                    </Grid>
                    <ToggleButton x:Name="CustomTilesToggle" Margin="0,12,0,0" HorizontalAlignment="Left" Cursor="Hand" Focusable="True" AutomationProperties.Name="{l:Loc Settings_CustomTiles}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <ui:ArcadiaIcon x:Name="Chevron" Kind="ChevronRight" Width="11" Height="11" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <ui:ArcadiaIcon.RenderTransform><RotateTransform /></ui:ArcadiaIcon.RenderTransform>
                                    </ui:ArcadiaIcon>
                                    <TextBlock x:Name="Label" Text="{l:Loc Settings_CustomTiles}" Margin="8,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="Foreground" Value="#E6F0FA" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Border Visibility="{Binding IsChecked, ElementName=CustomTilesToggle, Converter={StaticResource BoolToVisibility}}" Margin="19,0,0,0">                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{l:Loc Settings_CustomTilesHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Settings_CustomTileUrl}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CustomTileUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontFamily="Cascadia Mono, Consolas" FontSize="12" FlowDirection="LeftToRight"
                                             AutomationProperties.Name="{l:Loc Settings_CustomTileUrl}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc Settings_CustomTileAttribution}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CustomTileAttribution, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" AutomationProperties.Name="{l:Loc Settings_CustomTileAttribution}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{l:Loc Settings_MapKey}" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="MapKeyBox" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Settings_MapKey}" />
                                    <TextBlock Margin="0,3,0,0" Text="{l:Loc Settings_KeyStored}" Style="{StaticResource Text.Meta}" Foreground="#8FE3B0"
                                               Visibility="{Binding MapKeySaved, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Settings_SaveCustomTiles}" Click="OnSaveCustomTiles" />
                                <ui:ArcadiaButton Margin="8,0,0,0" Icon="Trash" IconSize="13" Content="{l:Loc Settings_ClearMapKey}" Command="{Binding ClearMapKeyCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:Loc Settings_MapCredits}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </ui:ArcadiaPanel>
            <!-- ═══ Calendar, tasks & notes; Home ═══ -->
            <ui:ArcadiaPanel Grid.Row="7" Header="{l:Loc Settings_Organizer}" Icon="Calendar" ui:Reveal.Delay="360" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel Margin="6,4,6,6">
                    <TextBlock Text="{l:Loc Settings_OrganizerHint}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_DayStart}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding StartHours}" SelectedItem="{Binding DayStartHour}" MinHeight="28" AutomationProperties.Name="{l:Loc Settings_DayStart}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Loc Settings_DayEnd}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding EndHours}" SelectedItem="{Binding DayEndHour}" MinHeight="28" AutomationProperties.Name="{l:Loc Settings_DayEnd}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:Loc Settings_HoursHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{l:Loc Settings_DefaultReminder}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <ComboBox ItemsSource="{Binding ReminderDefaults}" SelectedItem="{Binding DefaultReminder}" MinHeight="28" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="{l:Loc Settings_DefaultReminder}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_ReminderSound}" Style="{StaticResource Text.Item}" />
                            <TextBlock Text="{l:Loc Settings_ReminderSoundHint}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Grid.Column="1" IsChecked="{Binding ReminderSound}" VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Settings_ReminderSound}" />
                    </Grid>
                </StackPanel>
            </ui:ArcadiaPanel>
            <ui:ArcadiaPanel Grid.Row="7" Grid.Column="2" Header="{l:Loc Settings_Home}" Icon="Home" ui:Reveal.Delay="380" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel Margin="6,4,6,6">
                    <TextBlock Text="{l:Loc Settings_HomeHint}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DockPanel Margin="0,6,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HomeShowToday}" AutomationProperties.Name="{l:Loc Settings_HomeToday}" /><TextBlock Text="{l:Loc Settings_HomeToday}" Style="{StaticResource Text.Item}" VerticalAlignment="Center" /></DockPanel>
                    <DockPanel Margin="0,10,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HomeShowTasks}" AutomationProperties.Name="{l:Loc Settings_HomeTasks}" /><TextBlock Text="{l:Loc Settings_HomeTasks}" Style="{StaticResource Text.Item}" VerticalAlignment="Center" /></DockPanel>
                    <DockPanel Margin="0,10,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HomeShowDeadline}" AutomationProperties.Name="{l:Loc Settings_HomeDeadline}" /><TextBlock Text="{l:Loc Settings_HomeDeadline}" Style="{StaticResource Text.Item}" VerticalAlignment="Center" /></DockPanel>
                    <DockPanel Margin="0,10,0,0"><CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HomeShowPinnedNote}" AutomationProperties.Name="{l:Loc Settings_HomePinned}" /><TextBlock Text="{l:Loc Settings_HomePinned}" Style="{StaticResource Text.Item}" VerticalAlignment="Center" /></DockPanel>
                </StackPanel>
            </ui:ArcadiaPanel>
            <ui:ArcadiaPanel Grid.Row="8" Header="{l:Loc Settings_FinanceTitle}" Icon="Finance" ui:Reveal.Delay="400" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel Margin="6,4,6,6">
                    <TextBlock Text="{l:Loc Settings_FinanceHint}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Settings_FinNumberFormat}" Style="{StaticResource FieldLabel}" />
