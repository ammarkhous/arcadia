<UserControl x:Class="Arcadia.App.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:vm="clr-namespace:Arcadia.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModulePlaceholderViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Background="#05070A" CornerRadius="5" Padding="1" ui:Reveal.Delay="0" VerticalAlignment="Top">
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Banner -->
                    <Grid ClipToBounds="True">
                        <ui:ArtworkPresenter Theme="{Binding ArtTheme}" Seed="{Binding Seed}" Vignette="0.4" BottomShade="0.9" CornerRadius="3" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#E00B1018" />
                                    <GradientStop Offset="0.55" Color="#400B1018" />
                                    <GradientStop Offset="1" Color="#000B1018" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- framed illustration, like a module screenshot -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0" Width="300" Height="190" Style="{StaticResource ArtworkWell}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" />
                            </Border.Effect>
                            <ui:ModuleIllustration Icon="{Binding Icon}" SecondaryIcon="{Binding SecondaryIcon}" Tone="{Binding Tone, Converter={StaticResource ToneToColor}}" Seed="{Binding Seed}" Glow="0.6" />
                        </Border>

                        <StackPanel VerticalAlignment="Bottom" Margin="34,0,380,28">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="54" Height="54">
                                    <Ellipse Stroke="#40FFFFFF" StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                                <GradientStop Offset="0" Color="#2D4A7A" />
                                                <GradientStop Offset="1" Color="#0B1322" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <ui:ArcadiaIcon Kind="{Binding Icon}" Width="28" Height="28" />
                                </Grid>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="32" Effect="{StaticResource TextOnArt}" />
                                    <ui:ArcadiaStatusIndicator HorizontalAlignment="Left" Margin="0,6,0,0" Text="{l:Loc Placeholder_Status}" Tone="#8E6A2A" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,14,0,0" Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontSize="14" LineHeight="20" Foreground="#D6DEEA"
                                       Effect="{StaticResource TextOnArt}" />
                        </StackPanel>
                    </Grid>

                    <!-- Roadmap -->
                    <StackPanel Grid.Row="1" Margin="34,22,34,28">
                        <TextBlock Text="{l:Loc Placeholder_Intro}" Style="{StaticResource Text.Label}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Features}" Focusable="False" MaxWidth="760" HorizontalAlignment="Left" MinWidth="520">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoadmapItem}">
                                    <Border Margin="0,0,0,8" Background="#0B1018" BorderBrush="#1E2A3C" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#101826" BorderBrush="#1E2A3C" BorderThickness="0,0,1,0">
                                                <TextBlock Text="{Binding Number}"
                                                           FontFamily="{StaticResource Font.Display}" FontSize="16" Foreground="{StaticResource Brush.Cyan}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="14,11" Text="{Binding Text}" Style="{StaticResource Text.Base}" FontSize="13.5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:ArcadiaButton Margin="0,10,0,0" HorizontalAlignment="Left" Icon="Home" Content="{l:Loc Placeholder_Back}" Command="{Binding BackCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </ScrollViewer>
</UserControl>
