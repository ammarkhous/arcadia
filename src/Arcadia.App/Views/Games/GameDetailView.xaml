<UserControl x:Class="Arcadia.App.Views.Games.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:games="clr-namespace:Arcadia.App.ViewModels.Games"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance games:GameDetailViewModel}">

    <UserControl.Resources>
        <ContextMenu x:Key="MoreMenu">
            <MenuItem Header="{l:Loc Game_SetFeatured}" Command="{Binding SetFeaturedCommand}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Star" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Loc Game_ImportScreenshots}" Command="{Binding ImportScreenshotsCommand}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Import" Width="14" Height="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator Background="#26344A" Margin="4" />
            <MenuItem Header="{l:Loc Game_Delete}" Command="{Binding DeleteCommand}">
                <MenuItem.Icon><ui:ArcadiaIcon Kind="Trash" Width="14" Height="14" Foreground="#FF8A8E" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="ReadoutValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- ═══════════ HERO ═══════════ -->
                <Border x:Name="HeroBorder" Background="#05070A" CornerRadius="5" Padding="1" ui:Reveal.Delay="0">
                    <Grid x:Name="HeroFrame" Height="360" ClipToBounds="True">
                        <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" ImagePath="{Binding HeroImagePath}" Vignette="0.35" BottomShade="0.9" CornerRadius="4"
                                             AutomationProperties.Name="{Binding Title}" />
                        <Rectangle RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#C0080B11" />
                                    <GradientStop Offset="0.55" Color="#20080B11" />
                                    <GradientStop Offset="1" Color="#00080B11" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <ui:ArcadiaButton Variant="Link" Icon="ChevronLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,14,0,0"
                                          Content="{l:Loc Games_Back}" Foreground="#DDE6F2" FontSize="13" TrailingIcon="{x:Null}"
                                          Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />

                        <Grid VerticalAlignment="Bottom" Margin="28,0,24,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ArcadiaStatusIndicator Text="{Binding StatusText}" Tone="{Binding StatusTone, Converter={StaticResource ToneToColor}}" />
                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="#C00A0F18" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Platform}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsFeatured, Converter={StaticResource BoolToVisibility}}">
                                        <ui:ArcadiaIcon Kind="Star" Width="14" Height="14" Foreground="{StaticResource Brush.Gold}" />
                                        <TextBlock Margin="5,0,0,0" Text="{l:Loc Game_IsFeatured}" Style="{StaticResource Text.Meta}" Foreground="#F4C451" />
                                    </StackPanel>
                                </StackPanel>
                                <ui:ArtworkPresenter Margin="0,10,0,0" ImagePath="{Binding LogoPath}" ShowScene="False" Stretch="Uniform" Vignette="0" CornerRadius="0"
                                                     MaxWidth="420" Height="96" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Title}"
                                                     Visibility="{Binding LogoPath, Converter={StaticResource HasValue}}" />
                                <TextBlock Margin="0,8,0,0" ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="34" Effect="{StaticResource TextOnArt}"
                                           Visibility="{Binding LogoPath, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Tags}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Background="#C0161E2B">
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ui:ArcadiaButton Variant="Primary" Icon="Play" IconSize="16" FontSize="15" MinHeight="40" Padding="18,6" Content="{Binding PrimaryActionText}" Command="{Binding LaunchCommand}" />
                                <ui:ArcadiaButton Margin="8,0,0,0" Icon="Clock" MinHeight="40" Content="{l:Loc Game_LogSession}" Command="{Binding LogSessionCommand}" />
                                <ui:ArcadiaButton Margin="8,0,0,0" Icon="Search" MinHeight="40" Content="{l:Loc Game_FindOnline}" Command="{Binding FindOnlineCommand}" />
                                <ui:ArcadiaButton Margin="8,0,0,0" Icon="Journal" MinHeight="40" Content="{l:Loc Game_Edit}" Command="{Binding EditCommand}" />
                                <ui:ArcadiaButton x:Name="MoreButton" Margin="8,0,0,0" Icon="ChevronDown" IconSize="13" MinHeight="40" Width="42" Padding="0" Click="OnMore"
                                                  ToolTip="{l:Loc Home_MoreActions}" AutomationProperties.Name="{l:Loc Home_MoreActions}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══════════ READOUTS ═══════════ -->
                <Grid Margin="0,10,-8,0" ui:Reveal.Delay="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Readout}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{l:Loc Home_Progress}" Style="{StaticResource Text.Caps}" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Numeric}" HorizontalAlignment="Right" />
                            </Grid>
                            <ui:ArcadiaProgressBar Margin="0,9,0,0" Height="9" Value="{Binding Progress}" Tone="{Binding ProgressTone, Converter={StaticResource ToneToColor}}" AutomationProperties.Name="{l:Loc Home_Progress}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Readout}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Home_Playtime}" Style="{StaticResource Text.Caps}" />
                            <TextBlock Text="{Binding Playtime}" Style="{StaticResource ReadoutValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Readout}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Game_Sessions}" Style="{StaticResource Text.Caps}" />
                            <TextBlock Text="{Binding SessionCount}" Style="{StaticResource ReadoutValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Readout}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Home_Achievements}" Style="{StaticResource Text.Caps}" />
                            <TextBlock Text="{Binding Achievements}" Style="{StaticResource ReadoutValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Readout}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Games_ColLastPlayed}" Style="{StaticResource Text.Caps}" />
                            <TextBlock Text="{Binding LastPlayed}" Style="{StaticResource ReadoutValue}" FontSize="15" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource Readout}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Game_Estimated}" Style="{StaticResource Text.Caps}" />
                            <TextBlock Text="{Binding Estimated}" Style="{StaticResource ReadoutValue}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════ TABS ═══════════ -->
                <Border Background="#05070A" CornerRadius="5" Padding="1" Margin="0,10,0,0" ui:Reveal.Delay="120">
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Bevel}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Grid Margin="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource TabButton}" GroupName="GameTabs" IsChecked="{Binding IsOverviewTab}" Content="{l:Loc Game_TabOverview}" />
                                    <RadioButton Style="{StaticResource TabButton}" GroupName="GameTabs" IsChecked="{Binding IsSessionsTab}">
                                        <TextBlock><Run Text="{l:Loc Game_TabSessions}" /><Run Text="  " /><Run Text="{Binding Sessions.Count, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Muted}" /></TextBlock>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TabButton}" GroupName="GameTabs" IsChecked="{Binding IsJournalTab}">
                                        <TextBlock><Run Text="{l:Loc Game_TabJournal}" /><Run Text="  " /><Run Text="{Binding Journal.Count, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Muted}" /></TextBlock>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TabButton}" GroupName="GameTabs" IsChecked="{Binding IsScreenshotsTab}">
                                        <TextBlock><Run Text="{l:Loc Game_TabScreenshots}" /><Run Text="  " /><Run Text="{Binding Screenshots.Count, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Muted}" /></TextBlock>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource EtchedDivider}" />

                            <Grid Margin="18,16,18,18" MinHeight="260">
                                <!-- Overview -->
                                <Grid Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Game_Description}" Style="{StaticResource FieldLabel}" />
                                        <TextBlock ui:Bidi.Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="13.5" LineHeight="21"
                                                   Visibility="{Binding Description, Converter={StaticResource HasValue}}" />
                                        <TextBlock Text="{l:Loc Game_NoDescription}" Style="{StaticResource Text.Meta}"
                                                   Visibility="{Binding Description, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <Grid Margin="0,18,0,0" Visibility="{Binding IsMatchedOnline, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{l:Loc Game_Developer}" Style="{StaticResource FieldLabel}" />
                                                <TextBlock ui:Bidi.Text="{Binding Developer}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{l:Loc Game_Publisher}" Style="{StaticResource FieldLabel}" />
                                                <TextBlock ui:Bidi.Text="{Binding Publisher}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{l:Loc Game_Released}" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding Released}" Style="{StaticResource Text.Base}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,20,0,0" Text="{l:Loc Home_CurrentQuest}" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ArcadiaIcon Kind="Flag" Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock ui:Bidi.Text="{Binding Objective}" Style="{StaticResource Text.Base}" FontSize="14" />
                                        </StackPanel>
                                        <TextBlock Margin="0,20,0,0" Text="{l:Loc Game_LaunchTarget}" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding LaunchTarget, Converter={StaticResource HasValue}}">
                                            <ui:ArcadiaIcon Kind="External" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding LaunchTarget}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                                                       FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Loc Game_NoLaunchTarget}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap"
                                                   Visibility="{Binding LaunchTarget, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <TextBlock Margin="0,20,0,0" Text="{l:Loc Game_Tracking}" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Visibility="{Binding InstallDirectory, Converter={StaticResource HasValue}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ArcadiaIcon Kind="Documents" Width="14" Height="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding InstallDirectory}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                                                           FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" Text="{l:Loc Game_TrackingFolder}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Loc Game_TrackingLearn}" Style="{StaticResource Text.Meta}" TextWrapping="Wrap"
                                                   Visibility="{Binding InstallDirectory, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <TextBlock Margin="0,20,0,0" Text="{l:Loc Game_Added}" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Added}" Style="{StaticResource Text.Base}" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <Border Style="{StaticResource ArtworkWell}" Height="220" Visibility="{Binding BoxArtPath, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                            <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" ImagePath="{Binding CoverImagePath}" Vignette="0.3" />
                                        </Border>
                                        <Border Style="{StaticResource ArtworkWell}" Width="240" Height="360" HorizontalAlignment="Right"
                                                Visibility="{Binding BoxArtPath, Converter={StaticResource HasValue}}">
                                            <ui:ArtworkPresenter Theme="{Binding Theme}" Seed="{Binding Seed}" ImagePath="{Binding BoxArtPath}" Vignette="0" />
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Sessions -->
                                <Grid Visibility="{Binding IsSessionsTab, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#0A0E15" BorderBrush="#1C2738" BorderThickness="1" CornerRadius="3" Padding="16,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="110" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{l:Loc Game_Activity}" Style="{StaticResource Text.Caps}" />
                                                <TextBlock Text="{Binding LoggedSummary}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Activity}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type games:ActivityBarViewModel}">
                                                        <Grid Margin="4,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                                            <ui:ActivityBar Hours="{Binding Hours}" MaxHours="{Binding DataContext.ActivityMax, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding Activity}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type games:ActivityBarViewModel}">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Meta}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="None" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                        <TextBlock Text="{l:Loc Game_NoSessions}" Style="{StaticResource Text.Meta}" Margin="4,6"
                                                   Visibility="{Binding Sessions.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type games:SessionItemViewModel}">
                                                    <Border BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,0,0,1" Padding="4,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="200" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ui:ArcadiaIcon Kind="Clock" Width="15" Height="15" Margin="0,0,12,0" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Day}" Style="{StaticResource Text.Base}" />
                                                                <TextBlock Margin="8,0,0,0" Text="{Binding Time}" Style="{StaticResource Text.Meta}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Duration}" Style="{StaticResource Text.Numeric}" />
                                                                <Border Margin="8,0,0,0" Style="{StaticResource Chip}" Background="#1A34C76A" BorderBrush="#5534C76A" Padding="5,0,5,1"
                                                                        Visibility="{Binding Session.IsAutomatic, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="{l:Loc Session_Auto}" FontSize="10.5" Foreground="#8FE3B0" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" ui:Bidi.Text="{Binding Note}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <ui:ArcadiaButton Grid.Column="4" Variant="Tool" Icon="Trash" IconSize="14" Width="28" Height="28"
                                                                              Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                              ToolTip="{l:Loc Game_DeleteSession}" AutomationProperties.Name="{l:Loc Game_DeleteSession}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- Journal -->
                                <StackPanel Visibility="{Binding IsJournalTab, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="NoteBox" Style="{StaticResource TextArea}" MinHeight="64" MaxHeight="140"
                                                     Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Game_AddNote}" />
                                            <TextBlock Margin="10,7" Text="{l:Loc Game_JournalPlaceholder}" Style="{StaticResource Text.Meta}" IsHitTestVisible="False" TextWrapping="Wrap"
                                                       Visibility="{Binding Text, ElementName=NoteBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        </Grid>
                                        <ui:ArcadiaButton Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Variant="Primary" Icon="Plus" Content="{l:Loc Game_AddNote}"
                                                          Command="{Binding AddNoteCommand}" MinHeight="34" />
                                    </Grid>
                                    <TextBlock Margin="4,16" Text="{l:Loc Game_NoJournal}" Style="{StaticResource Text.Meta}"
                                               Visibility="{Binding Journal.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Journal}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type games:JournalItemViewModel}">
                                                <Border x:Name="card" Margin="0,0,0,8" Padding="12,9" CornerRadius="3" Background="#0A0E15" BorderBrush="#1C2738" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:ArcadiaIcon x:Name="pin" Kind="Journal" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,12,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock ui:Bidi.Text="{Binding Text}" Style="{StaticResource Text.Base}" FontSize="13.5" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding When}" Style="{StaticResource Text.Meta}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <ui:ArcadiaButton x:Name="pinButton" Variant="Tool" Icon="Pin" IconSize="14" Width="28" Height="28"
                                                                              Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                              ToolTip="{l:Loc Game_Pin}" AutomationProperties.Name="{l:Loc Game_Pin}" />
                                                            <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="14" Width="28" Height="28"
                                                                              Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                              ToolTip="{l:Loc Game_DeleteNote}" AutomationProperties.Name="{l:Loc Game_DeleteNote}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter TargetName="card" Property="BorderBrush" Value="#4045D2FF" />
                                                        <Setter TargetName="pin" Property="Kind" Value="Pin" />
                                                        <Setter TargetName="pin" Property="Foreground" Value="{StaticResource Brush.Icon.Accent}" />
                                                        <Setter TargetName="pinButton" Property="ToolTip" Value="{l:Loc Game_Unpin}" />
                                                        <Setter TargetName="pinButton" Property="Foreground" Value="#7CC4FF" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Screenshots -->
                                <StackPanel Visibility="{Binding IsScreenshotsTab, Converter={StaticResource BoolToVisibility}}">
                                    <ui:ArcadiaButton HorizontalAlignment="Left" Variant="Primary" Icon="Import" Content="{l:Loc Game_ImportScreenshots}" Command="{Binding ImportScreenshotsCommand}" MinHeight="34" />
                                    <TextBlock Margin="4,16" Text="{l:Loc Game_NoScreenshots}" Style="{StaticResource Text.Meta}"
                                               Visibility="{Binding Screenshots.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                    <ItemsControl Margin="-6,12,-6,0" ItemsSource="{Binding Screenshots}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type games:ScreenshotItemViewModel}">
                                                <StackPanel Width="260" Margin="6,0,6,14">
                                                    <Button Style="{StaticResource GameCardButton}" Height="150"
                                                            Command="{Binding DataContext.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <ui:ArtworkPresenter Margin="3" Theme="{Binding Theme}" Seed="{Binding Seed}" ImagePath="{Binding ThumbnailPath}" Vignette="0.2" />
                                                    </Button>
                                                    <Grid Margin="2,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" />
                                                            <TextBlock Style="{StaticResource Text.Meta}"><Run Text="{Binding Date, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Location, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <ui:ArcadiaButton Variant="Tool" Icon="Journal" IconSize="13" Width="26" Height="26"
                                                                              Command="{Binding DataContext.EditScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                              ToolTip="{l:Loc Game_EditScreenshot}" AutomationProperties.Name="{l:Loc Game_EditScreenshot}" />
                                                            <ui:ArcadiaButton Variant="Tool" Icon="Trash" IconSize="13" Width="26" Height="26"
                                                                              Command="{Binding DataContext.DeleteScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                              ToolTip="{l:Loc Game_DeleteScreenshot}" AutomationProperties.Name="{l:Loc Game_DeleteScreenshot}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ DROP TARGET ═══════════ -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#C0061226" CornerRadius="5"
                BorderBrush="#7CC4FF" BorderThickness="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ArcadiaIcon Kind="Import" Width="46" Height="46" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,0" Text="{l:Loc Drop_Screenshots}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══════════ SCREENSHOT VIEWER ═══════════ -->
        <Grid Background="#F2030508" Visibility="{Binding ViewerItem, Converter={StaticResource HasValue}}" Focusable="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Margin="70,24,70,10" Style="{StaticResource ArtworkWell}">
                <ui:ArtworkPresenter Theme="{Binding ViewerItem.Theme}" Seed="{Binding ViewerItem.Seed}" ImagePath="{Binding ViewerItem.ImagePath}" Vignette="0" CornerRadius="3" />
            </Border>
            <ui:ArcadiaButton Variant="Tool" Icon="ChevronLeft" IconSize="26" Width="48" Height="48" HorizontalAlignment="Left" Margin="12,0,0,0"
                              Command="{Binding PreviousShotCommand}" ToolTip="{l:Loc Game_Previous}" AutomationProperties.Name="{l:Loc Game_Previous}" />
            <ui:ArcadiaButton Variant="Tool" Icon="ChevronRight" IconSize="26" Width="48" Height="48" HorizontalAlignment="Right" Margin="0,0,12,0"
                              Command="{Binding NextShotCommand}" ToolTip="{l:Loc Game_Next}" AutomationProperties.Name="{l:Loc Game_Next}" />
            <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="16" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                              Command="{Binding CloseViewerCommand}" ToolTip="{l:Loc Game_CloseViewer}" AutomationProperties.Name="{l:Loc Game_CloseViewer}" />
            <StackPanel Grid.Row="1" Margin="70,0,70,20">
                <TextBlock ui:Bidi.Text="{Binding ViewerItem.Title}" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Meta}"><Run Text="{Binding ViewerItem.Date, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ViewerItem.Location, Mode=OneWay}" /></TextBlock>
                <TextBlock Margin="0,4,0,0" ui:Bidi.Text="{Binding ViewerItem.Note}" Style="{StaticResource Text.Body}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
