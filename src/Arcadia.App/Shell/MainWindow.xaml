<Window x:Class="Arcadia.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="urn:arcadia-ui"
        xmlns:l="clr-namespace:Arcadia.App.Localization"
        xmlns:vm="clr-namespace:Arcadia.App.ViewModels"
        xmlns:svc="clr-namespace:Arcadia.App.Services"
        xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
        xmlns:orv="clr-namespace:Arcadia.App.Views.Oracle"
        Title="Arcadia"
        Icon="/Arcadia;component/Assets/arcadia.ico"
        Width="1600" Height="960" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Body}"
        FlowDirection="{Binding FlowDirection, Source={x:Static l:LocalizationManager.Instance}}"
        Language="{Binding XmlLanguage, Source={x:Static l:LocalizationManager.Instance}}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <!-- The whole header banner is the caption (drag / double-click to maximize) -->
        <WindowChrome CaptionHeight="142" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewInContextCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveInContextCommand}" />
        <KeyBinding Key="H" Modifiers="Control+Shift" Command="{Binding TogglePrivacyCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" Background="{StaticResource Brush.Window}" BorderBrush="#1C2738" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="142" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════ HEADER BANNER ═══════════════════════ -->
            <Grid x:Name="Header" ClipToBounds="True">
                <ui:ArtworkPresenter Theme="arcadia-header" Seed="7" Vignette="0" CornerRadius="0" AutomationProperties.Name="Arcadia" />

                <!-- legibility scrims: left for branding, right for utilities, bottom to melt into the window -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#E606080C" />
                            <GradientStop Offset="0.2" Color="#9906080C" />
                            <GradientStop Offset="0.36" Color="#0006080C" />
                            <GradientStop Offset="0.7" Color="#0006080C" />
                            <GradientStop Offset="0.84" Color="#8C06080C" />
                            <GradientStop Offset="1" Color="#D906080C" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3006080C" />
                            <GradientStop Offset="0.25" Color="#0006080C" />
                            <GradientStop Offset="0.75" Color="#0006080C" />
                            <GradientStop Offset="1" Color="#D006080C" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- lit hairline where the banner meets the console -->
                <Border Height="1" VerticalAlignment="Bottom">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#002F7BFF" />
                            <GradientStop Offset="0.2" Color="#992F7BFF" />
                            <GradientStop Offset="0.6" Color="#442F7BFF" />
                            <GradientStop Offset="1" Color="#002F7BFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,16,0,0">
                    <ui:ArcadiaIcon Kind="Logo" Width="58" Height="58" VerticalAlignment="Top" Margin="0,2,0,0"
                                    Foreground="{StaticResource Brush.Gold}" AccentBrush="{StaticResource Brush.Icon.Accent}">
                        <ui:ArcadiaIcon.Effect>
                            <DropShadowEffect Color="#F2B64A" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                        </ui:ArcadiaIcon.Effect>
                    </ui:ArcadiaIcon>
                    <StackPanel Margin="16,0,0,0">
                        <ui:ArcadiaWordmark Text="ARCADIA" FontSize="46" Tracking="0.11" HorizontalAlignment="Left" AutomationProperties.Name="Arcadia" />
                        <TextBlock Margin="2,1,0,0" Text="{l:Loc App_Tagline}" FontFamily="{StaticResource Font.Display}" FontSize="11" Foreground="#8FD8FF"
                                   Opacity="0.85" Effect="{StaticResource TextOnArt}" />
                        <StackPanel Orientation="Horizontal" Margin="2,6,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel.Resources>
                                <Style x:Key="Dot" TargetType="Ellipse">
                                    <Setter Property="Width" Value="3" />
                                    <Setter Property="Height" Value="3" />
                                    <Setter Property="Fill" Value="#8FD8FF" />
                                    <Setter Property="Margin" Value="9,1,9,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_Games}" Command="{Binding NavigateCommand}" CommandParameter="games" />
                            <Ellipse Style="{StaticResource Dot}" />
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_ITTools}" Command="{Binding NavigateCommand}" CommandParameter="ittools" />
                            <Ellipse Style="{StaticResource Dot}" />
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_Projects}" Command="{Binding NavigateCommand}" CommandParameter="projects" />
                            <Ellipse Style="{StaticResource Dot}" />
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_Documents}" Command="{Binding NavigateCommand}" CommandParameter="documents" />
                            <Ellipse Style="{StaticResource Dot}" />
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_Travel}" Command="{Binding NavigateCommand}" CommandParameter="travel" />
                            <Ellipse Style="{StaticResource Dot}" />
                            <Button Style="{StaticResource CategoryLink}" Content="{l:Loc Cat_Oracle}" Command="{Binding NavigateCommand}" CommandParameter="oracle" />
                        </StackPanel>
</StackPanel>
                </StackPanel>

                <!-- Hand-lettered motto over the artwork -->
                <TextBlock x:Name="Motto" Style="{StaticResource Text.Script}" FontSize="20" LineHeight="23" LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,450,0" Opacity="0.92" Effect="{StaticResource TextOnArt}"
                           IsHitTestVisible="False">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-11" />
                    </TextBlock.RenderTransform>
                    <Run Text="{l:Loc Motto_1}" /><LineBreak /><Run Text="   " /><Run Text="{l:Loc Motto_2}" /><LineBreak /><Run Text="      " /><Run Text="{l:Loc Motto_3}" /><LineBreak /><Run Text="         " /><Run Text="{l:Loc Motto_4}" />
                </TextBlock>

                <!-- Utility cluster -->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- caption buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" FlowDirection="LeftToRight">
                        <Border Background="#8006080C" BorderBrush="#26344A" BorderThickness="1,0,0,1" CornerRadius="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="{l:Loc Window_Minimize}" AutomationProperties.Name="{l:Loc Window_Minimize}">
                                    <ui:ArcadiaIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="#D8E0EC" />
                                </Button>
                                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" AutomationProperties.Name="{l:Loc Window_Maximize}">
                                    <ui:ArcadiaIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="16" Height="16" Foreground="#D8E0EC" />
                                </Button>
                                <Button Style="{StaticResource CaptionButton.Close}" Click="OnClose" ToolTip="{l:Loc Window_Close}" AutomationProperties.Name="{l:Loc Window_Close}">
                                    <ui:ArcadiaIcon Kind="WindowClose" Width="16" Height="16" Foreground="#D8E0EC" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- weather + clock -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                        <StackPanel Visibility="{Binding Header.HasWeather, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"
                                    ToolTip="{Binding Header.WeatherTooltip}" WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ui:ArcadiaIcon Kind="MapPin" Width="13" Height="13" Foreground="#DDE6F2" />
                                <TextBlock Margin="5,0,0,0" ui:Bidi.Text="{Binding Header.WeatherLocation}" FontSize="12.5" Foreground="#E6ECF5" Effect="{StaticResource TextOnArt}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ui:ArcadiaIcon Kind="Weather" Width="26" Height="26" AccentBrush="{StaticResource Brush.Gold}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Header.WeatherTemperature}" FontFamily="{StaticResource Font.Display}" FontSize="22"
                                           VerticalAlignment="Center" Effect="{StaticResource TextOnArt}" />
                                <TextBlock Margin="10,3,0,0" Text="{Binding Header.WeatherCondition}" FontSize="12" Foreground="#C5CFDD" VerticalAlignment="Center" Effect="{StaticResource TextOnArt}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Width="1" Margin="18,2" Background="#40FFFFFF" Visibility="{Binding Header.HasWeather, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel VerticalAlignment="Center" MinWidth="116">
                            <TextBlock Text="{Binding Header.Time}" FontFamily="{StaticResource Font.Display}" FontSize="30" HorizontalAlignment="Center"
                                       Margin="0,-4,0,-2" Effect="{StaticResource TextOnArt}" />
                            <TextBlock Text="{Binding Header.Date}" FontSize="12.5" Foreground="#DDE4EE" HorizontalAlignment="Center" Effect="{StaticResource TextOnArt}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- search, notifications, settings, profile -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,12" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Now playing: live session plate -->
                        <Border Margin="0,0,12,0" Height="30" CornerRadius="15" Padding="4,0,2,0" VerticalAlignment="Center"
                                Background="#E0071A12" BorderBrush="#6634C76A" BorderThickness="1"
                                Visibility="{Binding NowPlaying.IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding OpenNowPlayingCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource Arcadia.FocusVisual}"
                                        ToolTip="{l:Loc Home_Details}" AutomationProperties.Name="{l:Loc Tracking_NowPlaying}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel Orientation="Horizontal" Background="Transparent" Margin="6,0,6,0">
                                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                    <!-- the pulse runs only while a game plays and the window can be seen (no animation clock otherwise) -->
                                                    <Ellipse x:Name="halo" Fill="#5534C76A">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding NowPlaying.IsPlaying}" Value="True" />
                                                                            <Condition Binding="{Binding IsWindowShown}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="HaloPulse">
                                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.9" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                        <MultiDataTrigger.ExitActions>
                                                                            <StopStoryboard BeginStoryboardName="HaloPulse" />
                                                                        </MultiDataTrigger.ExitActions>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="7" Height="7" Fill="#4BE38A" />
                                                </Grid>
                                                <TextBlock Margin="8,0,0,0" Text="{l:Loc Tracking_NowPlaying}" Style="{StaticResource Text.Caps}" Foreground="#8FE3B0" VerticalAlignment="Center" />
                                                <TextBlock Margin="8,0,0,0" ui:Bidi.Text="{Binding NowPlaying.Title}" FontSize="12.5" Foreground="White" MaxWidth="180"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Margin="8,0,0,0" Text="{Binding NowPlaying.Elapsed}" FontFamily="{StaticResource Font.Display}" FontSize="13"
                                                           Foreground="#8FE3B0" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="10" Width="24" Height="24" Command="{Binding StopTrackingCommand}"
                                                  ToolTip="{l:Loc Tracking_Stop}" AutomationProperties.Name="{l:Loc Tracking_Stop}" />
                            </StackPanel>
                        </Border>
                        <Grid Width="250" Height="30" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Padding="28,0,8,0" AutomationProperties.Name="{l:Loc Header_Search}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" CommandParameter="{Binding Text, ElementName=SearchBox}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
                            <TextBlock Text="{l:Loc Header_Search}" Margin="29,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                        <Grid Margin="12,0,0,0">
                            <ui:ArcadiaButton x:Name="BellButton" Variant="Tool" Icon="Bell" Command="{Binding ShowNotificationsCommand}"
                                              ToolTip="{l:Loc Header_Notifications}" AutomationProperties.Name="{l:Loc Header_Notifications}" />
                            <!-- unread reminders -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Background="#1F8FD8"
                                    BorderBrush="#05070A" BorderThickness="1" IsHitTestVisible="False" Visibility="{Binding NotificationCenter.Unread, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding NotificationCenter.Unread}" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Popup IsOpen="{Binding IsNotificationsOpen}" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-300">
                                <Border Width="360" Background="#05070A" CornerRadius="6" Padding="1" Margin="6">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.7" /></Border.Effect>
                                    <Border BorderBrush="#3A5A8C" BorderThickness="1" CornerRadius="5" Background="{StaticResource Brush.Raised}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="12,9,10,7">
                                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Rem_ClearAll}" Command="{Binding ClearNoticesCommand}" />
                                                <TextBlock Text="{l:Loc Rem_Recent}" Style="{StaticResource Text.Caps}" FontSize="10.5" Foreground="#7FA9C8" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border DockPanel.Dock="Top" Height="1" Background="#1E2E44" />
                                            <ItemsControl ItemsSource="{Binding NotificationCenter.Items}" Focusable="False" MaxHeight="360" Margin="0,2,0,4">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type svc:ReminderNotice}">
                                                        <Border BorderBrush="#16222F" BorderThickness="0,0,0,1">
                                                            <DockPanel>
                                                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Close" IconSize="9" Width="22" Height="22" Margin="0,0,6,0"
                                                                                  Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                                  AutomationProperties.Name="{l:Loc Rem_Dismiss}" />
                                                                <Button Style="{StaticResource ListRowButton}" Padding="12,7" Command="{Binding DataContext.OpenNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding}">
                                                                    <DockPanel>
                                                                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                                        <StackPanel>
                                                                            <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding WhenText}" Style="{StaticResource Text.Meta}" FontSize="11" Foreground="#9FD8FF" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                        <ui:ArcadiaButton Variant="Tool" Icon="Settings" Margin="4,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="settings"
                                          ToolTip="{l:Loc Nav_Settings}" AutomationProperties.Name="{l:Loc Nav_Settings}" />
                        <Button Margin="10,0,0,0" Command="{Binding ShowProfileCommand}" Cursor="Hand" ToolTip="{Binding Header.UserName}"
                                AutomationProperties.Name="{l:Loc Header_Profile}" FocusVisualStyle="{StaticResource Arcadia.FocusVisual}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="38" Height="38">
                                        <Ellipse x:Name="ring" StrokeThickness="2">
                                            <Ellipse.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#9FD8FF" />
                                                    <GradientStop Offset="1" Color="#1F5FE0" />
                                                </LinearGradientBrush>
                                            </Ellipse.Stroke>
                                        </Ellipse>
                                        <Ellipse Margin="3">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                                    <GradientStop Offset="0" Color="#3A4E6E" />
                                                    <GradientStop Offset="1" Color="#131B28" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Header.UserInitial}" FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ring" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#45D2FF" BlurRadius="10" ShadowDepth="0" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══════════════════════ BODY ═══════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="214" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ─── Sidebar console ─── -->
                <Border Background="{StaticResource Brush.Nav.Rail}" BorderBrush="#03050A" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="1" HorizontalAlignment="Right" Background="#1C2738" Grid.RowSpan="2" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Margin="0,12,0,8" AutomationProperties.Name="{l:Loc Nav_Label}" KeyboardNavigation.DirectionalNavigation="Contained">
                                <ItemsControl ItemsSource="{Binding PrimaryItems}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                            <ui:ArcadiaNavigationItem Content="{Binding Label}" Icon="{Binding Icon}" Badge="{Binding Badge}"
                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                      IsCompact="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding Key}"
                                                                      ToolTip="{Binding Label}" ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      AutomationProperties.Name="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource EtchedDivider}" Margin="22,12" />
                                <ItemsControl ItemsSource="{Binding SecondaryItems}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                            <ui:ArcadiaNavigationItem Content="{Binding Label}" Icon="{Binding Icon}" Badge="{Binding Badge}"
                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                      IsCompact="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding Key}"
                                                                      ToolTip="{Binding Label}" ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      AutomationProperties.Name="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- scenic footer -->
                        <Grid x:Name="SidebarFooter" Grid.Row="1" Height="230" ClipToBounds="True" IsHitTestVisible="False">
                            <ui:SceneArtwork Theme="sidebar-forest" Seed="5" Vignette="0.1" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FF090D14" />
                                        <GradientStop Offset="0.3" Color="#00090D14" />
                                        <GradientStop Offset="0.8" Color="#00090D14" />
                                        <GradientStop Offset="1" Color="#99090D14" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="SidebarMotto" Text="{l:Loc Sidebar_Motto}" Style="{StaticResource Text.Script}" FontSize="17" LineHeight="26"
                                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="30,0,0,18"
                                       Effect="{StaticResource TextOnArt}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="-9" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ─── Content ─── -->
                <ui:TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="10,10,10,10" Focusable="False" />

                <!-- ─── Toasts ─── -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                            <Border Background="#05070A" CornerRadius="5" Padding="1" Margin="0,8,0,0" ui:Reveal.Delay="0" MaxWidth="420">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" />
                                </Border.Effect>
                                <Border Background="{StaticResource Brush.Raised}" BorderBrush="#3A5A8C" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" Foreground="{StaticResource Brush.Icon.Accent}" AccentBrush="White" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Margin="10,0,12,0" Text="{Binding Message}" Style="{StaticResource Text.Base}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <ui:ArcadiaButton Grid.Column="2" Variant="Tool" Icon="Close" IconSize="10" Width="22" Height="22" VerticalAlignment="Top"
                                                          Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" AutomationProperties.Name="{l:Loc Window_Close}" />
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <!-- ═══════════════════════ QUICK CAPTURE (Ctrl+Shift+N) ═══════════════════════ -->
            <Grid Grid.RowSpan="2" Visibility="{Binding QuickCapture.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#8A020408" MouseLeftButtonDown="OnCaptureBackdrop" />
                <Border Width="580" VerticalAlignment="Top" Margin="0,110,0,0" Background="#05070A" CornerRadius="6" Padding="1" DataContext="{Binding QuickCapture}">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" /></Border.Effect>
                    <Border BorderBrush="#3A5A8C" BorderThickness="1" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#1A2436" />
                                <GradientStop Offset="1" Color="#0C121B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="14,11,12,9">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center"><TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                                    <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CaptureKind" IsChecked="{Binding IsTask}" AutomationProperties.Name="{l:Loc Capture_Task}" Margin="0,0,4,0" Focusable="False">
                                        <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Tasks" Width="12" Height="12" /><TextBlock Text="{l:Loc Capture_Task}" Margin="6,0,0,0" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CaptureKind" IsChecked="{Binding IsNote}" AutomationProperties.Name="{l:Loc Capture_Note}" Margin="0,0,4,0" Focusable="False">
                                        <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Notes" Width="12" Height="12" /><TextBlock Text="{l:Loc Capture_Note}" Margin="6,0,0,0" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CaptureKind" IsChecked="{Binding IsEvent}" AutomationProperties.Name="{l:Loc Capture_Event}" Margin="0,0,0,0" Focusable="False">
                                        <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Calendar" Width="12" Height="12" /><TextBlock Text="{l:Loc Capture_Event}" Margin="6,0,0,0" /></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CaptureKind" IsChecked="{Binding IsExpense}" AutomationProperties.Name="{l:Loc Capture_Expense}" Margin="4,0,0,0" Focusable="False">
                                        <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Receipt" Width="12" Height="12" /><TextBlock Text="{l:Loc Capture_Expense}" Margin="6,0,0,0" /></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <ui:ArcadiaIcon Kind="Bolt" Width="16" Height="16" Foreground="#45D2FF" />
                                <TextBlock Text="{l:Loc Capture_Title}" Style="{StaticResource Text.Caps}" FontSize="11" Foreground="#9FC4E6" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Height="1" Background="#1E2E44" />
                            <Grid Margin="14,10,14,0">
                                <TextBox x:Name="CaptureBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="16" BorderThickness="0" Background="Transparent" MinHeight="34"
                                         TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" ui:Bidi.AutoDirection="True" PreviewKeyDown="OnCaptureKey" AutomationProperties.Name="{l:Loc Capture_Title}" />
                                <TextBlock Text="{l:Loc Capture_Placeholder}" FontSize="15" Margin="3,6,0,0" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=CaptureBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </Grid>
                            <TextBlock Text="{Binding Hint}" Margin="17,4,14,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8FB6D8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HintIsWarning}" Value="True"><Setter Property="Foreground" Value="#E0B060" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DockPanel Margin="14,12,12,11">
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Primary" Icon="Check" IconSize="12" Content="{l:Loc Capture_Save}" Command="{Binding SaveCommand}" MinWidth="96" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Context, Converter={StaticResource HasValue}}">
                                    <CheckBox IsChecked="{Binding Attach}" Content="{l:Loc Capture_AttachTo}" VerticalAlignment="Center" Focusable="False" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    <ContentControl Content="{Binding Context}" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{l:Loc Capture_Keys}" Style="{StaticResource Text.Meta}" FontSize="11" VerticalAlignment="Center"
                                           Visibility="{Binding Context, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
            <!-- ═══════════════════════ ORACLE (Ctrl+Space) ═══════════════════════ -->
            <Grid Grid.RowSpan="2" x:Name="OracleLayer" Visibility="{Binding Oracle.IsOverlayOpen, Converter={StaticResource BoolToVisibility}}" PreviewKeyDown="OnOracleLayerKey">
                <Border Background="#A0020408" MouseLeftButtonDown="OnOracleBackdrop" />
                <Border Width="780" VerticalAlignment="Top" Margin="0,84,0,0" Background="#05070A" CornerRadius="6" Padding="1" DataContext="{Binding Oracle}">
                    <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.75" /></Border.Effect>
                    <Border BorderBrush="#2E6A9E" BorderThickness="1" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#101C2E" />
                                <GradientStop Offset="1" Color="#070B12" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <!-- title strip -->
                            <DockPanel DockPanel.Dock="Top" Margin="14,9,12,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center"><TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ContextText}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#5F7894" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                <ui:ArcadiaIcon Kind="Oracle" Width="16" Height="16" Foreground="#45D2FF" />
                                <TextBlock Text="ORACLE" Style="{StaticResource Text.Caps}" FontSize="11" Foreground="#9FC4E6" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- prompt -->
                            <Grid DockPanel.Dock="Top" Height="54" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="›" FontFamily="Cascadia Mono, Consolas" FontSize="22" Foreground="#45D2FF" VerticalAlignment="Center" />
                                <TextBox x:Name="OracleBox" Grid.Column="1" Margin="10,0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ui:Bidi.AutoDirection="True" PreviewKeyDown="OnOracleKey"
                                         AutomationProperties.Name="{l:Loc Orc_InputName}" AutomationProperties.AutomationId="OracleOverlayInput" />
                                <TextBlock Grid.Column="1" Margin="14,0" Text="{l:Loc Orc_Placeholder}" FontFamily="Cascadia Mono, Consolas" FontSize="14.5" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=OracleBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <ui:ArcadiaLed Grid.Column="2" Width="7" Height="7" Tone="#45D2FF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Style="{StaticResource EtchedDivider}" />
                            <!-- key hints -->
                            <Border DockPanel.Dock="Bottom" Padding="14,7" BorderBrush="#1E2A3C" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:ArcadiaLed Width="6" Height="6" Tone="#5FE3A1" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Loc Orc_OfflineLong}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="Enter" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                        <TextBlock Text="{l:Loc Palette_Run}" Style="{StaticResource Text.Meta}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="↑ ↓" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                        <TextBlock Text="{l:Loc Orc_HistoryHint}" Style="{StaticResource Text.Meta}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="Tab" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                        <TextBlock Text="{l:Loc Orc_ResultsHint}" Style="{StaticResource Text.Meta}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <ui:ArcadiaButton Variant="Link" Content="{l:Loc Orc_OpenConsole}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="oracle" Click="OnOracleBackdropClick" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- latest result, or suggestions -->
                            <ScrollViewer x:Name="OracleResult" MaxHeight="540" VerticalScrollBarVisibility="Auto" Padding="18,12,18,14" Focusable="False">
                                <Grid>
                                    <ContentControl Content="{Binding Latest}" Focusable="False" Visibility="{Binding Latest, Converter={StaticResource HasValue}}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate><orv:OracleResultView /></DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <StackPanel Visibility="{Binding Latest, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                        <TextBlock Text="{l:Loc Orc_TryHeading}" Style="{StaticResource Text.Caps}" FontSize="10.5" Foreground="#6FA6D6" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" Margin="0,1" AutomationProperties.Name="{Binding}"
                                                            Command="{Binding DataContext.Oracle.RunTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bg" Background="Transparent" CornerRadius="2" Padding="6,4">
                                                                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="#9FB6D0" FlowDirection="LeftToRight"><Run Text="›" Foreground="#45D2FF" /> <Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#14233A" /></Trigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="Background" Value="#1A3050" /></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
            <!-- ═══════════════════════ COMMAND PALETTE (Ctrl+K) ═══════════════════════ -->
            <Grid Grid.RowSpan="2" x:Name="PaletteLayer" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#A0020408" MouseLeftButtonDown="OnPaletteBackdrop" />
                <Border Width="680" VerticalAlignment="Top" Margin="0,96,0,0" Background="#05070A" CornerRadius="6" Padding="1" DataContext="{Binding Palette}">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" /></Border.Effect>
                    <Border BorderBrush="#3A5A8C" BorderThickness="1" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#1A2436" />
                                <GradientStop Offset="1" Color="#0C121B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="52" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:ArcadiaIcon Kind="Search" Width="18" Height="18" Foreground="{StaticResource Brush.Icon.Accent}" />
                                <TextBox x:Name="PaletteBox" Grid.Column="1" Margin="10,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Palette_Placeholder}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Down" Command="{Binding MoveDownCommand}" />
                                        <KeyBinding Key="Up" Command="{Binding MoveUpCommand}" />
                                        <KeyBinding Key="Return" Command="{Binding ExecuteCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Grid.Column="1" Margin="14,0" Text="{l:Loc Palette_Placeholder}" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=PaletteBox, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center"><TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                            </Grid>
                            <Border DockPanel.Dock="Top" Style="{StaticResource EtchedDivider}" />
                            <Border DockPanel.Dock="Bottom" Padding="14,7" BorderBrush="#1E2A3C" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="↑ ↓" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                    <TextBlock Text="{l:Loc Palette_Navigate}" Style="{StaticResource Text.Meta}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="Enter" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                    <TextBlock Text="{l:Loc Palette_Run}" Style="{StaticResource Text.Meta}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Chip}" Margin="0,0,5,0"><TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" /></Border>
                                    <TextBlock Text="{l:Loc Palette_Close}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Meta}" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <ui:ArcadiaLed Width="7" Height="7" Margin="10,0,0,0" Tone="#45D2FF" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="PaletteList" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}" MaxHeight="430" Background="Transparent" BorderThickness="0" Padding="6,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseLeftButtonUp="OnPaletteItemClick" AutomationProperties.Name="{l:Loc Palette_Results}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="sel" CornerRadius="3" Opacity="0" Background="{StaticResource Brush.Nav.Selected}" />
                                                        <Border x:Name="edge" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5" Background="{StaticResource Brush.Cyan}" Opacity="0" />
                                                        <ContentPresenter Margin="12,7,12,7" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="sel" Property="Opacity" Value="1" />
                                                            <Setter TargetName="edge" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock ui:Bidi.Text="{Binding Title}" Style="{StaticResource Text.Item}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock ui:Bidi.Text="{Binding Subtitle}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" Visibility="{Binding Subtitle, Converter={StaticResource HasValue}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0" Visibility="{Binding Shortcut, Converter={StaticResource HasValue}}">
                                                    <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </Border>
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caps}" FontSize="10" Foreground="#7F93AE" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>