                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Rec_Frequency}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding Frequency}" MinHeight="30" AutomationProperties.Name="{l:Loc Rec_Frequency}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Rec_FirstDue}" Style="{StaticResource FieldLabel}" />
