            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox Content="{l:Loc Rec_Active}" IsChecked="{Binding IsActive}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,20,0" />
                <CheckBox Content="{l:Loc Rec_OnCalendar}" IsChecked="{Binding ShowOnCalendar}" Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>
            <TextBlock Text="{l:Loc Task_Notes}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource TextArea}" Height="46" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Task_Notes}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource FD.HasValue}}" />
            <DockPanel Margin="0,18,0,0">
                <ui:ArcadiaButton DockPanel.Dock="Left" Icon="Trash" IconSize="12" Content="{l:Loc Confirm_Delete}" Command="{Binding DeleteCommand}" Visibility="{Binding IsNew, Converter={StaticResource FD.HasValue}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                    <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Editor_Save}" Command="{Binding ConfirmCommand}" MinWidth="110" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
