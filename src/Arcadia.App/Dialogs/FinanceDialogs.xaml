    <!-- ═══════════ Goal ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:GoalEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <TextBlock Text="{l:Loc Goal_Name}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="15" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Goal_Name}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="100" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Goal_Target}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontSize="15" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Goal_Target}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Acct_Currency}" Style="{StaticResource FieldLabel}" />
