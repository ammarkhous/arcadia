<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:arcadia-ui"
                    xmlns:l="clr-namespace:Arcadia.App.Localization"
                    xmlns:conv="clr-namespace:Arcadia.App.Converters"
                    xmlns:dialogs="clr-namespace:Arcadia.App.Dialogs"
                    xmlns:fvm="clr-namespace:Arcadia.App.ViewModels.Finance"
                    xmlns:fin="clr-namespace:Arcadia.App.Views.Finance">

    <conv:HasValueToVisibilityConverter x:Key="FD.HasValue" />
    <conv:ToneToColorConverter x:Key="FD.Tone" />
    <fin:InkConverter x:Key="FD.Ink" />
    <conv:InverseBoolConverter x:Key="FD.Not" />

    <!-- a choice with an icon (accounts, categories) -->
    <DataTemplate DataType="{x:Type fvm:FinanceOption}">
        <StackPanel Orientation="Horizontal">
            <ui:ArcadiaIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{Binding Accent, Converter={StaticResource FD.Tone}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- icon and accent pickers shared by the editors -->
    <DataTemplate x:Key="FD.IconChoice">
        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="FinIcon" Margin="0,0,4,4" Width="34" Height="28" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                     Command="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
            <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                    <Binding />
                    <Binding Path="DataContext.Glyph" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                </MultiBinding>
            </RadioButton.IsChecked>
            <ui:ArcadiaIcon Kind="{Binding}" Width="14" Height="14" />
        </RadioButton>
    </DataTemplate>
    <DataTemplate x:Key="FD.AccentChoice">
        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="FinAccent" Margin="0,0,4,4" Height="26" Padding="8,0" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                     Command="{Binding DataContext.ChooseAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
            <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                    <Binding />
                    <Binding Path="DataContext.Accent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                </MultiBinding>
            </RadioButton.IsChecked>
            <Border Width="18" Height="10" CornerRadius="2" Background="{Binding Converter={StaticResource FD.Tone}}" />
        </RadioButton>
    </DataTemplate>

    <!-- ═══════════ Transaction ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:TransactionEditorViewModel}">
        <StackPanel Margin="22,16,22,18" FocusManager.FocusedElement="{Binding ElementName=AmountBox}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="TxnType" IsChecked="{Binding IsExpense}" Margin="0,0,5,0" Height="30" Padding="10,0" AutomationProperties.Name="{l:Loc FinType_Expense}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Expense" Width="13" Height="13" /><TextBlock Text="{l:Loc FinType_Expense}" Margin="7,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="TxnType" IsChecked="{Binding IsIncome}" Margin="0,0,5,0" Height="30" Padding="10,0" AutomationProperties.Name="{l:Loc FinType_Income}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Income" Width="13" Height="13" /><TextBlock Text="{l:Loc FinType_Income}" Margin="7,0,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="TxnType" IsChecked="{Binding IsTransfer}" Height="30" Padding="10,0" AutomationProperties.Name="{l:Loc FinType_Transfer}">
                    <StackPanel Orientation="Horizontal"><ui:ArcadiaIcon Kind="Transfer" Width="13" Height="13" /><TextBlock Text="{l:Loc FinType_Transfer}" Margin="7,0,0,0" /></StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- amount + date -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /><ColumnDefinition Width="8" /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Txn_Amount}" Style="{StaticResource FieldLabel}" />
                    <Border CornerRadius="3" BorderThickness="1" BorderBrush="#2E4462" Background="#0A111B">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrencySymbol}" FontFamily="Bahnschrift, Segoe UI" FontSize="18" Foreground="#7FA9C8" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Bahnschrift, Segoe UI" FontSize="20" BorderThickness="0" Background="Transparent"
                                     MinHeight="38" VerticalContentAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Txn_Amount}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding AmountPreview}" FontSize="11.5" Margin="2,4,0,0" Visibility="{Binding AmountPreview, Converter={StaticResource FD.HasValue}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Org.Time}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmountInvalid}" Value="True"><Setter Property="Foreground" Value="#E0B060" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Txn_Date}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DateInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" FlowDirection="LeftToRight" VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc Txn_Date}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:ArcadiaButton Variant="Link" Content="{l:Loc Cal_Today}" Command="{Binding SetTodayCommand}" Margin="0,0,10,0" />
                        <ui:ArcadiaButton Variant="Link" Content="{l:Loc Cal_Yesterday}" Command="{Binding SetYesterdayCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Txn_Time}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" FlowDirection="LeftToRight" VerticalContentAlignment="Center" AutomationProperties.Name="{l:Loc Txn_Time}" />
                </StackPanel>
            </Grid>

            <!-- account / destination / category -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Txn_Account}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding Account}" MinHeight="30" AutomationProperties.Name="{l:Loc Txn_Account}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding ShowCategory, Converter={StaticResource FD.HasValue}}">
                    <TextBlock Text="{l:Loc Txn_Category}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" MinHeight="30" IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="{l:Loc Txn_Category}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding IsTransfer, Converter={StaticResource FD.HasValue}}">
                    <TextBlock Text="{l:Loc Txn_ToAccount}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding ToAccount}" MinHeight="30" AutomationProperties.Name="{l:Loc Txn_ToAccount}" />
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowToAmount, Converter={StaticResource FD.HasValue}}">
                <TextBlock Text="{l:Loc Txn_ToAmount}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ToCurrencySymbol}" FontFamily="Bahnschrift, Segoe UI" FontSize="14" Foreground="#7FA9C8" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <TextBox Text="{Binding ToAmountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Txn_ToAmount}" />
                </DockPanel>
                <TextBlock Text="{l:Loc Txn_ToAmountHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <!-- what -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Txn_Description}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Txn_Description}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding PayeeLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Payee, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{Binding PayeeLabel}" />
                </StackPanel>
            </Grid>

            <!-- links -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel>
                    <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Txn_PickProject}" Command="{Binding PickProjectCommand}" />
                    <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Close" IconSize="8" Width="18" Height="18" Margin="0,0,6,0" Command="{Binding ClearProjectCommand}"
                                      AutomationProperties.Name="{l:Loc Org_Unlink}" Visibility="{Binding Project, Converter={StaticResource FD.HasValue}}" />
                    <ContentControl Content="{Binding Project}" Focusable="False" HorizontalAlignment="Left" Visibility="{Binding Project, Converter={StaticResource FD.HasValue}}" />
                    <TextBlock Text="{l:Loc Txn_NoProject}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Visibility="{Binding Project, Converter={StaticResource FD.HasValue}, ConverterParameter=invert}" />
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Txn_PickTrip}" Command="{Binding PickTripCommand}" />
                    <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Close" IconSize="8" Width="18" Height="18" Margin="0,0,6,0" Command="{Binding ClearTripCommand}"
                                      AutomationProperties.Name="{l:Loc Org_Unlink}" Visibility="{Binding Trip, Converter={StaticResource FD.HasValue}}" />
                    <ContentControl Content="{Binding Trip}" Focusable="False" HorizontalAlignment="Left" Visibility="{Binding Trip, Converter={StaticResource FD.HasValue}}" />
                    <TextBlock Text="{l:Loc Txn_NoTrip}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Visibility="{Binding Trip, Converter={StaticResource FD.HasValue}, ConverterParameter=invert}" />
                </DockPanel>
            </Grid>

            <!-- more -->
            <ToggleButton Margin="0,12,0,0" HorizontalAlignment="Left" IsChecked="{Binding ShowMore}" Cursor="Hand" AutomationProperties.Name="{l:Loc Txn_More}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ui:ArcadiaIcon x:Name="Chevron" Kind="ChevronRight" Width="10" Height="10" RenderTransformOrigin="0.5,0.5"><ui:ArcadiaIcon.RenderTransform><RotateTransform /></ui:ArcadiaIcon.RenderTransform></ui:ArcadiaIcon>
                            <TextBlock Text="{l:Loc Txn_More}" Margin="7,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <StackPanel Visibility="{Binding ShowMore, Converter={StaticResource FD.HasValue}}" Margin="17,6,0,0">
                <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Tags}" />
                <TextBlock Text="{l:Loc Task_Notes}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                <TextBox Style="{StaticResource TextArea}" Height="54" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Task_Notes}" />
                <DockPanel Margin="0,10,0,0">
                    <ui:ArcadiaButton DockPanel.Dock="Right" Icon="Receipt" IconSize="12" Content="{l:Loc Txn_AttachDocument}" Command="{Binding AttachDocumentCommand}" />
                    <TextBlock Text="{l:Loc Txn_Documents}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Documents}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dialogs:AttachedDocument}">
                            <DockPanel Margin="0,2">
                                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Close" IconSize="8" Width="20" Height="20" Margin="6,0,0,0"
                                                  Command="{Binding DataContext.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{l:Loc Org_Unlink}" />
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Width="120" MinHeight="24" AutomationProperties.Name="{l:Loc Txn_DocumentRole}" />
                                <Button Style="{StaticResource Org.EntryButton}" Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{l:Loc Txn_OpenDocument}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ArcadiaIcon Kind="Documents" Width="13" Height="13" />
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{l:Loc Txn_NeedsReview}" IsChecked="{Binding NeedsReview}" Margin="0,10,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>

            <TextBlock Text="{Binding SavedNote}" Style="{StaticResource Text.Meta}" Foreground="#8CD9A6" Margin="0,10,0,0" Visibility="{Binding SavedNote, Converter={StaticResource FD.HasValue}}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource FD.HasValue}}" />
            <DockPanel Margin="0,18,0,0">
                <ui:ArcadiaButton DockPanel.Dock="Left" Icon="Trash" IconSize="12" Content="{l:Loc Confirm_Delete}" Command="{Binding DeleteCommand}"
                                  Visibility="{Binding IsNew, Converter={StaticResource FD.HasValue}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,10,0" IsCancel="True" />
                    <ui:ArcadiaButton Content="{l:Loc Txn_SaveAndNew}" Command="{Binding SaveAndNewCommand}" MinWidth="110" Margin="0,0,10,0" Visibility="{Binding IsNew, Converter={StaticResource FD.HasValue}}" />
                    <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="120" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Account ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:AccountEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <TextBlock Text="{l:Loc Acct_Name}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="15" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Acct_Name}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="110" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Acct_Type}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" MinHeight="30" AutomationProperties.Name="{l:Loc Acct_Type}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Acct_Currency}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CurrencyOptions}" Text="{Binding Currency, UpdateSourceTrigger=LostFocus}" IsEditable="True" MinHeight="30" IsEnabled="{Binding CurrencyLocked, Converter={StaticResource FD.Not}}"
                              AutomationProperties.Name="{l:Loc Acct_Currency}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Acct_Opening}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding OpeningText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Acct_Opening}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:Loc Acct_CurrencyLocked}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding CurrencyLocked, Converter={StaticResource FD.HasValue}}" />
            <TextBlock Text="{l:Loc Acct_OpeningHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{l:Loc Acct_Description}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource TextArea}" Height="46" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Acct_Description}" />
            <TextBlock Text="{l:Loc Cat_Icon}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding Icons}" ItemTemplate="{StaticResource FD.IconChoice}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{l:Loc Cat_Accent}" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding Accents}" ItemTemplate="{StaticResource FD.AccentChoice}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ui:ArcadiaIcon Kind="Shield" Width="12" Height="12" Opacity="0.8" />
                <TextBlock Text="{l:Loc Acct_NoBankData}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="440" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource FD.HasValue}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Editor_Save}" Command="{Binding ConfirmCommand}" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Budget ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:BudgetEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsTrip, Converter={StaticResource FD.HasValue}}">
                <ui:ArcadiaIcon Kind="Suitcase" Width="14" Height="14" />
                <TextBlock Text="{Binding TripName}" Style="{StaticResource Text.Item}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:Loc Bud_Category}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" MinHeight="30" AutomationProperties.Name="{l:Loc Bud_Category}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="110" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Bud_Amount}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontSize="15" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Bud_Amount}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Acct_Currency}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CurrencyOptions}" Text="{Binding Currency, UpdateSourceTrigger=LostFocus}" IsEditable="True" MinHeight="30" AutomationProperties.Name="{l:Loc Acct_Currency}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Bud_Period}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding Period}" MinHeight="30" AutomationProperties.Name="{l:Loc Bud_Period}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Bud_Start}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Bud_Start}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Bud_End}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Bud_End}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:Loc Bud_DatesHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            <CheckBox Content="{l:Loc Bud_Rollover}" IsChecked="{Binding Rollover}" Margin="0,10,0,0" Foreground="{StaticResource Brush.Text.Secondary}" Visibility="{Binding IsMonthly, Converter={StaticResource FD.HasValue}}" />
            <TextBlock Text="{l:Loc Bud_RolloverHint}" Style="{StaticResource Text.Meta}" FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0" Visibility="{Binding IsMonthly, Converter={StaticResource FD.HasValue}}" />
            <TextBlock Text="{l:Loc Bud_Name}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Bud_Name}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource FD.HasValue}}" />
            <DockPanel Margin="0,18,0,0">
                <ui:ArcadiaButton DockPanel.Dock="Left" Icon="Trash" IconSize="12" Content="{l:Loc Confirm_Delete}" Command="{Binding DeleteCommand}" Visibility="{Binding IsNew, Converter={StaticResource FD.HasValue}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                    <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Editor_Save}" Command="{Binding ConfirmCommand}" MinWidth="110" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Bill / subscription / income ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:RecurringEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Rec_Name}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="15" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Rec_Name}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Rec_Kind}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" MinHeight="32" AutomationProperties.Name="{l:Loc Rec_Kind}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="100" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Txn_Amount}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontSize="15" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Txn_Amount}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Acct_Currency}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CurrencyOptions}" Text="{Binding Currency, UpdateSourceTrigger=LostFocus}" IsEditable="True" MinHeight="30"
                              IsEnabled="{Binding CurrencyFromAccount, Converter={StaticResource FD.Not}}" AutomationProperties.Name="{l:Loc Acct_Currency}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Txn_Account}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding Account}" MinHeight="30" AutomationProperties.Name="{l:Loc Txn_Account}" />
