                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Goal_Date}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DateInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Goal_Date}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:Loc Goal_Tracking}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
