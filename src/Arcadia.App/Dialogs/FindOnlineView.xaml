<UserControl x:Class="Arcadia.App.Dialogs.FindOnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:dialogs="clr-namespace:Arcadia.App.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dialogs:FindOnlineViewModel}">
    <UserControl.Resources>
        <!-- art thumbnail: a selectable framed slide (ThumbButton lights up via IsSelected) -->
        <DataTemplate x:Key="ArtThumb" DataType="{x:Type dialogs:ArtItem}">
            <StackPanel Margin="0,0,10,10">
                <Button Style="{StaticResource ThumbButton}" Width="{Binding Tag.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Height="{Binding Tag.Height, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Command="{Binding DataContext.SelectArtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Caption}" ToolTip="{Binding Caption}">
                    <Grid Background="#0A0E15">
                        <ui:ArtworkPresenter ImagePath="{Binding Thumb}" ShowScene="False" Stretch="Uniform" Vignette="0" CornerRadius="2" />
                    </Grid>
                </Button>
                <TextBlock Margin="2,3,0,0" Text="{Binding Caption}" Style="{StaticResource Text.Meta}" FontSize="10.5"
                           MaxWidth="{Binding Tag.Width, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="540" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="32">
                <TextBox Padding="28,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="13" AutomationProperties.Name="{l:Loc Meta_Search}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <ui:ArcadiaIcon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Icon.Dim}" />
            </Grid>
            <ui:ArcadiaButton Grid.Column="1" Margin="8,0,0,0" Variant="Primary" Content="{l:Loc Meta_Search}" Command="{Binding SearchCommand}" MinHeight="32" />
            <TextBlock Grid.Column="2" Margin="16,0,0,0" Text="{Binding Message}" Style="{StaticResource FieldError}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- results -->
            <Border Background="#0A0E15" BorderBrush="#1C2738" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type dialogs:MatchItem}">
                                    <Border x:Name="row" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent" Margin="0,0,0,2">
                                        <Button Style="{StaticResource ListRowButton}" Padding="6,5"
                                                Command="{Binding DataContext.SelectMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="59" Style="{StaticResource ArtworkWell}" CornerRadius="2">
                                                    <ui:ArtworkPresenter ImagePath="{Binding CoverUrl}" Theme="mountains-dusk" Seed="3" Vignette="0.2" CornerRadius="2" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.Item}" FontSize="13" TextWrapping="Wrap" MaxHeight="36" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Meta}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource Brush.Nav.Selected}" />
                                            <Setter TargetName="row" Property="BorderBrush" Value="#5C9CFF" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{l:Loc Meta_Loading}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- details + art -->
            <Grid Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{l:Loc Meta_Details}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{l:Loc Meta_Loading}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right"
                                   Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock ui:Bidi.Text="{Binding SelectedMatch.Name}" Style="{StaticResource Text.Title}" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Facts}" Style="{StaticResource Text.Meta}" FontSize="12" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding Genres}" Style="{StaticResource Text.Meta}" Foreground="#8FD8FF" />
                    <TextBlock Margin="0,8,0,0" ui:Bidi.Text="{Binding Summary}" Style="{StaticResource Text.Body}" MaxHeight="72" TextTrimming="WordEllipsis" ToolTip="{Binding Summary}" />
                    <CheckBox Margin="0,10,0,0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ApplyDetails}" AutomationProperties.Name="{l:Loc Meta_ApplyDetails}">
                        <TextBlock Text="{l:Loc Meta_ApplyDetails}" Style="{StaticResource Text.Item}" FontSize="12.5" />
                    </CheckBox>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource TabButton}" Height="34" GroupName="ArtTabs" IsChecked="{Binding IsBoxArtTab}" Content="{l:Loc Meta_TabBoxArt}" />
                            <RadioButton Style="{StaticResource TabButton}" Height="34" GroupName="ArtTabs" IsChecked="{Binding IsCapsuleTab}" Content="{l:Loc Meta_TabCapsule}" />
                            <RadioButton Style="{StaticResource TabButton}" Height="34" GroupName="ArtTabs" IsChecked="{Binding IsHeroTab}" Content="{l:Loc Meta_TabHero}" />
                            <RadioButton Style="{StaticResource TabButton}" Height="34" GroupName="ArtTabs" IsChecked="{Binding IsLogoTab}" Content="{l:Loc Meta_TabLogo}" />
                        </StackPanel>
                        <TextBlock Text="{l:Loc Meta_Loading}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoadingArt, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,6,0,8">
                        <TextBlock Text="{l:Loc Meta_ArtHint}" Style="{StaticResource Text.Meta}" />
                        <TextBlock Text="{l:Loc Meta_ArtUnavailable}" Style="{StaticResource FieldError}" Visibility="{Binding ArtUnavailable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding BoxArt}" ItemTemplate="{StaticResource ArtThumb}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                                          Tag="{x:Static dialogs:ArtSizes.BoxArt}" Visibility="{Binding IsBoxArtTab, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Capsules}" ItemTemplate="{StaticResource ArtThumb}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                                          Tag="{x:Static dialogs:ArtSizes.Capsule}" Visibility="{Binding IsCapsuleTab, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource ArtThumb}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                                          Tag="{x:Static dialogs:ArtSizes.Hero}" Visibility="{Binding IsHeroTab, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Logos}" ItemTemplate="{StaticResource ArtThumb}" ItemsPanel="{StaticResource Wrap}" Focusable="False"
                                          Tag="{x:Static dialogs:ArtSizes.Logo}" Visibility="{Binding IsLogoTab, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{l:Loc Meta_NoArt}" Style="{StaticResource Text.Meta}" Margin="2,8"
                                       Visibility="{Binding CurrentArt.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" />
            <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="14" Content="{l:Loc Meta_Apply}" Command="{Binding ApplyCommand}" MinWidth="110"
                              IsEnabled="{Binding HasSelection}" />
        </StackPanel>
    </Grid>
</UserControl>
