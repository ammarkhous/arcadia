<UserControl x:Class="Arcadia.App.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="urn:arcadia-ui">
    <StackPanel Margin="22,20,22,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Top">
                <Ellipse>
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Offset="0" Color="#FF7A6A" />
                            <GradientStop Offset="1" Color="#9E2228" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <ui:ArcadiaIcon Kind="Warning" Width="20" Height="20" Foreground="White" />
            </Grid>
            <TextBlock Grid.Column="1" Margin="16,2,0,0" Text="{Binding Message}" Style="{StaticResource Text.Body}" FontSize="13.5" LineHeight="20" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <ui:ArcadiaButton Content="{Binding CancelText}" Command="{Binding CancelCommand}" MinWidth="96" IsCancel="True" Margin="0,0,10,0" />
            <ui:ArcadiaButton Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="96" Icon="Trash" IconSize="14" Foreground="White">
                <ui:ArcadiaButton.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#E0484E" />
                        <GradientStop Offset="1" Color="#9E2228" />
                    </LinearGradientBrush>
                </ui:ArcadiaButton.Background>
            </ui:ArcadiaButton>
        </StackPanel>
    </StackPanel>
</UserControl>
