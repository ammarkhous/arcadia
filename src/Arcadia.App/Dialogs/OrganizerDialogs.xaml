<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:arcadia-ui"
                    xmlns:l="clr-namespace:Arcadia.App.Localization"
                    xmlns:conv="clr-namespace:Arcadia.App.Converters"
                    xmlns:dialogs="clr-namespace:Arcadia.App.Dialogs"
                    xmlns:core="clr-namespace:Arcadia.Core.Organizer;assembly=Arcadia.Core">

    <conv:HasValueToVisibilityConverter x:Key="OD.HasValue" />
    <conv:ToneToColorConverter x:Key="OD.Tone" />

    <!-- ═══════════ Link to something in Arcadia ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:EntityPickerViewModel}">
        <StackPanel Margin="22,16,22,18">
            <ItemsControl ItemsSource="{Binding Kinds}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:KindChoice}">
                        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="PickKind" Margin="0,0,5,5" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Command="{Binding DataContext.ChooseKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                     AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                                <ui:ArcadiaIcon Kind="{Binding Icon}" Width="12" Height="12" />
                                <TextBlock Text="{Binding Label}" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Margin="0,6,0,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Tr_Filter}" />
            <Border Margin="0,10,0,0" Style="{StaticResource Tool.TableFrame}">
                <Border Style="{StaticResource Tool.TableInner}">
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Height="280" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Title}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:EntityInfo}">
                                    <StackPanel Orientation="Horizontal" Margin="4,4">
                                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{Binding Accent, Converter={StaticResource OD.Tone}}" />
                                        <TextBlock ui:Bidi.Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Brush.Text.Primary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{l:Loc Org_PickEmpty}" Style="{StaticResource Text.Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource OD.HasValue}}" />
                    </Grid>
                </Border>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <ui:ArcadiaButton Variant="Primary" Icon="Link" IconSize="13" Content="{l:Loc Org_Link}" Command="{Binding ConfirmCommand}" MinWidth="120" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Which occurrences? ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:RecurrenceScopeViewModel}">
        <StackPanel Margin="22,16,22,18">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
            <StackPanel Margin="0,16,0,0">
                <ui:ArcadiaButton Variant="Primary" Content="{l:Loc Evt_ScopeThis}" Command="{Binding ThisCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" IsDefault="True" />
                <ui:ArcadiaButton Content="{l:Loc Evt_ScopeFuture}" Command="{Binding FutureCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  Visibility="{Binding ShowFuture, Converter={StaticResource OD.HasValue}}" />
                <ui:ArcadiaButton Content="{l:Loc Evt_ScopeAll}" Command="{Binding AllCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                <ui:ArcadiaButton Variant="Link" Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Center" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Event ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:EventEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <TextBlock Text="{l:Loc Evt_What}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TitleBox" Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="15" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Evt_What}" />

            <!-- when -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Evt_StartDate}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_StartDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding IsAllDay, Converter={StaticResource OD.HasValue}, ConverterParameter=invert}">
                    <TextBlock Text="{l:Loc Evt_StartTime}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_StartTime}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="–" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" Foreground="{StaticResource Brush.Text.Secondary}" />
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Evt_EndDate}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_EndDate}" />
                </StackPanel>
                <StackPanel Grid.Column="6" Visibility="{Binding IsAllDay, Converter={StaticResource OD.HasValue}, ConverterParameter=invert}">
                    <TextBlock Text="{l:Loc Evt_EndTime}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_EndTime}" />
                </StackPanel>
            </Grid>
            <CheckBox Content="{l:Loc Evt_AllDay}" IsChecked="{Binding IsAllDay}" Margin="0,8,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />

            <!-- repeat + reminder + category -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Evt_Repeat}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding Repeat}" MinHeight="30" AutomationProperties.Name="{l:Loc Evt_Repeat}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Evt_Reminder}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding Reminder}" MinHeight="30" AutomationProperties.Name="{l:Loc Evt_Reminder}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Evt_Category}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" MinHeight="30" AutomationProperties.Name="{l:Loc Evt_Category}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{l:Loc Evt_RepeatSeriesHint}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsOccurrence, Converter={StaticResource OD.HasValue}}" />

            <!-- repetition details -->
            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="3" BorderThickness="1" BorderBrush="#1E2E44" Background="#0A111B" Visibility="{Binding Repeats, Converter={StaticResource OD.HasValue}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCustom, Converter={StaticResource OD.HasValue}}" Margin="0,0,0,8">
                        <TextBlock Text="{l:Loc Evt_Every}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="48" MinHeight="28" Margin="8,0" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_Every}" />
                        <ComboBox ItemsSource="{Binding CustomUnits}" SelectedItem="{Binding CustomUnit}" MinWidth="110" MinHeight="28" AutomationProperties.Name="{l:Loc Evt_RepeatUnit}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Weekdays}" Focusable="False" Visibility="{Binding ShowWeekdays, Converter={StaticResource OD.HasValue}}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dialogs:WeekdayToggle}">
                                <ToggleButton Style="{StaticResource Tr.Legend}" IsChecked="{Binding IsOn}" Content="{Binding Label}" Margin="0,0,4,0" MinWidth="38" AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc Evt_Until}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Until, UpdateSourceTrigger=PropertyChanged}" Width="130" MinHeight="28" Margin="8,0,0,0" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_Until}" />
                        <TextBlock Text="{l:Loc Evt_UntilHint}" Style="{StaticResource Text.Meta}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- where -->
            <TextBlock Text="{l:Loc Evt_Location}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
            <DockPanel>
                <ui:ArcadiaButton DockPanel.Dock="Right" Icon="MapPin" IconSize="12" Content="{l:Loc Evt_SavedPlace}" Command="{Binding PickPlaceCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Evt_Location}" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding PlaceName, Converter={StaticResource OD.HasValue}}">
                <ui:ArcadiaIcon Kind="MapPin" Width="12" Height="12" />
                <TextBlock Text="{Binding PlaceName}" Style="{StaticResource Text.Meta}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <ui:ArcadiaButton Variant="Tool" Icon="Close" IconSize="8" Width="18" Height="18" Margin="6,0,0,0" Command="{Binding ClearPlaceCommand}" AutomationProperties.Name="{l:Loc Org_Unlink}" />
            </StackPanel>

            <!-- about -->
            <DockPanel Margin="0,10,0,0">
                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Link" Content="{l:Loc Org_LinkTo}" Command="{Binding PickContextCommand}" />
                <ui:ArcadiaButton DockPanel.Dock="Right" Variant="Tool" Icon="Close" IconSize="8" Width="18" Height="18" Margin="0,0,6,0" Command="{Binding ClearContextCommand}"
                                  AutomationProperties.Name="{l:Loc Org_Unlink}" Visibility="{Binding Context, Converter={StaticResource OD.HasValue}}" />
                <ContentControl Content="{Binding Context}" Focusable="False" HorizontalAlignment="Left" Visibility="{Binding Context, Converter={StaticResource OD.HasValue}}" />
                <TextBlock Text="{l:Loc Org_NoContext}" Style="{StaticResource Text.Meta}" VerticalAlignment="Center" Visibility="{Binding Context, Converter={StaticResource OD.HasValue}, ConverterParameter=invert}" />
            </DockPanel>

            <!-- more -->
            <ToggleButton Margin="0,12,0,0" HorizontalAlignment="Left" IsChecked="{Binding ShowMore}" Cursor="Hand" AutomationProperties.Name="{l:Loc Evt_More}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ui:ArcadiaIcon x:Name="Chevron" Kind="ChevronRight" Width="10" Height="10" RenderTransformOrigin="0.5,0.5"><ui:ArcadiaIcon.RenderTransform><RotateTransform /></ui:ArcadiaIcon.RenderTransform></ui:ArcadiaIcon>
                            <TextBlock Text="{l:Loc Evt_More}" Margin="7,0,0,0" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <StackPanel Visibility="{Binding ShowMore, Converter={StaticResource OD.HasValue}}" Margin="17,6,0,0">
                <TextBlock Text="{l:Loc Evt_Description}" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource TextArea}" Height="54" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Evt_Description}" />
                <TextBlock Text="{l:Loc Task_Notes}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                <TextBox Style="{StaticResource TextArea}" Height="54" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Task_Notes}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Tags}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:Loc Evt_CustomReminder}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CustomReminder, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Evt_CustomReminder}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,10,0,0" Visibility="{Binding Error, Converter={StaticResource OD.HasValue}}" />
            <DockPanel Margin="0,18,0,0">
                <ui:ArcadiaButton DockPanel.Dock="Left" Icon="Trash" IconSize="12" Content="{l:Loc Confirm_Delete}" Command="{Binding DeleteCommand}"
                                  Visibility="{Binding IsNew, Converter={StaticResource OD.HasValue}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                    <ui:ArcadiaButton Variant="Primary" Icon="Calendar" IconSize="14" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="120" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Category ═══════════ -->
    <DataTemplate DataType="{x:Type dialogs:CategoryEditorViewModel}">
        <StackPanel Margin="22,16,22,18">
            <TextBlock Text="{l:Loc Cat_Name}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Cat_Name}" />
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Visibility="{Binding Error, Converter={StaticResource OD.HasValue}}" />
            <TextBlock Text="{l:Loc Cat_Icon}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding IconChoices}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CatIcon" Margin="0,0,4,4" Width="36" Height="30" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                     Command="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.Glyph" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                            <ui:ArcadiaIcon Kind="{Binding}" Width="15" Height="15" />
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:Loc Cat_Accent}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <ItemsControl ItemsSource="{Binding AccentChoices}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Tool.RadioChip}" GroupName="CatAccent" Margin="0,0,4,4" Height="28" Padding="8,0" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                     Command="{Binding DataContext.ChooseAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="DataContext.Accent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                            <Border Width="18" Height="10" CornerRadius="2" Background="{Binding Converter={StaticResource OD.Tone}}" />
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
                <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="13" Content="{l:Loc Editor_Save}" Command="{Binding ConfirmCommand}" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
