<Window x:Class="Arcadia.App.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="urn:arcadia-ui"
        xmlns:l="clr-namespace:Arcadia.App.Localization"
        Title="{Binding Title}"
        SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Window}" Foreground="{StaticResource Brush.Text.Primary}" FontFamily="{StaticResource Font.Body}"
        FlowDirection="{Binding FlowDirection, Source={x:Static l:LocalizationManager.Instance}}"
        Language="{Binding XmlLanguage, Source={x:Static l:LocalizationManager.Instance}}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Border BorderBrush="#2E4262" BorderThickness="1" Background="{StaticResource Brush.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- caption plate -->
            <Border Background="{StaticResource Brush.Caption}" BorderBrush="#05070A" BorderThickness="0,0,0,1">
                <Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Margin="12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#553F8CFF" />
                                <GradientStop Offset="1" Color="#00233044" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="18" Height="18" />
                        <TextBlock Margin="10,0,0,0" Text="{Binding Title}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton.Close}" Height="43" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCancel" AutomationProperties.Name="{l:Loc Window_Close}">
                        <ui:ArcadiaIcon Kind="WindowClose" Width="16" Height="16" Foreground="#D8E0EC" />
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding}" Focusable="False" />
        </Grid>
    </Border>
</Window>
