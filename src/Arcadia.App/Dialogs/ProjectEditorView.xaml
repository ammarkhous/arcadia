<UserControl x:Class="Arcadia.App.Dialogs.ProjectEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:arcadia-ui"
             xmlns:l="clr-namespace:Arcadia.App.Localization"
             xmlns:dialogs="clr-namespace:Arcadia.App.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dialogs:ProjectEditorViewModel}">
    <StackPanel Margin="22,16,22,18">
        <!-- live preview of the project's "world" -->
        <Grid Height="96" Margin="0,0,0,14">
            <Border Style="{StaticResource ArtworkWell}">
                <ui:ArtworkPresenter Theme="{Binding World}" Seed="{Binding Seed}" Vignette="0.4" BottomShade="0.9" />
            </Border>
            <Border Height="3" VerticalAlignment="Top" Margin="1,1,1,0" Background="{Binding Accent, Converter={StaticResource It.Tone}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,12">
                <Border Width="40" Height="40" CornerRadius="5" Background="#B0060A10" BorderBrush="{Binding Accent, Converter={StaticResource It.Tone}}" BorderThickness="1.5">
                    <ui:ArcadiaIcon Kind="{Binding ProjectIcon}" Width="24" Height="24" />
                </Border>
                <TextBlock ui:Bidi.Text="{Binding Name}" Style="{StaticResource Text.OnArt}" FontFamily="{StaticResource Font.Display}" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="480" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{l:Loc Proj_Name}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" MaxLength="200" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Name}" />
        <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}" Visibility="{Binding NameError, Converter={StaticResource HasValue}}" />

        <TextBlock Margin="0,12,0,0" Text="{l:Loc Proj_Description}" Style="{StaticResource FieldLabel}" />
        <TextBox Style="{StaticResource TextArea}" Height="64" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Description}" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Loc Proj_Status}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" MinHeight="30" AutomationProperties.Name="{l:Loc Proj_Status}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:Loc Proj_Priority}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}" MinHeight="30" AutomationProperties.Name="{l:Loc Proj_Priority}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="{l:Loc Proj_Start}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" AutomationProperties.Name="{l:Loc Proj_Start}" ToolTip="{Binding DateHint}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="{l:Loc Proj_Target}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" AutomationProperties.Name="{l:Loc Proj_Target}" ToolTip="{Binding DateHint}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding DateHint}" Style="{StaticResource Text.Meta}" Margin="0,4,0,0" FontSize="11" />
        <TextBlock Text="{Binding DateError}" Style="{StaticResource FieldError}" Visibility="{Binding DateError, Converter={StaticResource HasValue}}" />

        <!-- identity -->
        <TextBlock Margin="0,12,0,0" Text="{l:Loc Proj_Accent}" Style="{StaticResource FieldLabel}" />
        <ItemsControl ItemsSource="{Binding AccentOptions}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs:ChoiceItem}">
                    <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="Accent" Height="28" Padding="8,0" Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                      AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                        <ui:ArcadiaChoice.IsChecked>
                            <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay"><Binding Path="Key" /><Binding Path="DataContext.Accent" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding>
                        </ui:ArcadiaChoice.IsChecked>
                        <StackPanel Orientation="Horizontal">
                            <ui:ArcadiaLed Width="11" Height="11" Tone="{Binding Tone, Converter={StaticResource It.Tone}}" />
                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:ArcadiaChoice>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,10,0,0" Text="{l:Loc Proj_Icon}" Style="{StaticResource FieldLabel}" />
        <ItemsControl ItemsSource="{Binding IconOptions}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs:ChoiceItem}">
                    <ui:ArcadiaChoice Style="{StaticResource Tool.RadioChip}" GroupName="Icon" Width="34" Height="30" Padding="0" Margin="0,0,4,4"
                                      Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Key}">
                        <ui:ArcadiaChoice.IsChecked>
                            <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay"><Binding Path="Key" /><Binding Path="DataContext.ProjectIcon" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding>
                        </ui:ArcadiaChoice.IsChecked>
                        <ui:ArcadiaIcon Kind="{Binding Icon}" Width="17" Height="17" />
                    </ui:ArcadiaChoice>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,10,0,0" Text="{l:Loc Proj_World}" Style="{StaticResource FieldLabel}" />
        <ItemsControl ItemsSource="{Binding WorldOptions}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs:ChoiceItem}">
                    <ui:ArcadiaChoice GroupName="World" Width="92" Height="40" Margin="0,0,6,6" Cursor="Hand"
                                      Command="{Binding DataContext.SetWorldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Key}">
                        <ui:ArcadiaChoice.IsChecked>
                            <MultiBinding Converter="{StaticResource It.Same}" Mode="OneWay"><Binding Path="Key" /><Binding Path="DataContext.World" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding>
                        </ui:ArcadiaChoice.IsChecked>
                        <ui:ArcadiaChoice.Template>
                            <ControlTemplate TargetType="ui:ArcadiaChoice">
                                <Border x:Name="frame" CornerRadius="3" BorderThickness="1.5" BorderBrush="#26344A" Padding="1">
                                    <ui:ArtworkPresenter Theme="{Binding Key}" Seed="7" Vignette="0.3" CornerRadius="2" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#5C9CFF" /></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#7CE0FF" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ui:ArcadiaChoice.Template>
                    </ui:ArcadiaChoice>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Loc Proj_Tags}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" ui:Bidi.AutoDirection="True" AutomationProperties.Name="{l:Loc Proj_Tags}" ToolTip="{l:Loc Proj_TagsHint}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:Loc Proj_FolderOptional}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" FontFamily="{StaticResource Font.Mono}" FontSize="12" FlowDirection="LeftToRight" AutomationProperties.Name="{l:Loc Proj_Folder}" />
                    <ui:ArcadiaButton Grid.Column="1" Margin="6,0,0,0" Icon="Documents" IconSize="13" Content="{l:Loc Proj_Browse}" Command="{Binding BrowseFolderCommand}" MinHeight="30" />
                </Grid>
                <TextBlock Text="{Binding FolderError}" Style="{StaticResource FieldError}" Visibility="{Binding FolderError, Converter={StaticResource HasValue}}" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:ArcadiaButton Content="{l:Loc Editor_Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
            <ui:ArcadiaButton Variant="Primary" Icon="Check" IconSize="14" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="120" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
