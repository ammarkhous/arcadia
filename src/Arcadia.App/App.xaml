<Application xmlns:shared="clr-namespace:Arcadia.UI;assembly=Arcadia.UI" x:Class="Arcadia.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arcadia.App.ViewModels"
             xmlns:home="clr-namespace:Arcadia.App.ViewModels.Home"
             xmlns:views="clr-namespace:Arcadia.App.Views"
             xmlns:games="clr-namespace:Arcadia.App.ViewModels.Games"
             xmlns:gameviews="clr-namespace:Arcadia.App.Views.Games"
             xmlns:dialogs="clr-namespace:Arcadia.App.Dialogs"
             xmlns:itvm="clr-namespace:Arcadia.App.ViewModels.ItTools"
             xmlns:itviews="clr-namespace:Arcadia.App.Views.ItTools"
             xmlns:pvm="clr-namespace:Arcadia.App.ViewModels.Projects"
             xmlns:pviews="clr-namespace:Arcadia.App.Views.Projects"
             xmlns:dvm="clr-namespace:Arcadia.App.ViewModels.Documents"
             xmlns:dviews="clr-namespace:Arcadia.App.Views.Documents"
             xmlns:conv="clr-namespace:Arcadia.App.Converters"
             xmlns:tvm="clr-namespace:Arcadia.App.ViewModels.Travel"
             xmlns:tviews="clr-namespace:Arcadia.App.Views.Travel"
             xmlns:ovm="clr-namespace:Arcadia.App.ViewModels.Organizer"
             xmlns:oviews="clr-namespace:Arcadia.App.Views.Organizer"
             xmlns:fvm="clr-namespace:Arcadia.App.ViewModels.Finance"
             xmlns:fviews="clr-namespace:Arcadia.App.Views.Finance"
             xmlns:orvm="clr-namespace:Arcadia.App.ViewModels.Oracle"
             xmlns:orviews="clr-namespace:Arcadia.App.Views.Oracle"
             xmlns:auvm="clr-namespace:Arcadia.App.ViewModels.Automation"
             xmlns:auviews="clr-namespace:Arcadia.App.Views.Automation"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <shared:SharedResourceDictionary Source="/Arcadia.UI;component/Themes/ArcadiaTheme.xaml" />
                <ResourceDictionary xmlns:shared="clr-namespace:Arcadia.UI;assembly=Arcadia.UI" Source="Views/AppStyles.xaml" />
                <ResourceDictionary Source="Views/ItTools/ItToolsStyles.xaml" />
                <ResourceDictionary Source="Dialogs/SmallProjectDialogs.xaml" />
                <ResourceDictionary Source="Views/Travel/TravelStyles.xaml" />
                <ResourceDictionary Source="Dialogs/TravelDialogs.xaml" />
                <ResourceDictionary Source="Views/Organizer/OrganizerStyles.xaml" />
                <ResourceDictionary Source="Dialogs/OrganizerDialogs.xaml" />
                <ResourceDictionary Source="Views/Finance/FinanceStyles.xaml" />
                <ResourceDictionary Source="Dialogs/FinanceDialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ToneToColorConverter x:Key="ToneToColor" />
            <conv:HasValueToVisibilityConverter x:Key="HasValue" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <!-- View-model first navigation: each page view model finds its view here -->
            <DataTemplate DataType="{x:Type home:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModulePlaceholderViewModel}">
                <views:ModulePlaceholderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type games:GamesViewModel}">
                <gameviews:GamesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type games:GameDetailViewModel}">
                <gameviews:GameDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type itvm:ItToolsViewModel}">
                <itviews:ItToolsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type pvm:ProjectsViewModel}">
                <pviews:ProjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProjectWorkspaceViewModel}">
                <pviews:ProjectWorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dvm:DocumentsViewModel}">
                <dviews:DocumentsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type tvm:TravelViewModel}">
                <tviews:TravelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type tvm:TripWorkspaceViewModel}">
                <tviews:TripWorkspaceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type tvm:PhotoViewerViewModel}">
                <tviews:PhotoViewerView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type ovm:CalendarViewModel}">
                <oviews:CalendarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ovm:TasksViewModel}">
                <oviews:TasksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ovm:TaskDetailsViewModel}">
                <oviews:TaskDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ovm:NotesViewModel}">
                <oviews:NotesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type fvm:FinanceViewModel}">
                <fviews:FinanceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type orvm:OracleConsoleViewModel}">
                <orviews:OracleView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type auvm:AutomationViewModel}">
                <auviews:AutomationView />
            </DataTemplate>

            <!-- Dialog bodies -->
            <DataTemplate DataType="{x:Type dialogs:TripEditorViewModel}">
                <dialogs:TripEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ProjectEditorViewModel}">
                <dialogs:ProjectEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ConfirmDialogViewModel}">
                <dialogs:ConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:GameEditorViewModel}">
                <dialogs:GameEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:LogSessionViewModel}">
                <dialogs:LogSessionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ScreenshotEditorViewModel}">
                <dialogs:ScreenshotEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:DiagnosticSessionEditorViewModel}">
                <dialogs:DiagnosticSessionEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:FindOnlineViewModel}">
                <dialogs:FindOnlineView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
