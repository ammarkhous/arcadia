<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Arcadia.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arcadia.Core\Arcadia.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled geographic data generated by tools/Arcadia.GeoForge (Natural Earth, GeoNames, public-domain flags). -->
    <EmbeddedResource Include="Geo\Data\countries.dat.gz" LogicalName="Arcadia.Geo.countries.dat.gz" />
    <EmbeddedResource Include="Geo\Data\cities.tsv.gz" LogicalName="Arcadia.Geo.cities.tsv.gz" />
    <EmbeddedResource Include="Geo\Data\flags.zip" LogicalName="Arcadia.Geo.flags.zip" />
  </ItemGroup>
</Project>
